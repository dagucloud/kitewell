---
import Site from "../layouts/Site.astro";
import DownloadButton from "../components/DownloadButton.astro";
import { readReleases } from "../lib/releases.mjs";
import { pickDownload } from "../lib/platform.mjs";
import { localize, type Locale } from "../lib/i18n.mjs";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// Each system is published from its own feed; a platform offers downloads
// only when its manifest exists.
const releases = await readReleases();
const { macos, windows } = releases;
const release = macos ?? windows;
const text = {
  en: {
    title: release ? "Download Kitewell" : "Release availability",
    description:
      "Download Kitewell for Mac or Windows, free for up to 10 workflows, and go from the installer to your first chore in three steps.",
    eyebrow: "Download",
    heading: release ? "Download Kitewell" : "Coming soon",
    lead: release
      ? "Free for up to 10 workflows on Mac and Windows. Kitewell is in public beta, so features and screens may still change."
      : "There are no public installers yet. Kitewell runs on macOS and Windows; Linux support is planned.",
    version: (version: string) => `Version ${version}`,
    picks: {
      "mac-arm64": ["Kitewell for Mac", "For Macs with Apple silicon (M-series chips) · macOS 13 or later", "Download for Mac"],
      "mac-amd64": ["Kitewell for Mac", "For Macs with Intel processors · macOS 13 or later", "Download for Mac"],
      "windows-amd64": ["Kitewell for Windows", "For 64-bit PCs (x64) · Windows 10 version 1809 or later, or Windows 11", "Download for Windows"],
    },
    otherChip: {
      "mac-arm64": "Intel Mac? Download the Intel version",
      "mac-amd64": "Apple silicon Mac? Download that version",
    },
    starting: "Your download is starting.",
    again: "Didn't start? Download again",
    notes: {
      "windows-arm64": "Kitewell's Windows installer is built for x64 PCs. PCs with Arm processors aren't supported yet.",
      mobile: "Kitewell runs on Mac and Windows computers. Send yourself the link and download it there.",
      "desktop-other": "Kitewell runs on Mac and Windows. Linux support is planned.",
    },
    next: "Next steps",
    steps: [
      {
        title: "Open the installer",
        lines: [
          ["mac", "On a Mac, open the .pkg you downloaded and follow it. It asks for an administrator password."],
          ["windows", "On Windows, run the Setup file. If your browser says it isn't commonly downloaded, choose Keep. If Windows SmartScreen appears, choose More info, then Run anyway. To check the file first, compare its SHA256 with the one under All downloads."],
        ],
      },
      {
        title: "Open Kitewell and sign in for its AI",
        lines: [
          ["", "Choose <strong>Sign in to use Kitewell's AI</strong>. Your browser opens Dagu Cloud with a code to match. There's no API key to find, and 100 free credits to start. To use your own AI key instead, choose <strong>Start on this device</strong>."],
        ],
      },
      {
        title: "Tell it a chore",
        lines: [
          ["", "In the chat, under <strong>What do you keep doing by hand?</strong>, describe a chore in your own words, or copy one of these and finish it:"],
        ],
      },
    ],
    samples: [
      ["web-page-summary", "A web page each morning, no sign-in", "Make a workflow that opens a web page every weekday morning and writes me a short summary of what is new on it. The page is [the page's address]"],
      ["supplier-invoices", "Invoices from a supplier's website", "Make a workflow that signs in to my supplier's website, downloads the new invoices, and adds each one to an Excel file. The website is [the website's address]"],
    ],
    copy: "Copy",
    copied: "Copied",
    after: "The AI works it out in a browser you can watch, then shows you the workflow. Nothing is saved until you apply it.",
    guide: "Read the first-workflow guide →",
    all: "All downloads",
    linux: "Linux support is planned.",
    macos: {
      name: "macOS",
      soon: "The macOS installer is coming soon.",
      button: "Download .pkg",
      architectures: [
        ["darwin-arm64", "Apple silicon", "For Macs with Apple M-series chips."],
        ["darwin-amd64", "Intel", "For Macs with Intel processors."],
      ],
    },
    windows: {
      name: "Windows",
      soon: "The Windows installer is coming soon.",
      button: "Download installer (.exe)",
      architectures: [
        ["windows-amd64", "x64", "For 64-bit PCs with Intel or AMD processors."],
      ],
    },
    preview: "See how Kitewell works",
    previewText: ["Read the ", "getting started guide", " or explore the ", "workflow editor", ". Installers will appear here and on ", " when the first release is published."],
    before: "Before you start",
    beforeItems: [
      "Website steps drive Google Chrome, or Microsoft Edge on Windows. Install one first.",
      "Desktop-app steps need permission to record the screen and control the computer; Kitewell asks for it under Device settings → Desktop automation.",
      "AI steps use Kitewell's included model on a computer signed in to Dagu Cloud, an API key from a provider such as Anthropic, OpenAI, or Google, or a local server such as Ollama. Keys are stored as project secrets.",
      "Docker steps use Docker Desktop, which Kitewell does not install.",
    ],
    installingMac: "Installing on macOS",
    requirementsMac: [
      "macOS 13 or later. To check your chip, open Apple menu → About This Mac.",
      "The package installs into Applications and requires an administrator password.",
      "Python, Docker, AI command-line agents, and other tools are needed only for workflows that use them.",
      "When updating, save edits and let running workflows finish. Installation restarts Kitewell.",
    ],
    installingWindows: "Installing on Windows",
    requirementsWindows: [
      "Windows 10 version 1809 or later, or Windows 11, 64-bit (x64).",
      "The installer sets Kitewell up for your user account. No administrator password is needed.",
      "Microsoft Edge WebView2 is required. Kitewell offers to install it when it opens without it.",
      "Python, Docker, AI command-line agents, and other tools are needed only for workflows that use them.",
      "When updating, save edits and let running workflows finish. Installation restarts Kitewell; runs in progress keep going.",
    ],
    install: "Read installation instructions →",
  },
  ja: {
    title: release ? "Kitewell をダウンロード" : "リリースの提供状況",
    description:
      "Mac と Windows 向けの Kitewell をダウンロード。10 ワークフローまで無料で、インストールから最初の作業まで 3 つの手順です。",
    eyebrow: "ダウンロード",
    heading: release ? "Kitewell をダウンロード" : "近日公開",
    lead: release
      ? "Mac と Windows で、10 ワークフローまで無料。Kitewell はパブリックベータのため、機能や画面は変わることがあります。"
      : "公開中のインストーラーはまだありません。Kitewell は macOS と Windows で動作し、Linux にも対応予定です。",
    version: (version: string) => `バージョン ${version}`,
    picks: {
      "mac-arm64": ["Mac 版 Kitewell", "Apple シリコン（M シリーズチップ）搭載の Mac 向け · macOS 13 以降", "Mac 版をダウンロード"],
      "mac-amd64": ["Mac 版 Kitewell", "Intel プロセッサー搭載の Mac 向け · macOS 13 以降", "Mac 版をダウンロード"],
      "windows-amd64": ["Windows 版 Kitewell", "64 ビット（x64）の PC 向け · Windows 10 バージョン 1809 以降、または Windows 11", "Windows 版をダウンロード"],
    },
