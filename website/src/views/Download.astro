      "mac-arm64": "Intel の Mac なら、Intel 版をダウンロード",
      "mac-amd64": "Apple シリコンの Mac なら、そちらの版をダウンロード",
    },
    starting: "ダウンロードを開始しています。",
    again: "始まらない場合は、もう一度ダウンロード",
    notes: {
      "windows-arm64": "Windows 版のインストーラーは x64 の PC 向けです。Arm プロセッサーの PC にはまだ対応していません。",
      mobile: "Kitewell は Mac と Windows のパソコンで動きます。リンクを自分に送って、パソコンでダウンロードしてください。",
      "desktop-other": "Kitewell は Mac と Windows で動きます。Linux には対応予定です。",
    },
    next: "このあとの手順",
    steps: [
      {
        title: "インストーラーを開く",
        lines: [
          ["mac", "Mac では、ダウンロードした .pkg を開いて案内に沿って進めます。管理者パスワードが必要です。"],
          ["windows", "Windows では、Setup ファイルを実行します。ブラウザーが「一般的にダウンロードされていません」と表示したら「保持する」を選びます。SmartScreen が表示されたら「詳細情報」→「実行」を選びます。先にファイルを確かめるなら、「すべてのダウンロード」にある SHA256 と照らし合わせてください。"],
        ],
      },
      {
        title: "Kitewell を開いて、AI のためにサインインする",
        lines: [
          ["", "<strong>サインインして Kitewell の AI を使う</strong> を選びます。ブラウザーで Dagu Cloud が開くので、表示されたコードを照合します。API キーは不要で、100 クレジットまで無料です。ご自身の AI キーを使うなら <strong>このデバイスで始める</strong> を選びます。"],
        ],
      },
      {
        title: "作業を伝える",
        lines: [
          ["", "チャットの <strong>いつも手作業でしていることは何ですか？</strong> の下で、ふだんの言葉で作業を伝えるか、次の例をコピーして続きを書きます。"],
        ],
      },
    ],
    samples: [
      ["web-page-summary", "毎朝の Web ページ（サインイン不要）", "平日の毎朝 Web ページを開いて、新しく載ったことを短く要約するワークフローを作って。ページは [ページのアドレス]"],
      ["supplier-invoices", "仕入先サイトの請求書", "仕入先のウェブサイトにサインインして新しい請求書をダウンロードし、1 件ずつ Excel ファイルに追加するワークフローを作って。ウェブサイトは [ウェブサイトのアドレス]"],
    ],
    copy: "コピー",
    copied: "コピーしました",
    after: "AI が見守れるブラウザーで試してから、ワークフローを見せます。適用するまで、何も保存されません。",
    guide: "最初のワークフローのガイドを読む →",
    all: "すべてのダウンロード",
    linux: "Linux には対応予定です。",
    macos: {
      name: "macOS",
      soon: "macOS 向けインストーラーは近日公開です。",
      button: ".pkg をダウンロード",
      architectures: [
        ["darwin-arm64", "Apple シリコン", "Apple M シリーズチップ搭載の Mac 向け。"],
        ["darwin-amd64", "Intel", "Intel プロセッサー搭載の Mac 向け。"],
      ],
    },
    windows: {
      name: "Windows",
      soon: "Windows 向けインストーラーは近日公開です。",
      button: "インストーラー（.exe）をダウンロード",
      architectures: [
        ["windows-amd64", "x64", "Intel または AMD の 64 ビットプロセッサー搭載の PC 向け。"],
      ],
    },
    preview: "Kitewell の使い方を見る",
    previewText: ["", "はじめかたガイド", "を読むか、", "ワークフローエディタ", "をご覧ください。リリースを公開すると、インストーラーがこのページと ", " に掲載されます。"],
    before: "始める前に",
    beforeItems: [
      "Web サイトのステップは Google Chrome（Windows では Microsoft Edge も可）を操作します。先にインストールしてください。",
      "デスクトップアプリのステップには、画面収録とコンピューターの制御の許可が必要です。Kitewell は デバイス設定 → デスクトップ自動操作 で許可を求めます。",
      "AI のステップには、Dagu Cloud にサインインしたコンピューターで使える Kitewell の付属モデル、Anthropic、OpenAI、Google などのプロバイダーの API キー、または Ollama のようなローカルサーバーを使います。キーはプロジェクトのシークレットとして保存されます。",
      "Docker のステップは Docker Desktop を使います。Kitewell はインストールしません。",
    ],
    installingMac: "macOS へのインストール",
    requirementsMac: [
      "macOS 13 以降。チップの種類は、アップルメニュー →「この Mac について」で確認できます。",
      "パッケージは「アプリケーション」フォルダにインストールされ、管理者パスワードが必要です。",
      "Python、Docker、AI のコマンドラインエージェントなどのツールは、それを使うワークフローでのみ必要です。",
      "アップデートの際は、編集内容を保存し、実行中のワークフローが終わるのを待ってください。インストールすると Kitewell が再起動します。",
    ],
    installingWindows: "Windows へのインストール",
    requirementsWindows: [
      "Windows 10 バージョン 1809 以降、または Windows 11（64 ビット、x64）。",
      "インストーラーは、お使いのユーザーアカウントに Kitewell をインストールします。管理者パスワードは不要です。",
      "Microsoft Edge WebView2 が必要です。未インストールの場合は、Kitewell の起動時にインストールを案内します。",
      "Python、Docker、AI のコマンドラインエージェントなどのツールは、それを使うワークフローでのみ必要です。",
      "アップデートの際は、編集内容を保存し、実行中のワークフローが終わるのを待ってください。インストールすると Kitewell が再起動します。実行中の処理はそのまま続きます。",
    ],
    install: "インストール手順を読む →",
  },
}[locale];
const platforms = [
  [text.macos, macos],
  [text.windows, windows],
] as const;
// The installer offered first, for each computer a visitor may be on. The
// page shows the one that fits; without scripts, only the full list shows.
const picks = (["mac-arm64", "mac-amd64", "windows-amd64"] as const)
  .map((name) => {
    const [os, arch] = name.split("-");
    return { name, download: pickDownload(releases, { os, arch }) };
  })
  .filter(({ download }) => download);
const otherChip = { "mac-arm64": "mac-amd64", "mac-amd64": "mac-arm64" } as const;
const downloadOf = (name: string) => picks.find((pick) => pick.name === name)?.download;
---

<Site title={text.title} description={text.description}>
  <section class="page wrap download-page">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    {release && (
      <div class="picked">
        {picks.map(({ name, download }) => {
          const [title, detail, button] = text.picks[name];
          const other = name in otherChip ? downloadOf(otherChip[name as keyof typeof otherChip]) : undefined;
          return (
            <article class="card pick-card" data-pick={name}>
              <h2>{title}</h2>
              <p>{detail} · {text.version(download!.version)}</p>
              <a class="button" href={download!.url} data-download={download!.key}>
                {button}
              </a>
              <p class="pick-started" role="status" data-started hidden>
                {text.starting}{" "}
                <a href={download!.url} data-download={download!.key} data-again>{text.again}</a>
              </p>
              {other && (
                <p class="pick-other">
                  <a href={other.url} data-download={other.key}>{text.otherChip[name as keyof typeof otherChip]}</a>
                </p>
              )}
            </article>
          );
        })}
        {Object.entries(text.notes).map(([name, note]) => (
          <div class="notice pick-note" data-note={name}>
            <p>{note}</p>
            {name === "mobile" && <DownloadButton locale={locale} place="download" />}
          </div>
        ))}
      </div>
    )}
    {release && (
      <section class="next-steps" aria-labelledby="next-steps">
        <h2 id="next-steps">{text.next}</h2>
        <ol>
          {text.steps.map(({ title, lines }, i) => (
            <li>
              <h3>{title}</h3>
              {lines.map(([system, line]) => <p class:list={{ [`for-system-${system}`]: system }} set:html={line} />)}
              {i === text.steps.length - 1 && (
                <>
                  <ul class="samples">
                    {text.samples.map(([slug, label, request]) => (
                      <li>
                        <span class="sample-label">{label}</span>
                        <p class="sample-text">{request}</p>
                        <button type="button" class="button secondary small" data-copy={slug} data-copied={text.copied}>
                          {text.copy}
                        </button>
                      </li>
                    ))}
                  </ul>
                  <p>{text.after}</p>
                  <a class="text-link" href={localize("/docs/getting-started/", locale)}>{text.guide}</a>
                </>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}
    {release ? (
      <section class="all-downloads" aria-labelledby="all-downloads">
        <h2 id="all-downloads">{text.all}</h2>
        {platforms.map(([platform, published]) => (
          <section class="platform">
            <h3>{platform.name}{published ? ` · ${published.version}` : ""}</h3>
            {published ? (
              <ul class="installers">
                {platform.architectures.map(([arch, title, description]) => (
                  <li>
                    <div>
                      <strong>{title}</strong>
                      <span>{description}</span>
                    </div>
                    <a class="button secondary small" href={published.downloads[arch].url} data-download={arch}>
                      {platform.button}
                    </a>
                    <details class="checksum">
                      <summary>SHA256</summary>
                      <code>{published.downloads[arch].sha256}</code>
                    </details>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="soon">{platform.soon}</p>
            )}
          </section>
        ))}
        <p class="fine">{text.linux}</p>
      </section>
    ) : (
      <div class="notice">
        <h2>{text.preview}</h2>
        <p>
          {text.previewText[0]}
          <a href={localize("/docs/getting-started/", locale)}>{text.previewText[1]}</a>
          {text.previewText[2]}
          <a href={localize("/docs/workflow-builder/", locale)}>{text.previewText[3]}</a>
          {text.previewText[4]}
          <a href="https://github.com/dagucloud/kitewell/releases">GitHub Releases</a>
          {text.previewText[5]}
        </p>
      </div>
    )}
    <div class="prose">
      <h2>{text.before}</h2>
      <ul>
        {text.beforeItems.map((item) => <li>{item}</li>)}
      </ul>
      <div class="install-columns">
        <div>
          <h2>{text.installingMac}</h2>
          <ul>
            {text.requirementsMac.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h2>{text.installingWindows}</h2>
          <ul>
            {text.requirementsWindows.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <p>
        <a href={localize("/docs/install/", locale)}>{text.install}</a>
      </p>
    </div>
  </section>
</Site>

<script>
  import { track } from "../lib/analytics";
  import { detectPlatform } from "../lib/platform.mjs";

  // A download counts where it starts: the installer a person chose here,
  // and the link that brought them to this page.
  const params = new URLSearchParams(location.search);
  const from = params.get("from")?.match(/^[a-z-]{1,24}$/)?.[0] ?? "direct";
  const started = (key: string, again = false) => {
    const [system, arch] = key.split("-");
    track("download_started", { os: system === "darwin" ? "mac" : "windows", arch, from, ...(again ? { again } : {}) });
  };
  for (const button of document.querySelectorAll<HTMLAnchorElement>("[data-download]")) {
    button.addEventListener("click", () => started(button.dataset.download!, "again" in button.dataset));
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = button.textContent;
    button.addEventListener("click", async () => {
      const request = button.parentElement!.querySelector(".sample-text")!;
      try {
        // Japanese text binds some spaces as no-break ones; a chat wants plain spaces.
        await navigator.clipboard.writeText(request.textContent!.replaceAll("\u00a0", " "));
      } catch {
        // Without the clipboard, the request is selected for the person to copy.
        getSelection()?.selectAllChildren(request);
        return;
      }
      button.textContent = button.dataset.copied!;
      setTimeout(() => (button.textContent = label), 2000);
      track("request_copied", { slug: button.dataset.copy! });
    });
  }

  // The chip decides between a Mac's two installers; only Chromium browsers
  // say which it is, so any other Mac keeps the Apple silicon one, with the
  // Intel one a link away.
  type Hints = { platform?: string; getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }> };
  const hints = (navigator as Navigator & { userAgentData?: Hints }).userAgentData;
  const architecture = await hints?.getHighEntropyValues?.(["architecture"]).then((values) => values.architecture ?? "", () => "");
  const platform = detectPlatform({
    userAgent: navigator.userAgent,
    uaPlatform: hints?.platform ?? "",
    maxTouchPoints: navigator.maxTouchPoints,
    architecture: architecture ?? "",
  });
  if (platform.arch) document.documentElement.dataset.arch = platform.arch;

  // A button elsewhere on the site asks for this computer's installer with
  // ?get=; it starts at once, and a refresh does not start it again.
  const card = document.querySelector<HTMLElement>(`[data-pick="${platform.os}-${platform.arch}"]`);
  if (params.get("get") === platform.os && card) {
    const link = card.querySelector<HTMLAnchorElement>("a[data-download]")!;
    started(link.dataset.download!);
    card.querySelector<HTMLElement>("[data-started]")!.hidden = false;
    params.delete("get");
    history.replaceState(null, "", location.pathname + (params.size ? `?${params}` : "") + location.hash);
    location.assign(link.href);
  }
</script>
