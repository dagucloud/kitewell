---
import Site from "../layouts/Site.astro";
import { readReleases } from "../lib/releases.mjs";
import { localize } from "../lib/i18n.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
// Each system is published from its own feed; a platform offers downloads
// only when its manifest exists.
const { macos, windows } = await readReleases();
const release = macos ?? windows;
const text = {
  en: {
    title: release ? "Download Kitewell" : "Beta availability",
    description:
      "Check Kitewell beta availability for macOS and Windows, system requirements, and installation instructions.",
    eyebrow: "Downloads",
    heading: release ? `Download Kitewell ${release.version}` : "Public beta coming soon",
    lead: release
      ? "The public beta is ready to download. Check the supported platforms and system requirements below."
      : "There are no public installers yet. Kitewell runs on macOS and Windows; Linux support is planned.",
    platforms: [
      `macOS · ${macos ? "Public beta" : "Coming soon"}`,
      `Windows · ${windows ? "Public beta" : "Coming soon"}`,
      "Linux · Planned",
    ],
    macos: {
      name: "macOS",
      soon: "The macOS installer is coming soon.",
      button: "Download .pkg",
      architectures: [
        ["darwin-arm64", "Apple Silicon", "For Macs with Apple M-series chips."],
        ["darwin-amd64", "Intel", "For Macs with Intel processors."],
      ],
    },
    windows: {
      name: "Windows",
      soon: "The Windows installer is coming soon.",
      button: "Download installer (.exe)",
      architectures: [
        ["windows-amd64", "x64", "For 64-bit PCs with Intel or AMD processors."],
      ],
    },
    preview: "See how Kitewell works",
    installingMac: "Installing on macOS",
    requirementsMac: [
      "macOS 13 or later. To check your chip, open Apple menu → About This Mac.",
      "The package installs into Applications and requires an administrator password.",
      "Python, Docker, AI command-line agents, and other tools are needed only for workflows that use them.",
      "When updating, save edits and let running jobs finish. Installation restarts Kitewell.",
    ],
    installingWindows: "Installing on Windows",
    requirementsWindows: [
      "Windows 10 version 1809 or later, or Windows 11, 64-bit (x64).",
      "The installer sets Kitewell up for your user account. No administrator password is needed.",
      "Microsoft Edge WebView2 is required. The installer sets it up when it is missing, and Kitewell offers to install it when it opens without it.",
      "Windows may show a SmartScreen notice because Kitewell is a new publisher. Check that the downloaded file's SHA256 matches the one listed with the download, then choose More info → Run anyway.",
      "Python, Docker, AI command-line agents, and other tools are needed only for workflows that use them.",
      "When updating, save edits and let running jobs finish. Installation restarts Kitewell; runs in progress keep going.",
    ],
    install: "Read installation instructions →",
  },
  ja: {
    title: release ? "Kitewell をダウンロード" : "ベータの提供状況",
    description:
      "macOS と Windows 向け Kitewell ベータの提供状況、動作環境、インストール方法を確認できます。",
    eyebrow: "ダウンロード",
    heading: release ? `Kitewell ${release.version} をダウンロード` : "パブリックベータを近日公開",
    lead: release
      ? "パブリックベータをダウンロードできます。対応プラットフォームと動作環境は以下をご確認ください。"
      : "公開中のインストーラーはまだありません。Kitewell は macOS と Windows で動作し、Linux にも対応予定です。",
    platforms: [
      `macOS · ${macos ? "パブリックベータ" : "近日公開"}`,
      `Windows · ${windows ? "パブリックベータ" : "近日公開"}`,
      "Linux · 対応予定",
    ],
    macos: {
      name: "macOS",
      soon: "macOS 向けインストーラーは近日公開です。",
      button: ".pkg をダウンロード",
      architectures: [
        ["darwin-arm64", "Apple Silicon", "Apple M シリーズチップ搭載の Mac 向け。"],
        ["darwin-amd64", "Intel", "Intel プロセッサー搭載の Mac 向け。"],
      ],
    },
    windows: {
      name: "Windows",
      soon: "Windows 向けインストーラーは近日公開です。",
      button: "インストーラー（.exe）をダウンロード",
      architectures: [
        ["windows-amd64", "x64", "Intel または AMD の 64 ビットプロセッサー搭載の PC 向け。"],
      ],
    },
    preview: "Kitewell の使い方を見る",
    installingMac: "macOS へのインストール",
    requirementsMac: [
      "macOS 13 以降。チップの種類は、アップルメニュー →「この Mac について」で確認できます。",
      "パッケージは「アプリケーション」フォルダにインストールされ、管理者パスワードが必要です。",
      "Python、Docker、AI のコマンドラインエージェントなどのツールは、それを使うワークフローでのみ必要です。",
      "アップデートの際は、編集内容を保存し、実行中のジョブが終わるのを待ってください。インストールすると Kitewell が再起動します。",
    ],
    installingWindows: "Windows へのインストール",
    requirementsWindows: [
      "Windows 10 バージョン 1809 以降、または Windows 11（64 ビット、x64）。",
      "インストーラーは、お使いのユーザーアカウントに Kitewell をインストールします。管理者パスワードは不要です。",
      "Microsoft Edge WebView2 が必要です。未インストールの場合はインストーラーが導入し、Kitewell の起動時にもインストールを案内します。",
      "Kitewell は新しい発行元のため、Windows が SmartScreen の警告を表示することがあります。ダウンロードしたファイルの SHA256 がダウンロードに添えた値と一致することを確認してから、「詳細情報」→「実行」を選んでください。",
      "Python、Docker、AI のコマンドラインエージェントなどのツールは、それを使うワークフローでのみ必要です。",
      "アップデートの際は、編集内容を保存し、実行中のジョブが終わるのを待ってください。インストールすると Kitewell が再起動します。実行中の処理はそのまま続きます。",
    ],
    install: "インストール手順を読む →",
  },
}[locale];
const platforms = [
  [text.macos, macos],
  [text.windows, windows],
] as const;
---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    <div class="platforms">
      {text.platforms.map((platform) => <span>{platform}</span>)}
    </div>
    {release ? (
      platforms.map(([platform, published]) => (
        <section class="platform">
          <h2>{platform.name}{published ? ` · ${published.version}` : ""}</h2>
          {published ? (
            <div class="cards">
              {platform.architectures.map(([arch, title, description]) => (
                <article class="card">
                  <h3>{title}</h3>
                  <p>{description}</p>
                  <a class="button" href={published.downloads[arch].url}>
                    {platform.button}
                  </a>
                  <p class="checksum">
                    SHA256
                    <br />
                    <code>{published.downloads[arch].sha256}</code>
                  </p>
                </article>
              ))}
            </div>
          ) : (
            <p class="soon">{platform.soon}</p>
          )}
        </section>
      ))
    ) : (
      <div class="notice">
        <h2>{text.preview}</h2>
        {locale === "ja" ? (
          <p>
            <a href={localize("/docs/getting-started/", locale)}>はじめかたガイド</a>
            を読むか、
            <a href={localize("/docs/workflow-builder/", locale)}>ワークフローエディタ</a>
            をご覧ください。ベータを公開すると、インストーラーがこのページと{" "}
            <a href="https://github.com/dagucloud/kitewell/releases">GitHub Releases</a>{" "}
            に掲載されます。
          </p>
        ) : (
          <p>
            Read the <a href="/docs/getting-started/">getting started guide</a>
            {" "}or explore the <a href="/docs/workflow-builder/">workflow editor</a>.
            Installers will appear here and on{" "}
            <a href="https://github.com/dagucloud/kitewell/releases">
              GitHub Releases
            </a>{" "}
            when the beta is published.
          </p>
        )}
      </div>
    )}
    <div class="prose">
      <h2>{text.installingMac}</h2>
      <ul>
        {text.requirementsMac.map((item) => <li>{item}</li>)}
      </ul>
      <h2>{text.installingWindows}</h2>
      <ul>
        {text.requirementsWindows.map((item) => <li>{item}</li>)}
      </ul>
      <p>
        <a href={localize("/docs/install/", locale)}>{text.install}</a>
      </p>
    </div>
  </section>
</Site>
