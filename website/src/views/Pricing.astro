---
import Site from "../layouts/Site.astro";
import { descartyUrl } from "../lib/descarty.mjs";
import { localize } from "../lib/i18n.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
const text = {
  en: {
    title: "Pricing",
    description:
      "Planned Kitewell launch pricing: one project with up to 10 workflows free; Kitewell Personal for one person at $25 a month, with up to ten projects of 100 workflows, alerts, and webhooks; Kitewell Team for up to 10 people at $199 a month, with up to 30 projects and team sync.",
    eyebrow: "Planned launch pricing",
    heading: "One project, free.",
    lead: "A project keeps its workflows, run history, and secrets separate. Every plan includes the same workflow tools. Personal adds room for more work and alerts when it needs you; Team adds the people you share it with.",
    freeFor: "For one project on one computer.",
    free: [
      "One project with up to 10 workflows",
      "Visual workflows and YAML",
      "Schedules, run history, and event handlers",
      "Website, desktop app, and email automation",
      "AI tasks, plus MCP and API access with one API key or connected app (ChatGPT or Claude)",
      "No Kitewell account required",
      "Optionally, sync the project with a free Dagu Cloud account",
    ],
    guide: "Read the getting started guide",
    per: "/ month · USD",
    personalFor: "For one person, including paid work.",
    personal: [
      "Every feature in Free",
      "Up to ten projects, 100 workflows each",
      "Any number of API keys and connected apps",
      "Alerts by desktop notification, email, Slack, Microsoft Teams, PagerDuty, or webhook",
      "ChatGPT automations that start when a run finishes or needs you (MCP Events)",
      "Webhooks that start a workflow when GitHub, Stripe, a form, or Zapier sends a request",
      "Sync projects between up to 3 of your own devices through Dagu Cloud",
    ],
    teamFor: "For a team of up to 10 people.",
    team: [
      "Every feature in Personal",
      "Up to 10 people for one flat price, not per person",
      "Up to 30 projects, 100 workflows each",
      "Up to 20 devices in the workspace, 3 per person",
      "Projects shared through Dagu Cloud, with a role for each person on each project",
      "Secret values stay on each device",
    ],
    paidNote:
      "Personal and Team need a Dagu Cloud account. If a plan lapses, existing projects and workflows keep running; alerts, MCP Events, and webhooks stop. Purchase will be available with the public launch.",
    enterprise:
      "More than 10 people or 20 devices, invoice billing, or terms of your own? Email us and we'll set it up with you.",
    enterpriseLink: "How an enterprise PoC works",
    costs: "Costs outside Kitewell",
    costsText:
      "AI provider usage, third-party subscriptions, and infrastructure costs are separate. Kitewell does not include AI credits or a hosted computer to run your workflows.",
    ai: "Learn how AI tasks connect →",
  },
  ja: {
    title: "料金",
    description:
      "Kitewell の正式リリース時の予定価格です。1 プロジェクト・10 ワークフローまでは無料。Kitewell Personal は 1 人で月額 $25、最大 10 プロジェクト・各 100 ワークフロー、アラート、Webhook を利用できます。Kitewell Team は最大 10 人で月額 $199、最大 30 プロジェクトとチームでの同期を利用できます。",
    eyebrow: "正式リリース時の予定価格",
    heading: "1 プロジェクトなら無料。",
    lead: "プロジェクトごとに、ワークフロー、実行履歴、シークレットが分かれます。どのプランでも同じワークフロー機能を使えます。Personal では扱える量が増え、対応が必要なときに知らせるアラートが加わります。Team では、一緒に使うメンバーが加わります。",
    freeFor: "1 台のコンピューターで使うプラン。",
    free: [
      "1 プロジェクト、最大 10 ワークフロー",
      "ビジュアルエディタと YAML",
      "スケジュール、実行履歴、イベントハンドラー",
      "Web サイト、デスクトップアプリ、メールの自動化",
      "AI タスク、1 つの API キーまたは接続済みのアプリ（ChatGPT や Claude）での MCP と API アクセス",
      "Kitewell アカウントは不要",
      "無料の Dagu Cloud アカウントでプロジェクトを同期することも可能",
    ],
    guide: "はじめかたガイドを読む",
    per: "/ 月 · USD",
    personalFor: "1 人で使うプラン。仕事にも使えます。",
    personal: [
      "Free のすべての機能",
      "最大 10 プロジェクト、各 100 ワークフロー",
      "API キーと接続済みのアプリは無制限",
      "デスクトップ通知、メール、Slack、Microsoft Teams、PagerDuty、Webhook によるアラート",
      "実行の終了や、対応が必要になったときに始まる ChatGPT の自動化（MCP Events）",
      "GitHub、Stripe、フォーム、Zapier からのリクエストでワークフローを開始する Webhook",
      "自分のデバイス最大 3 台の間で、Dagu Cloud を通じてプロジェクトを同期",
    ],
    teamFor: "最大 10 人のチームで使うプラン。",
    team: [
      "Personal のすべての機能",
      "最大 10 人まで、人数にかかわらず定額",
      "最大 30 プロジェクト、各 100 ワークフロー",
      "ワークスペースで最大 20 台のデバイス（1 人あたり 3 台まで）",
      "Dagu Cloud を通じてチームでプロジェクトを共有し、プロジェクトごとにメンバーのロールを設定",
      "シークレットの値は各デバイスにとどまります",
    ],
    paidNote:
      "Personal と Team には Dagu Cloud アカウントが必要です。プランが失効しても、既存のプロジェクトとワークフローは動き続けます（アラート、MCP Events、Webhook は停止）。購入は正式リリース時に開始します。",
    enterprise:
      "11 人以上や 21 台以上のデバイスでの利用、請求書払い、個別の契約条件をご希望ですか？メールでご連絡ください。ご要望に合わせてご用意します。",
    enterpriseLink: "法人向け PoC の進め方",
    costs: "Kitewell 以外の費用",
    costsText:
      "AI プロバイダーの利用料、サードパーティのサブスクリプション、インフラの費用は別途かかります。Kitewell には AI クレジットや、ワークフローを動かすホスト型のコンピューターは含まれません。",
    ai: "AI タスクの接続方法 →",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    <div class="cards plans">
      <article class="card">
        <h2>Free</h2>
        <p>{text.freeFor}</p>
        <div class="price">$0</div>
        <ul>
          {text.free.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary" href={localize("/docs/getting-started/", locale)}>
          {text.guide}
        </a>
      </article>
      <article class="card">
        <h2>Personal</h2>
        <p>{text.personalFor}</p>
        <div class="price">
          $25 <span>{text.per}</span>
        </div>
        <ul>
          {text.personal.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card featured">
        <h2>Team</h2>
        <p>{text.teamFor}</p>
        <div class="price">
          $199 <span>{text.per}</span>
        </div>
        <ul>
          {text.team.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
    <p class="fine plans-note">{text.paidNote}</p>
    <div class="notice enterprise" id="enterprise">
      <div>
        <h2>Enterprise</h2>
        <p>{text.enterprise}</p>
      </div>
      <div class="actions">
        <a
          class="button"
          href="mailto:company@descarty.com?subject=Kitewell%20Enterprise"
        >
          company@descarty.com
        </a>
        <a class="button secondary" href={descartyUrl(locale, "/enterprise/")}>{text.enterpriseLink}</a>
      </div>
    </div>
    <div class="prose">
      <h2>{text.costs}</h2>
      <p>{text.costsText}</p>
      <p>
        <a href={localize("/docs/ai/", locale)}>{text.ai}</a>
      </p>
    </div>
  </section>
</Site>
