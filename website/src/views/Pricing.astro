---
import Site from "../layouts/Site.astro";
import { descartyUrl } from "../lib/descarty.mjs";
import { localize } from "../lib/i18n.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
const text = {
  en: {
    title: "Pricing",
    description:
      "Kitewell pricing: one project with up to 10 workflows on one computer free; Kitewell Personal at $20 a month for one person on one computer, with up to five projects of 100 workflows, alerts, and webhooks; Kitewell Team for organizations, quoted per computer, for up to 25 people and 15 projects.",
    eyebrow: "Pricing",
    heading: "One project, free.",
    lead: "A project keeps its workflows, run history, and secrets separate. Every plan includes the same workflow tools. Personal adds room for more work and alerts when it needs you; Team adds the people you share it with, quoted by the computers that run Kitewell.",
    freeName: "Free",
    freePrice: "$0",
    freeFor: "For one person's own work: one project on one computer.",
    free: [
      "One project with up to 10 workflows",
      "Visual workflows and YAML",
      "Schedules, run history, and event handlers",
      "Website, desktop app, and email automation",
      "AI tasks, plus MCP and API access with one API key or connected app (ChatGPT or Claude)",
      "No Kitewell account required",
      "Optionally, sync the project with a free Dagu Cloud account",
      "Its runs in Dagu Console, with an email when a run fails or your computer goes quiet",
    ],
    guide: "Read the getting started guide",
    personalName: "Personal",
    personalPrice: "$20",
    personalPer: "/ month · USD",
    personalTax: "",
    personalFor: "For one person's own work on one computer, including paid work.",
    personal: [
      "Every feature in Free",
      "Up to five projects, 100 workflows each",
      "Any number of API keys and connected apps",
      "Alerts from Kitewell itself when a run fails, waits for you, or misses its schedule: desktop notification, email, Slack, Microsoft Teams, PagerDuty, or webhook",
      "ChatGPT automations that start when a run finishes or needs you (MCP Events)",
      "Webhooks that start a workflow when GitHub, Stripe, a form, or Zapier sends a request",
      "Projects kept in Dagu Cloud, to restore on a new computer",
    ],
    teamName: "Team",
    teamPrice: "Quote",
    teamPer: "",
    teamTax: "Annual contract, priced per computer",
    teamFor: "For an organization of up to 25 people.",
    team: [
      "Every feature in Personal",
      "Priced by the computers that run Kitewell, 1 to 100",
      "Up to 25 people, invitations included",
      "Up to 15 projects, 100 workflows each",
      "Projects shared through Dagu Cloud, with a role for each person on each project",
      "Every computer in Dagu Console, with one alert per workflow across computers",
      "Secret values stay on each computer",
      "Paid by invoice, in yen in Japan",
      "Help from Descarty building your workflows (quoted)",
      "Features your work needs, added to Kitewell itself (quoted)",
    ],
    teamAction: "Ask for a quote",
    paidNote:
      "Prices exclude tax. In Japan, Personal is billed in yen: ¥3,000 a month, plus consumption tax. Free and Personal are for one person's own work; an organization that runs Kitewell for shared work, on several people's computers or on a computer set aside for it, needs Team. Personal and Team need a Dagu Cloud account. Connecting one computer more than your plan holds disconnects your own oldest one. When a plan ends, Kitewell's alerts, MCP Events, and webhooks stop, and 7 days later projects, workflows, and API keys beyond the free plan stop running; you choose which stay. Nothing is deleted, and everything starts again when you subscribe.",
    enterpriseName: "Enterprise",
    enterprise:
      "For more than 25 people or 100 computers, or for a company that needs the features below. Like Team, it is an annual contract, priced per computer at volume plus an annual fee, and the features below are arranged with you under the contract. Email us and we'll set it up with you.",
    enterpriseFeatures: [
      ["Shared computers", "Computers your organization owns, in your own Azure or AWS, on your servers, or hosted by Descarty, run workflows with nobody signed in. Each workflow says which computer it runs on."],
      ["Workspace in the browser", "Build, try, fix, and approve workflows from one address with your company sign-in, whichever computer they run on. A password typed there is encrypted for that computer before it leaves the page."],
      ["SSO and SCIM", "Sign in with SAML, and add or remove people automatically from your identity provider."],
      ["Audit log export", "Every change and every run on every computer, exported and kept for the long term."],
      ["Fleet policies", "Which workflows may run on which computers, set for the whole organization."],
      ["Roles and policies", "A role for each person on each project, and the sites and apps workflows may use."],
      ["Closed-network sync", "Projects sync inside your own environment instead of through Dagu Cloud."],
      ["SLA", "Response times agreed in the contract for when something goes wrong."],
      ["Maintenance and support", "Kitewell bug fixes, help finding why a run stopped, update guidance, and a monthly report. Your team fixes its own workflows."],
      ["Security reviews", "Answers for your security questionnaire and review."],
    ],
    enterpriseLink: "How an enterprise PoC works",
    costs: "Costs outside Kitewell",
    costsText:
      "AI provider usage, third-party subscriptions, and infrastructure costs are separate. On a computer signed in to Dagu Cloud, plans include credits for Kitewell's included model: 100 credits ($1 of model use) once on Free, and 500 credits a month for each computer on Personal and Team. Kitewell does not include a hosted computer to run your workflows.",
    ai: "Learn how AI tasks connect →",
    compare: "How Kitewell compares →",
  },
  ja: {
    title: "料金",
    description:
      "Kitewell の料金です。コンピューター 1 台での 1 プロジェクト・10 ワークフローまでは無料。Kitewell Personal は 1 人・1 台で月額 3,000 円（税込 3,300 円）、最大 5 プロジェクト・各 100 ワークフロー、アラート、Webhook を利用できます。Kitewell Team は法人向けに台数に応じてお見積りし、最大 25 人・15 プロジェクトで使えます。",
    eyebrow: "料金",
    heading: "1 プロジェクトなら無料。",
    lead: "プロジェクトごとに、ワークフロー、実行履歴、シークレットが分かれます。どのプランでも同じワークフロー機能を使えます。Personal では扱える量が増え、対応が必要なときに知らせるアラートが加わります。Team では一緒に使うメンバーが加わり、料金は Kitewell を動かすコンピューターの台数に応じてお見積りします。",
    freeName: "Free",
    freePrice: "¥0",
    freeFor: "1 人が自分の仕事に、1 台で使うプラン。",
    free: [
      "1 プロジェクト、最大 10 ワークフロー",
      "ビジュアルエディタと YAML",
      "スケジュール、実行履歴、イベントハンドラー",
      "Web サイト、デスクトップアプリ、メールの自動化",
      "AI タスク、1 つの API キーまたは接続済みのアプリ（ChatGPT や Claude）での MCP と API アクセス",
      "Kitewell アカウントは不要",
      "無料の Dagu Cloud アカウントでプロジェクトを同期することも可能",
      "Dagu Console で実行を確認し、実行の失敗やコンピューターの停止をメールで受け取れます",
    ],
    guide: "はじめかたガイドを読む",
    personalName: "Personal",
    personalPrice: "¥3,000",
    personalPer: "/ 月",
    personalTax: "税込 ¥3,300 / 月",
    personalFor: "1 人が自分の仕事に、1 台で使うプラン。有償の仕事にも使えます。",
    personal: [
      "Free のすべての機能",
      "最大 5 プロジェクト、各 100 ワークフロー",
      "API キーと接続済みのアプリは無制限",
      "実行の失敗、対応待ち、スケジュールの取りこぼしを知らせる Kitewell 自身のアラート（デスクトップ通知、メール、Slack、Microsoft Teams、PagerDuty、Webhook）",
      "実行の終了や、対応が必要になったときに始まる ChatGPT の自動化（MCP Events）",
      "GitHub、Stripe、フォーム、Zapier からのリクエストでワークフローを開始する Webhook",
      "プロジェクトを Dagu Cloud に保管し、新しいコンピューターで復元",
    ],
    teamName: "Team",
    teamPrice: "お見積り",
    teamPer: "",
    teamTax: "年間契約・台数に応じた料金",
    teamFor: "最大 25 人の組織で使うプラン。",
    team: [
      "Personal のすべての機能",
      "料金は Kitewell を動かすコンピューターの台数（1〜100 台）で決まります",
      "最大 25 人（招待中を含む）",
      "最大 15 プロジェクト、各 100 ワークフロー",
      "Dagu Cloud を通じてチームでプロジェクトを共有し、プロジェクトごとにメンバーのロールを設定",
      "すべてのコンピューターを Dagu Console で一覧でき、アラートはコンピューターをまたいでワークフローごとに 1 件",
      "シークレットの値は各コンピューターにとどまります",
      "円建ての請求書でお支払いいただけます",
      "Descarty によるワークフローの構築支援（1 業務 30 万円〜）",
      "業務に必要な機能を Kitewell 本体に追加する開発（お見積り）",
    ],
    teamAction: "見積りを依頼する",
    paidNote:
      "価格は税抜で、括弧内は消費税 10% を含む税込価格です。日本国外からのお申し込みは米ドルでの決済となり、Personal は月額 20 ドル（税抜）です。Free と Personal は、1 人が自分の仕事に使うためのプランです。組織の共有の仕事に使う場合、つまり複数の人のコンピューターや、そのために用意したコンピューターで動かす場合は Team が必要です。Personal と Team には Dagu Cloud アカウントが必要です。プランの台数を超えてコンピューターを接続すると、自分の最も古いコンピューターの接続が解除されます。プランが終わると、Kitewell のアラート、MCP Events、Webhook が止まり、その 7 日後に無料プランを超える分のプロジェクト、ワークフロー、API キーが止まります。どれを残すかは選べます。データは削除されず、再び契約すればすべて元どおりに動きます。",
    enterpriseName: "Enterprise",
    enterprise:
      "25 人・100 台を超える場合や、次の機能が必要な会社のためのプランです。Team と同じく年間契約で、料金は台数に応じたコンピューター単価と年額の基本料で決まります。次の機能は、Enterprise 契約のもとで個別にご用意します。メールでご連絡ください。",
    enterpriseFeatures: [
      ["共有のコンピューター", "自社の Azure・AWS、社内のサーバー、または Descarty がホストする組織のコンピューターで、誰もサインインせずにワークフローを動かします。どのコンピューターで動かすかは、ワークフローごとに決まります。"],
      ["ブラウザーのワークスペース", "会社のアカウントでひとつのアドレスにサインインし、どのコンピューターで動くワークフローも、ブラウザーで作り、試し、直し、承認できます。そこで入力したパスワードは、そのコンピューター用に暗号化してから送ります。"],
      ["SSO と SCIM", "SAML でサインインし、ID 管理サービスでのメンバーの追加・削除を自動で反映します。"],
      ["監査ログの書き出し", "すべてのコンピューターの変更と実行を書き出し、長期間保管します。"],
      ["コンピューターのポリシー", "どのコンピューターでどのワークフローを動かしてよいかを、組織全体で設定します。"],
      ["ロールとポリシー", "プロジェクトごとのメンバーのロールと、ワークフローが使えるサイト・アプリを設定します。"],
      ["閉域網での同期", "Dagu Cloud を使わず、貴社の環境内でプロジェクトを同期します。"],
      ["SLA", "障害時の対応時間を契約で定めます。"],
      ["保守サポート", "Kitewell の不具合の修正、止まった原因の切り分け、アップデートのご案内、月次の稼働報告。ワークフローの修正は貴社で行います。"],
      ["セキュリティ審査への対応", "セキュリティチェックシートへの回答や審査に対応します。"],
    ],
    enterpriseLink: "法人向け PoC の進め方",
    costs: "Kitewell 以外の費用",
    costsText:
      "AI プロバイダーの利用料、サードパーティのサブスクリプション、インフラの費用は別途かかります。Dagu Cloud にサインインしたコンピューターでは、Kitewell の付属モデル用のクレジットがプランに含まれます。Free は 1 回限りの 100 クレジット（モデル利用 1 ドル分）、Personal と Team はコンピューター 1 台につき毎月 500 クレジットです。ワークフローを動かすホスト型のコンピューターは含まれません。",
    ai: "AI タスクの接続方法 →",
    compare: "Kitewell と、ほかの選択肢 →",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    <div class="cards plans">
      <article class="card">
        <h2>{text.freeName}</h2>
        <p>{text.freeFor}</p>
        <div class="price">{text.freePrice}</div>
        <ul>
          {text.free.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary" href={localize("/docs/getting-started/", locale)}>
          {text.guide}
        </a>
      </article>
      <article class="card">
        <h2>{text.personalName}</h2>
        <p>{text.personalFor}</p>
        <div class="price">
          {text.personalPrice} <span>{text.personalPer}</span>
          {text.personalTax && <span class="price-tax">{text.personalTax}</span>}
        </div>
        <ul>
          {text.personal.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card featured">
        <h2>{text.teamName}</h2>
        <p>{text.teamFor}</p>
        <div class="price">
          {text.teamPrice} {text.teamPer && <span>{text.teamPer}</span>}
          {text.teamTax && <span class="price-tax">{text.teamTax}</span>}
        </div>
        <ul>
          {text.team.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button" href="mailto:company@descarty.com?subject=Kitewell%20Team">{text.teamAction}</a>
      </article>
    </div>
    <p class="fine plans-note">{text.paidNote}</p>
    <div class="notice enterprise" id="enterprise">
      <div class="enterprise-head">
        <div>
          <h2>{text.enterpriseName}</h2>
          <p>{text.enterprise}</p>
        </div>
        <div class="actions">
          <a
            class="button"
            href="mailto:company@descarty.com?subject=Kitewell%20Enterprise"
          >
            company@descarty.com
          </a>
          <a class="button secondary" href={descartyUrl(locale, "/enterprise/")}>{text.enterpriseLink}</a>
        </div>
      </div>
      <ul class="enterprise-features">
        {
          text.enterpriseFeatures.map(([name, detail]) => (
            <li>
              <h3>{name}</h3>
              <p>{detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prose">
      <h2>{text.costs}</h2>
      <p>{text.costsText}</p>
      <p>
        <a href={localize("/docs/ai/", locale)}>{text.ai}</a>
      </p>
      <p>
        <a href={localize("/compare/", locale)}>{text.compare}</a>
      </p>
    </div>
  </section>
</Site>
