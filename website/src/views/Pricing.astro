---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    <div class="cards plans">
      <article class="card">
        <h2>{text.trialName}</h2>
        <p>{text.trialFor}</p>
        <div class="price">
          {text.trialPrice} <span>{text.trialPer}</span>
        </div>
        <ul>
          {text.trial.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary" href={localize("/download/", locale)}>
          {text.trialAction}
        </a>
      </article>
      <article class="card">
        <h2>{text.personalName}</h2>
        <p>{text.personalFor}</p>
        <div class="price">
          {text.personalPrice} <span>{text.personalPer}</span>
          {text.personalTax && <span class="price-tax">{text.personalTax}</span>}
        </div>
        <ul>
          {text.personal.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card featured">
        <h2>{text.teamName}</h2>
        <p>{text.teamFor}</p>
        <div class="price">
          {text.teamPrice} <span>{text.teamPer}</span>
          {text.teamTax && <span class="price-tax">{text.teamTax}</span>}
          <span class="price-tax">{text.teamYear}</span>
        </div>
        <ul>
          {text.team.map((item) => <li>{item}</li>)}
        </ul>
        {/* Signing in through intent=kitewell gives someone new a Kitewell workspace, not a Dagu one. */}
        <a class="button" href="https://console.dagu.sh/login?intent=kitewell&next=%2Fkitewell">{text.teamAction}</a>
      </article>
    </div>
    <p class="fine plans-note">{text.paidNote} {text.cloudNote}</p>
    <section class="notice partner" aria-labelledby="partner-title">
      <div>
        <p class="partner-badge">{text.partnerBadge}</p>
        <h2 id="partner-title">{text.partnerTitle}</h2>
        <p>{text.partnerBody}</p>
      </div>
      <a class="button" href={descartyUrl(locale, "/partners/")}>{text.partnerAction}</a>
    </section>
    <div class="notice enterprise" id="enterprise">
      <div class="enterprise-head">
        <div>
          <h2>{text.enterpriseName}</h2>
          <p>{text.enterprise}</p>
        </div>
        <div class="actions">
          <a
            class="button"
            href="mailto:company@descarty.com?subject=Kitewell%20Enterprise"
          >
            company@descarty.com
          </a>
        </div>
      </div>
      <ul class="enterprise-features">
        {
          text.enterpriseFeatures.map(([name, detail]) => (
            <li>
              <h3>{name}</h3>
              <p>{detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prose">
      <h2>{text.costs}</h2>
      <p>{text.costsText}</p>
      <p>
        <a href={localize("/docs/ai/", locale)}>{text.ai}</a>
      </p>
      <p>
        <a href={localize("/compare/", locale)}>{text.compare}</a>
      </p>
    </div>
  </section>
</Site>
