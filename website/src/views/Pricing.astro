---
import Site from "../layouts/Site.astro";
import { descartyUrl } from "../lib/descarty.mjs";
import { localize } from "../lib/i18n.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
const text = {
  en: {
    title: "Pricing",
    description:
      "Planned Kitewell launch pricing: one project with up to 10 workflows on one computer free; Kitewell Personal at $20 a month for one person on one computer, with up to ten projects of 100 workflows, alerts, and webhooks; Kitewell Team at $29 a month per computer for up to 25 people and 15 projects.",
    eyebrow: "Planned launch pricing",
    heading: "One project, free.",
    lead: "A project keeps its workflows, run history, and secrets separate. Every plan includes the same workflow tools. Personal adds room for more work and alerts when it needs you; Team adds the people you share it with, and you pay for each computer that runs Kitewell.",
    freeName: "Free",
    freePrice: "$0",
    freeFor: "For one project on one computer.",
    free: [
      "One project with up to 10 workflows",
      "Visual workflows and YAML",
      "Schedules, run history, and event handlers",
      "Website, desktop app, and email automation",
      "AI tasks, plus MCP and API access with one API key or connected app (ChatGPT or Claude)",
      "No Kitewell account required",
      "Optionally, sync the project with a free Dagu Cloud account",
    ],
    guide: "Read the getting started guide",
    personalName: "Personal",
    personalPrice: "$20",
    personalPer: "/ month · USD",
    personalTax: "",
    personalFor: "For one person on one computer, including paid work.",
    personal: [
      "Every feature in Free",
      "Up to ten projects, 100 workflows each",
      "Any number of API keys and connected apps",
      "Alerts by desktop notification, email, Slack, Microsoft Teams, PagerDuty, or webhook",
      "ChatGPT automations that start when a run finishes or needs you (MCP Events)",
      "Webhooks that start a workflow when GitHub, Stripe, a form, or Zapier sends a request",
      "Projects kept in Dagu Cloud, to restore on a new computer",
    ],
    teamName: "Team",
    teamPrice: "$29",
    teamPer: "/ computer / month · USD",
    teamTax: "",
    teamFor: "For a team of up to 25 people.",
    team: [
      "Every feature in Personal",
      "As many computers as you need, $29 each",
      "Up to 25 people, invitations included",
      "Up to 15 projects, 100 workflows each",
      "Projects shared through Dagu Cloud, with a role for each person on each project",
      "Secret values stay on each computer",
    ],
    paidNote:
      "Prices exclude tax. In Japan, plans are billed in yen: ¥3,000 a month for Personal and ¥4,400 a month per computer for Team, plus consumption tax. Personal and Team need a Dagu Cloud account. Connecting one computer more than your plan holds disconnects your own oldest one. When a plan ends, alerts, MCP Events, and webhooks stop, and 7 days later projects, workflows, and API keys beyond the free plan stop running; you choose which stay. Nothing is deleted, and everything starts again when you subscribe. Purchase will be available with the public launch.",
    enterpriseName: "Enterprise",
    enterprise:
      "For more than 25 people or 100 computers, or for any of the needs below. Enterprise is priced per computer at volume, plus an annual fee. Email us and we'll set it up with you.",
    enterpriseFeatures: [
      ["SSO and SCIM", "Sign in with SAML, and add or remove people automatically from your identity provider."],
      ["Audit log export", "Every change and every run on every computer, exported and kept for the long term."],
      ["Fleet management", "Each computer's status, version, and last connection, and what may run where."],
      ["Roles and policies", "A role for each person on each project, and the sites and apps workflows may use."],
      ["Closed-network sync", "Projects sync inside your own environment instead of through Dagu Cloud."],
      ["Invoice billing", "An annual contract in Japanese yen, paid by invoice."],
      ["SLA", "Response times agreed in the contract for when something goes wrong."],
      ["Security reviews", "Answers for your security questionnaire and review."],
    ],
    enterpriseLink: "How an enterprise PoC works",
    costs: "Costs outside Kitewell",
    costsText:
      "AI provider usage, third-party subscriptions, and infrastructure costs are separate. Kitewell does not include AI credits or a hosted computer to run your workflows.",
    ai: "Learn how AI tasks connect →",
  },
  ja: {
    title: "料金",
    description:
      "Kitewell の正式リリース時の予定価格です。コンピューター 1 台での 1 プロジェクト・10 ワークフローまでは無料。Kitewell Personal は 1 人・1 台で月額 3,000 円（税込 3,300 円）、最大 10 プロジェクト・各 100 ワークフロー、アラート、Webhook を利用できます。Kitewell Team はコンピューター 1 台あたり月額 4,400 円（税込 4,840 円）で、最大 25 人・15 プロジェクトで使えます。",
    eyebrow: "正式リリース時の予定価格",
    heading: "1 プロジェクトなら無料。",
    lead: "プロジェクトごとに、ワークフロー、実行履歴、シークレットが分かれます。どのプランでも同じワークフロー機能を使えます。Personal では扱える量が増え、対応が必要なときに知らせるアラートが加わります。Team では一緒に使うメンバーが加わり、料金は Kitewell を動かすコンピューターの台数で決まります。",
    freeName: "Free",
    freePrice: "¥0",
    freeFor: "1 台のコンピューターで使うプラン。",
    free: [
      "1 プロジェクト、最大 10 ワークフロー",
      "ビジュアルエディタと YAML",
      "スケジュール、実行履歴、イベントハンドラー",
      "Web サイト、デスクトップアプリ、メールの自動化",
      "AI タスク、1 つの API キーまたは接続済みのアプリ（ChatGPT や Claude）での MCP と API アクセス",
      "Kitewell アカウントは不要",
      "無料の Dagu Cloud アカウントでプロジェクトを同期することも可能",
    ],
    guide: "はじめかたガイドを読む",
    personalName: "Personal",
    personalPrice: "¥3,000",
    personalPer: "/ 月",
    personalTax: "税込 ¥3,300 / 月",
    personalFor: "1 人が 1 台で使うプラン。仕事にも使えます。",
    personal: [
      "Free のすべての機能",
      "最大 10 プロジェクト、各 100 ワークフロー",
      "API キーと接続済みのアプリは無制限",
      "デスクトップ通知、メール、Slack、Microsoft Teams、PagerDuty、Webhook によるアラート",
      "実行の終了や、対応が必要になったときに始まる ChatGPT の自動化（MCP Events）",
      "GitHub、Stripe、フォーム、Zapier からのリクエストでワークフローを開始する Webhook",
      "プロジェクトを Dagu Cloud に保管し、新しいコンピューターで復元",
    ],
    teamName: "Team",
    teamPrice: "¥4,400",
    teamPer: "/ 台 / 月",
    teamTax: "税込 ¥4,840 / 台 / 月",
    teamFor: "最大 25 人のチームで使うプラン。",
    team: [
      "Personal のすべての機能",
      "コンピューターは必要な台数だけ、1 台 4,400 円（税込 4,840 円）",
      "最大 25 人（招待中を含む）",
      "最大 15 プロジェクト、各 100 ワークフロー",
      "Dagu Cloud を通じてチームでプロジェクトを共有し、プロジェクトごとにメンバーのロールを設定",
      "シークレットの値は各コンピューターにとどまります",
    ],
    paidNote:
      "価格は税抜で、括弧内は消費税 10% を含む税込価格です。日本国外からのお申し込みは米ドルでの決済となり、Personal は月額 20 ドル、Team は 1 台あたり月額 29 ドル（いずれも税抜）です。Personal と Team には Dagu Cloud アカウントが必要です。プランの台数を超えてコンピューターを接続すると、自分の最も古いコンピューターの接続が解除されます。プランが終わると、アラート、MCP Events、Webhook が止まり、その 7 日後に無料プランを超える分のプロジェクト、ワークフロー、API キーが止まります。どれを残すかは選べます。データは削除されず、再び契約すればすべて元どおりに動きます。購入は正式リリース時に開始します。",
    enterpriseName: "Enterprise",
    enterprise:
      "26 人以上や 101 台以上での利用、または次の機能が必要な場合は Enterprise をご利用ください。料金は、台数に応じたコンピューター単価と年額の基本料で決まります。メールでご連絡ください。ご要望に合わせてご用意します。",
    enterpriseFeatures: [
      ["SSO と SCIM", "SAML でサインインし、ID 管理サービスでのメンバーの追加・削除を自動で反映します。"],
      ["監査ログの書き出し", "すべてのコンピューターの変更と実行を書き出し、長期間保管します。"],
      ["コンピューターの管理", "各コンピューターの状態、バージョン、最終接続と、どのコンピューターで何を動かしてよいかを管理します。"],
      ["ロールとポリシー", "プロジェクトごとのメンバーのロールと、ワークフローが使えるサイト・アプリを設定します。"],
      ["閉域網での同期", "Dagu Cloud を使わず、貴社の環境内でプロジェクトを同期します。"],
      ["請求書払い", "円建ての年間契約で、請求書でお支払いいただけます。"],
      ["SLA", "障害時の対応時間を契約で定めます。"],
      ["セキュリティ審査への対応", "セキュリティチェックシートへの回答や審査に対応します。"],
    ],
    enterpriseLink: "法人向け PoC の進め方",
    costs: "Kitewell 以外の費用",
    costsText:
      "AI プロバイダーの利用料、サードパーティのサブスクリプション、インフラの費用は別途かかります。Kitewell には AI クレジットや、ワークフローを動かすホスト型のコンピューターは含まれません。",
    ai: "AI タスクの接続方法 →",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    <div class="cards plans">
      <article class="card">
        <h2>{text.freeName}</h2>
        <p>{text.freeFor}</p>
        <div class="price">{text.freePrice}</div>
        <ul>
          {text.free.map((item) => <li>{item}</li>)}
        </ul>
        <a class="button secondary" href={localize("/docs/getting-started/", locale)}>
          {text.guide}
        </a>
      </article>
      <article class="card">
        <h2>{text.personalName}</h2>
        <p>{text.personalFor}</p>
        <div class="price">
          {text.personalPrice} <span>{text.personalPer}</span>
          {text.personalTax && <span class="price-tax">{text.personalTax}</span>}
        </div>
        <ul>
          {text.personal.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="card featured">
        <h2>{text.teamName}</h2>
        <p>{text.teamFor}</p>
        <div class="price">
          {text.teamPrice} <span>{text.teamPer}</span>
          {text.teamTax && <span class="price-tax">{text.teamTax}</span>}
        </div>
        <ul>
          {text.team.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
    <p class="fine plans-note">{text.paidNote}</p>
    <div class="notice enterprise" id="enterprise">
      <div class="enterprise-head">
        <div>
          <h2>{text.enterpriseName}</h2>
          <p>{text.enterprise}</p>
        </div>
        <div class="actions">
          <a
            class="button"
            href="mailto:company@descarty.com?subject=Kitewell%20Enterprise"
          >
            company@descarty.com
          </a>
          <a class="button secondary" href={descartyUrl(locale, "/enterprise/")}>{text.enterpriseLink}</a>
        </div>
      </div>
      <ul class="enterprise-features">
        {
          text.enterpriseFeatures.map(([name, detail]) => (
            <li>
              <h3>{name}</h3>
              <p>{detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prose">
      <h2>{text.costs}</h2>
      <p>{text.costsText}</p>
      <p>
        <a href={localize("/docs/ai/", locale)}>{text.ai}</a>
      </p>
    </div>
  </section>
</Site>
