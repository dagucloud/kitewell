---
import Site from "../layouts/Site.astro";
import ChoreList from "../components/ChoreList.astro";
import Clip from "../components/Clip.astro";
import { chores } from "../lib/chores.mjs";
import type { Locale } from "../lib/i18n.mjs";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = {
  en: {
    title: "What do you still do by hand?",
    description:
      "Chores people do by hand on their computers, and how each one runs on its own with Kitewell: portals, old desktop apps, Excel, email, and code.",
    eyebrow: "Log in. Download. Copy. Paste. Send.",
    heading: "What do you still do by hand?",
    lead: "Find the chore that sounds like your week. Each one runs on your own computer, with your apps and your sign-ins, and stops for your OK where it matters.",
    everyone: "Chores you might recognize",
    code: "If you write code",
    honest: "Every chore here is backed by a workflow that uses only steps Kitewell has.",
  },
  ja: {
    title: "まだ、手でやっていますか。",
    description:
      "コンピューターで手作業している仕事と、それが Kitewell でひとりでに動く様子。取引先のポータル、古いデスクトップアプリ、Excel、メール、そしてコード。",
    eyebrow: "ログイン。ダウンロード。コピー。貼り付け。送信。",
    heading: "まだ、手でやっていますか。",
    lead: "あなたの 1 週間に似た作業を探してください。どれも、あなたのコンピューターで、あなたのアプリとサインインのまま動き、大事なところではあなたの OK を待ちます。",
    everyone: "見覚えのある作業",
    code: "コードを書く人へ",
    honest: "ここにある作業はどれも、Kitewell にあるステップだけを使うワークフローに裏付けられています。",
  },
  zh: {
    title: "你还在手动做哪些事？",
    description:
      "人们在电脑上手动完成的任务，以及每一项如何借助 Kitewell 自动运行：门户网站、老旧的桌面应用、Excel、电子邮件和代码。",
    eyebrow: "登录。下载。复制。粘贴。发送。",
    heading: "你还在手动做哪些事？",
    lead: "找找看哪项任务最像你每周在做的事。每一项都在你自己的电脑上运行，使用你的应用和你的登录，并在关键处停下来等你确认。",
    everyone: "你可能熟悉的任务",
    code: "如果你写代码",
    honest: "这里的每项任务，背后都有一个只使用 Kitewell 现有步骤的工作流。",
  },
  ko: {
    title: "아직도 손으로 하는 일이 있나요?",
    description:
      "사람들이 컴퓨터에서 손으로 하는 업무와, 각 업무가 Kitewell로 자동 실행되는 방식. 포털, 오래된 데스크톱 앱, Excel, 이메일, 그리고 코드까지.",
    eyebrow: "로그인. 다운로드. 복사. 붙여넣기. 전송.",
    heading: "아직도 손으로 하는 일이 있나요?",
    lead: "내 한 주와 닮은 업무를 찾아보세요. 모두 내 컴퓨터에서 내 앱과 내 로그인으로 실행되며, 중요한 순간에는 승인을 기다립니다.",
    everyone: "익숙한 업무",
    code: "코드를 작성한다면",
    honest: "여기 있는 모든 업무는 Kitewell에 있는 단계만 사용하는 워크플로로 뒷받침됩니다.",
  },
  fr: {
    title: "Que faites-vous encore à la main ?",
    description:
      "Les tâches que l’on fait encore à la main sur ordinateur, et comment chacune s’exécute toute seule avec Kitewell : portails, vieilles applications de bureau, Excel, e-mail et code.",
    eyebrow: "Se connecter. Télécharger. Copier. Coller. Envoyer.",
    heading: "Que faites-vous encore à la main ?",
    lead: "Trouvez la tâche qui ressemble à votre semaine. Chacune s’exécute sur votre propre ordinateur, avec vos applications et vos connexions, et attend votre accord là où c’est important.",
    everyone: "Des tâches que vous reconnaîtrez peut-être",
    code: "Si vous écrivez du code",
    honest: "Chaque tâche présentée ici repose sur un workflow qui n’utilise que des étapes dont Kitewell dispose.",
  },
  de: {
    title: "Was erledigen Sie noch von Hand?",
    description:
      "Aufgaben, die Menschen am Computer von Hand erledigen, und wie jede davon mit Kitewell von selbst läuft: Portale, alte Desktop-Apps, Excel, E-Mail und Code.",
    eyebrow: "Anmelden. Herunterladen. Kopieren. Einfügen. Senden.",
    heading: "Was erledigen Sie noch von Hand?",
    lead: "Finden Sie die Aufgabe, die nach Ihrer Woche klingt. Jede läuft auf Ihrem eigenen Computer, mit Ihren Apps und Ihren Anmeldungen, und wartet an den entscheidenden Stellen auf Ihr OK.",
    everyone: "Aufgaben, die Sie vielleicht kennen",
    code: "Wenn Sie programmieren",
    honest: "Hinter jeder Aufgabe hier steht ein Workflow, der nur Schritte nutzt, die Kitewell hat.",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap chores-page">
    <div class="chores-hero">
      <div>
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.heading}</h1>
        <p class="lead">{text.lead}</p>
      </div>
      <figure class="chore-film">
        <Clip locale={locale} name="busywork" label={text.eyebrow} />
      </figure>
    </div>

    <section class="chore-group" aria-labelledby="group-everyone">
      <h2 id="group-everyone">{text.everyone}</h2>
      <ChoreList locale={locale} chores={chores.filter((chore) => chore.group === "everyone")} />
    </section>
    <section class="chore-group" aria-labelledby="group-code">
      <h2 id="group-code">{text.code}</h2>
      <ChoreList locale={locale} chores={chores.filter((chore) => chore.group === "code")} />
    </section>
    <p class="fine chores-honest">{text.honest}</p>
  </section>
</Site>
