---
import Site from "../layouts/Site.astro";
import ChoreList from "../components/ChoreList.astro";
import Clip from "../components/Clip.astro";
import { chores } from "../lib/chores.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
const text = {
  en: {
    title: "What do you still do by hand?",
    description:
      "Chores people do by hand on their computers, and how each one runs on its own with Kitewell: portals, old desktop apps, Excel, email, and code.",
    eyebrow: "Log in. Download. Copy. Paste. Send.",
    heading: "What do you still do by hand?",
    lead: "Describe the chore, or find it below. Each one runs on your own computer, with your apps and your sign-ins, and stops for your OK where it matters.",
    everyone: "Chores you might recognize",
    code: "If you write code",
    honest: "Every chore here is backed by a workflow that uses only steps Kitewell has.",
  },
  ja: {
    title: "まだ、手でやっていますか。",
    description:
      "コンピューターで手作業している仕事と、それが Kitewell でひとりでに動く様子。取引先のポータル、古いデスクトップアプリ、Excel、メール、そしてコード。",
    eyebrow: "ログイン。ダウンロード。コピー。貼り付け。送信。",
    heading: "まだ、手でやっていますか。",
    lead: "作業を書くか、下から探してください。どれも、あなたのコンピューターで、あなたのアプリとサインインのまま動き、大事なところではあなたの OK を待ちます。",
    everyone: "見覚えのある作業",
    code: "コードを書く人へ",
    honest: "ここにある作業はどれも、Kitewell にあるステップだけを使うワークフローに裏付けられています。",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap chores-page">
    <div class="chores-hero">
      <div>
        <p class="eyebrow">{text.eyebrow}</p>
        <h1>{text.heading}</h1>
        <p class="lead">{text.lead}</p>
      </div>
      <figure class="chore-film">
        <Clip locale={locale} name="busywork" label={text.eyebrow} />
      </figure>
    </div>

    <section class="chore-group" aria-labelledby="group-everyone">
      <h2 id="group-everyone">{text.everyone}</h2>
      <ChoreList locale={locale} chores={chores.filter((chore) => chore.group === "everyone")} />
    </section>
    <section class="chore-group" aria-labelledby="group-code">
      <h2 id="group-code">{text.code}</h2>
      <ChoreList locale={locale} chores={chores.filter((chore) => chore.group === "code")} />
    </section>
    <p class="fine chores-honest">{text.honest}</p>
  </section>
</Site>
