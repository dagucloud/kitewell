---
import Site from "../layouts/Site.astro";
import Artifact from "../components/Artifact.astro";
import ChoreList from "../components/ChoreList.astro";
import Clip from "../components/Clip.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Moment from "../components/Moment.astro";
import RunCard from "../components/RunCard.astro";
import { localize, type Locale } from "../lib/i18n.mjs";
import { choreBySlug, needsFor } from "../lib/chores.mjs";
interface Props {
  locale: Locale;
  chore: any;
}
const { locale, chore } = Astro.props;
const copy = chore[locale];
const film: Record<string, string> = chore.film ?? {};
const related = chore.related.map(choreBySlug);
const text = {
  en: {
    back: "← All chores",
    now: "How it goes now",
    tell: "Tell Kitewell once",
    you: "You",
    tellNote: "That's the whole setup. Kitewell lays out every step for you to check, and nothing is saved until you apply it.",
    yours: "For your own version, copy this and fill in the blanks:",
    copy: "Copy this request",
    copied: "Copied",
    run: "Then it runs on its own",
    after: "What you get instead",
    good: "Good to know",
    needs: "What it needs",
    awake: "Your computer needs to be on and awake when it runs. A run missed while it slept starts when it wakes, within 24 hours by default.",
    more: "More chores",
    stop: ". ",
  },
  ja: {
    back: "← すべての作業",
    now: "いまのやり方",
    tell: "Kitewell に一度だけ伝える",
    you: "あなた",
    tellNote: "準備はこれだけです。Kitewell がすべての手順を並べるので、確かめてから適用します。適用するまで何も保存されません。",
    yours: "ご自身の作業なら、これをコピーして [ ] の中を書き換えてください。",
    copy: "この依頼をコピー",
    copied: "コピーしました",
    run: "あとは、ひとりでに動く",
    after: "代わりに届くもの",
    good: "知っておくこと",
    needs: "必要なもの",
    awake: "実行の時刻には、コンピューターが起動していて、スリープしていない必要があります。スリープ中に逃した実行は、起きたときに始まります（既定では 24 時間以内のもの）。",
    more: "ほかの作業",
    stop: "。",
  },
}[locale];
const good = chore.scheduled ? [...copy.good, text.awake] : copy.good;
// Search finds a chore by the job it automates; the page itself opens on the
// chore in the person's own words.
const title = copy.title ?? copy.chore;
const description = copy.title ? `${copy.title}${text.stop}${copy.chore}` : copy.sentence;
---

<Site title={title} description={description}>
  <article class="wrap chore-page" data-example={chore.slug}>
    <a class="text-link chore-back" href={localize("/examples/", locale)}>{text.back}</a>
    <header class="chore-hero">
      <p class="eyebrow">{copy.when}</p>
      <h1>{copy.chore}</h1>
    </header>

    <section class:list={["chore-section", "chore-now", { "with-film": film.now }]} aria-labelledby="now">
      <div>
        <h2 id="now">{text.now}</h2>
        <p class="motions">
          {copy.motions.map((motion: string, index: number) => <span style={`--i: ${index}`}>{motion}</span>)}
        </p>
        <p class="tally">{copy.tally}</p>
      </div>
      {film.now && (
        <figure class="chore-film">
          <Clip locale={locale} name={film.now} label={copy.motions.join(" ")} />
        </figure>
      )}
    </section>

    <section class:list={["chore-section", "chore-tell", { "with-film": film.tell }]} aria-labelledby="tell">
      <div>
        <h2 id="tell">{text.tell}</h2>
        <figure class="said">
          <figcaption>{text.you}</figcaption>
          <blockquote>{copy.sentence}</blockquote>
        </figure>
        <p class="chore-note">{text.tellNote}</p>
        <div class="request">
          <p class="request-label">{text.yours}</p>
          <p class="request-text" data-request>{copy.request}</p>
          <button type="button" class="button secondary small" data-copy-request={chore.slug} data-copied={text.copied}>
            {text.copy}
          </button>
        </div>
        <DownloadButton locale={locale} place="example" />
      </div>
      {film.tell && (
        <figure class="chore-film">
          <Clip locale={locale} name={film.tell} label={copy.sentence} />
        </figure>
      )}
    </section>

    <section class="chore-section chore-run" aria-labelledby="run">
      <h2 id="run">{text.run}</h2>
      {film.run && (
        <div class="film-pair">
          <figure class="chore-film">
            <Clip locale={locale} name={film.run} label={copy.run} />
            <figcaption>{copy.run}</figcaption>
          </figure>
          <figure class="chore-film">
            <Clip locale={locale} name={film.ok} label={copy.ok} />
            <figcaption>{copy.ok}</figcaption>
          </figure>
        </div>
      )}
      <RunCard locale={locale} title={copy.moment.title} steps={copy.steps} />
    </section>

    <section class="chore-section chore-after" aria-labelledby="after">
      <h2 id="after">{text.after}</h2>
      <div class="chore-stage">
        <Moment moment={copy.moment} />
        {film.after ? (
          <figure class="chore-film">
            <Clip locale={locale} name={film.after} label={copy.after} />
            <figcaption>{copy.after}</figcaption>
          </figure>
        ) : (
          <Artifact locale={locale} artifact={copy.artifact} />
        )}
      </div>
    </section>

    <section class="chore-section chore-facts" aria-label={text.good}>
      <div>
        <h2>{text.good}</h2>
        <ul>{good.map((line: string) => <li>{line}</li>)}</ul>
      </div>
      <div>
        <h2>{text.needs}</h2>
        <ul>{needsFor(chore, locale).map((need: string) => <li>{need}</li>)}</ul>
      </div>
    </section>
    {copy.film && (
      <p class="fine chore-credit">
        {copy.film}
      </p>
    )}


    <section class="chore-group" aria-labelledby="more">
      <h2 id="more">{text.more}</h2>
      <ChoreList locale={locale} chores={related} />
    </section>
  </article>
  <script>
    import { track } from "../lib/analytics";
    const page = document.querySelector<HTMLElement>("[data-example]");
    if (page?.dataset.example) {
      track("example_viewed", { slug: page.dataset.example });
    }
    // The request is copied for the person's own chat, blanks and all.
    const copyRequest = document.querySelector<HTMLButtonElement>("[data-copy-request]");
    copyRequest?.addEventListener("click", async () => {
      const request = document.querySelector<HTMLElement>("[data-request]")!;
      try {
        // Japanese text binds some spaces as no-break ones; a chat wants plain spaces.
        await navigator.clipboard.writeText(request.textContent!.replaceAll("\u00a0", " "));
      } catch {
        // Without the clipboard, the request is selected for the person to copy.
        getSelection()?.selectAllChildren(request);
        return;
      }
      const label = copyRequest.textContent;
      copyRequest.textContent = copyRequest.dataset.copied!;
      setTimeout(() => (copyRequest.textContent = label), 2000);
      track("request_copied", { slug: copyRequest.dataset.copyRequest! });
    });
    // The clicks of the chore light up one after another, once, when read.
    const now = document.querySelector(".chore-now");
    if (now) {
      const seen = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          now.classList.add("playing");
          seen.disconnect();
        },
        { threshold: 0.6 },
      );
      seen.observe(now);
    }
  </script>
</Site>
