---
import Site from "../layouts/Site.astro";
import { languages, type Locale } from "../lib/i18n.mjs";
interface Props {
  locale: Locale;
  document: "privacy" | "terms";
}
const { locale, document } = Astro.props;
const documents = import.meta.glob<{
  frontmatter: { title: string; description: string; updated: string };
  Content: astroHTML.JSX.Element;
}>("../legal/*/*.md", { eager: true });
const { frontmatter, Content } = documents[`../legal/${locale}/${document}.md`];
const updatedLabel = { en: "Last updated", ja: "最終更新日", zh: "最后更新", ko: "최종 업데이트", fr: "Dernière mise à jour", de: "Zuletzt aktualisiert" }[locale];
const updated = new Intl.DateTimeFormat(languages[locale].format, {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(frontmatter.updated));
---

<Site title={frontmatter.title} description={frontmatter.description}>
  <section class="page wrap">
    <h1>{frontmatter.title}</h1>
    <p class="fine">{updatedLabel}: <time datetime={new Date(frontmatter.updated).toISOString().slice(0, 10)}>{updated}</time></p>
    <div class="prose">
      <Content />
    </div>
  </section>
</Site>
