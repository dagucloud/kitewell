---
import Site from "../layouts/Site.astro";
import { releaseNotes } from "../lib/releases.mjs";
import { localize, type Locale } from "../lib/i18n.mjs";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const processor = await createMarkdownProcessor();
const releases = await Promise.all(
  (await releaseNotes()).map(async (release) => ({
    ...release,
    html: (await processor.render(release.body)).code,
  })),
);
const text = {
  en: {
    title: "Releases",
    description: "Kitewell release notes, known issues, and versioned downloads.",
    eyebrow: "What's new",
    heading: "A record of each release.",
    lead: "Changes, known issues, and downloads for every public Kitewell version.",
    assets: "Installers and release assets ↗",
    soon: "The first release is coming soon",
    soonText: "Release notes will appear here when a verified installer is published.",
    docs: "Explore the documentation",
    docsAfter: " in the meantime.",
  },
  ja: {
    title: "リリース",
    description: "Kitewell のリリースノート、既知の問題、バージョンごとのダウンロード。",
    eyebrow: "最新情報",
    heading: "リリースの記録。",
    lead: "公開された各バージョンの変更点、既知の問題、ダウンロード。リリースノートは英語で掲載します。",
    assets: "インストーラーとリリースアセット ↗",
    soon: "最初のリリースを近日公開",
    soonText: "検証済みのインストーラーを公開すると、ここにリリースノートを掲載します。",
    docs: "それまではドキュメントをご覧ください",
    docsAfter: "。",
  },
  zh: {
    title: "版本发布",
    description: "Kitewell 的发布说明、已知问题和各版本下载。",
    eyebrow: "最新动态",
    heading: "每个版本的记录。",
    lead: "每个 Kitewell 公开版本的变更、已知问题和下载。发布说明以英文发布。",
    assets: "安装程序与发布文件 ↗",
    soon: "首个版本即将发布",
    soonText: "经过验证的安装程序发布后，发布说明会显示在这里。",
    docs: "在此之前，欢迎浏览文档",
    docsAfter: "。",
  },
  ko: {
    title: "릴리스",
    description: "Kitewell 릴리스 노트, 알려진 문제, 버전별 다운로드.",
    eyebrow: "새로운 소식",
    heading: "릴리스 기록.",
    lead: "공개된 모든 Kitewell 버전의 변경 사항, 알려진 문제, 다운로드. 릴리스 노트는 영어로 제공합니다.",
    assets: "설치 프로그램 및 릴리스 파일 ↗",
    soon: "첫 릴리스가 곧 나옵니다",
    soonText: "검증된 설치 프로그램이 공개되면 이곳에 릴리스 노트가 표시됩니다.",
    docs: "그동안 문서를 둘러보세요",
    docsAfter: ".",
  },
  fr: {
    title: "Versions",
    description: "Notes de version, problèmes connus et téléchargements par version de Kitewell.",
    eyebrow: "Nouveautés",
    heading: "L’historique de chaque version.",
    lead: "Modifications, problèmes connus et téléchargements pour chaque version publique de Kitewell. Les notes de version sont publiées en anglais.",
    assets: "Programmes d’installation et fichiers de la version ↗",
    soon: "La première version arrive bientôt",
    soonText: "Les notes de version apparaîtront ici dès qu’un programme d’installation vérifié sera publié.",
    docs: "Explorez la documentation",
    docsAfter: " en attendant.",
  },
  de: {
    title: "Versionen",
    description: "Versionshinweise, bekannte Probleme und Downloads nach Version für Kitewell.",
    eyebrow: "Neuigkeiten",
    heading: "Jede Version im Überblick.",
    lead: "Änderungen, bekannte Probleme und Downloads für jede öffentliche Kitewell-Version. Die Versionshinweise erscheinen auf Englisch.",
    assets: "Installer und Release-Dateien ↗",
    soon: "Die erste Version erscheint bald",
    soonText: "Versionshinweise erscheinen hier, sobald ein geprüfter Installer veröffentlicht ist.",
    docs: "Sehen Sie sich in der Zwischenzeit die Dokumentation an",
    docsAfter: ".",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    {releases.length ? (
      releases.map((release) => (
        <article class="release prose" lang="en">
          <h2>Kitewell {release.version}</h2>
          <a
            class="release-link"
            href={`https://github.com/dagucloud/kitewell/releases/tag/v${release.version}`}
          >
            {text.assets}
          </a>
          <div set:html={release.html} />
        </article>
      ))
    ) : (
      <div class="notice">
        <h3>{text.soon}</h3>
        <p>
          {text.soonText}{" "}
          <a href={localize("/docs/", locale)}>{text.docs}</a>{text.docsAfter}
        </p>
      </div>
    )}
  </section>
</Site>
