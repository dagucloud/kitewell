    ],
    examples: "Beispiele",
    examplesTitle: "Was erledigen Sie noch von Hand?",
    examplesLink: "Alle Beispiele →",
    pricing: "Preise",
    pricingTitle: "14 Tage kostenlos.",
    pricingText: "Die Anmeldung startet eine 14-tägige Testphase mit den Funktionen von Team, ohne Kreditkarte. Personal kostet 20 $ pro Monat für die eigene Arbeit einer Person; Team ergänzt Personen und läuft auch, wenn niemand angemeldet ist, für 99 $ pro Computer und Monat (USD, zuzüglich Steuern). Die Agenten laufen mit ihren eigenen Anmeldungen und Abos.",
    compare: "Tarife vergleichen →",
  },
}[locale];
const to = (path: string) => localize(path, locale);
const coding = ["fix-failing-tests", "review-every-pr", "triage-issues", "dependency-update"].map(choreBySlug);
---

<Site title={text.title} description={text.description}>
  <div class="home">
    <section class="intro wrap" aria-labelledby="agents-title">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1 id="agents-title">{text.heading}</h1>
      <p class="intro-lead">{text.lead}</p>
      <div class="intro-actions">
        <DownloadButton locale={locale} place="coding" />
      </div>
      <p class="fine">{text.platform}</p>
      <figure class="intro-media">
        <div class="frame">
          <Clip locale={locale} src={`/videos/proof/agents-${recording(locale)}`} width={1920} height={1200} label={text.proof} />
        </div>
        <figcaption>{text.proofNote}</figcaption>
      </figure>
    </section>

    <section class="block wrap" id="together" aria-labelledby="together-title">
      <div class="pair">
        <div>
          <p class="eyebrow">{text.how}</p>
          <h2 id="together-title">{text.howTitle}</h2>
          <ul class="points">
            {text.agentItems.map(([name, detail]) => (
              <li>
                <strong>{name}</strong>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
          <a class="text-link" href={to("/docs/ai/")}>{text.agentsLink}</a>
        </div>
        <div class="agents-proof">
          <ul class="agent-grid">
            {text.agentNames.map((name) => <li>{name}</li>)}
            <li class="agent-more">{text.agentMore}</li>
          </ul>
          <figure class="record-figure">
            <div class="record">
              <div class="record-head">
                <strong>{text.chain.title}</strong>
              </div>
              <ol class="chain">
                {text.chain.steps.map(([kind, name, note]) => (
                  <li>
                    <span class="chain-kind">{kind}</span>
                    <span class="chain-name">{name}</span>
                    {note && <span class="chain-note">{note}</span>}
                  </li>
                ))}
              </ol>
            </div>
            <figcaption>{text.chain.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="block wrap" id="triggers" aria-labelledby="triggers-title">
      <p class="eyebrow">{text.triggers}</p>
      <h2 id="triggers-title" class="block-title">{text.triggersTitle}</h2>
      <div class="trio">
        {text.triggerItems.map(([name, detail, plan, href]) => (
          <div>
            <h3><a href={to(href)}>{name}</a></h3>
            <p>{detail}</p>
            {plan && <span class="plan-tag">{plan}</span>}
          </div>
        ))}
      </div>
    </section>

    <section class="block wrap" id="examples" aria-labelledby="examples-title">
      <p class="eyebrow">{text.examples}</p>
      <h2 id="examples-title" class="block-title">{text.examplesTitle}</h2>
      <ChoreList locale={locale} chores={coding} />
      <a class="text-link" href={to("/examples/")}>{text.examplesLink}</a>
    </section>

    <section class="finale wrap" aria-labelledby="pricing-title">
      <div>
        <p class="eyebrow">{text.pricing}</p>
        <h2 id="pricing-title">{text.pricingTitle}</h2>
        <p class="block-lead">{text.pricingText}</p>
        <div class="links">
          <a class="text-link" href={to("/pricing/")}>{text.compare}</a>
        </div>
      </div>
      <div class="finale-action">
        <DownloadButton locale={locale} place="coding-closing" />
        <p class="fine">{text.platform}</p>
      </div>
    </section>
  </div>
</Site>
