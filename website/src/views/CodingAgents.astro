        ["Agent · Codex", "Die Änderung prüfen und auflisten, was zu korrigieren ist", ""],
        ["Genehmigung", "Vor dem Push auf Sie warten", ""],
        ["Befehl", "Den Branch pushen und einen Pull Request öffnen", ""],
      ],
      caption: "Ein Beispiel-Workflow: Ein Agent schreibt, ein anderer prüft, und nichts wird gepusht, bevor Sie genehmigen.",
    },
    triggers: "Auslöser",
    triggersTitle: "Es startet von selbst.",
    triggerItems: [
      ["Zeitpläne", "Täglich, montags bis freitags oder nach jedem anderen Zeitplan, in Ihrer Zeitzone. Starts, die ein schlafender Computer verpasst hat, werden beim Aufwachen nachgeholt.", "", "/docs/scheduling/"],
      ["Webhooks", "GitHub, Stripe, Slack oder jeder andere Dienst startet über das Relay von Kitewell einen Workflow auf Ihrem Computer. Signaturen werden geprüft, kein Port wird geöffnet, und eine Anfrage wartet bis zu 7 Tage.", "Personal und Team", "/docs/webhooks/"],
