    agentNames: ["Claude Code", "Codex", "Cursor", "Gemini", "GitHub Copilot", "Aider", "Amp", "Cline", "DeepSeek", "Droid", "Goose", "Kiro", "OpenCode", "Pi", "Qwen"],
    agentMore: "Jede andere CLI als eigener Befehl",
    how: "So arbeiten sie zusammen",
