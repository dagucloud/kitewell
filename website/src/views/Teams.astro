const to = (path: string) => localize(path, locale);
const shots = { en: runEn, ja: runJa, zh: runZh, ko: runKo, fr: runFr, de: runDe };
// Each line of the headline is a block of its own, so a line that wraps on a
// phone splits evenly instead of leaving its last word alone.
const lines = (value: string) =>
  value
    .split("\n")
    .map((line) => `<span>${line}</span>`)
    .join("");
---

<Site title={text.title} description={text.description}>
  <div class="home">
    <section class="intro wrap" aria-labelledby="hero-title">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1 id="hero-title" set:html={lines(text.heading)} />
      <p class="intro-lead">{text.lead}</p>
      <div class="intro-actions">
        <a class="button" href={cloudSignup}>{text.trial}</a>
        <DownloadButton locale={locale} place="teams" secondary />
      </div>
      <p class="fine">{text.platform}</p>
    </section>

    <section class="block wrap" id="rpa" aria-labelledby="rpa-title">
      <p class="eyebrow">{text.rpa}</p>
      <h2 id="rpa-title" class="block-title">{text.rpaTitle}</h2>
      <div class="table-scroll">
        <table class="versus">
          <thead>
            <tr>
              <th scope="col">{text.rpaHead[0]}</th>
              <th scope="col">{text.rpaHead[1]}</th>
            </tr>
          </thead>
          <tbody>
            {text.rpaRows.map(([before, after]) => (
              <tr>
                <td>{before}</td>
                <td>{after}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <a class="text-link" href={to("/compare/")}>{text.others}</a>
    </section>

    <section class="block wrap" id="triggers" aria-labelledby="triggers-title">
      <p class="eyebrow">{text.triggers}</p>
      <h2 id="triggers-title" class="block-title">{text.triggersTitle}</h2>
      <div class="trio">
        {text.triggerItems.map(([name, detail, plan, href]) => (
          <div>
            <h3><a href={to(href)}>{name}</a></h3>
            <p>{detail}</p>
            {plan && <span class="plan-tag">{plan}</span>}
          </div>
        ))}
      </div>
    </section>

    <section class="block wrap" id="control" aria-labelledby="control-title">
      <p class="eyebrow">{text.control}</p>
      <h2 id="control-title" class="block-title">{text.controlTitle}</h2>
      <div class="pair wide-media">
        <figure class="frame">
          <Image src={shots[locale]} alt={text.controlAlt} widths={[720, 1440]} sizes="(max-width: 860px) 100vw, 640px" />
        </figure>
        <div>
          <div class="grid-two">
            {text.controlItems.map(([name, detail]) => (
              <div>
                <h3>{name}</h3>
                <p>{detail}</p>
              </div>
            ))}
          </div>
          <p class="fine">{text.controlNote}</p>
          <div class="links">
            {text.controlLinks.map(([label, href]) => (
              <a class="text-link" href={to(href)}>{label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="block wrap" id="team" aria-labelledby="team-title">
      <p class="eyebrow">{text.team}</p>
      <h2 id="team-title" class="block-title">{text.teamTitle}</h2>
      <div class="pair">
        <div>
          <ul class="points">
            {text.teamItems.map(([name, detail]) => (
              <li>
                <strong>{name}</strong>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
          <p class="fine">{text.teamPrice}</p>
          <div class="links">
            {text.teamLinks.map(([label, href]) => (
              <a class="text-link" href={to(href)}>{label}</a>
            ))}
          </div>
        </div>
        <figure class="record-figure">
          <div class="record">
            <div class="record-head">
              <strong>{text.fleet.title}</strong>
              <span>Dagu Console</span>
            </div>
            <div class="table-scroll">
              <table class="fleet">
                <thead>
                  <tr>
                    {text.fleet.head.map((name, i) => <th scope="col" class:list={{ num: i >= 4 }}>{name}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {text.fleet.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) =>
                        i === 0 ? <th scope="row">{cell}</th> : <td class:list={{ num: i >= 4 }}>{cell}</td>,
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <figcaption>{text.fleet.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="block wrap" id="where" aria-labelledby="where-title">
      <p class="eyebrow">{text.runs}</p>
      <h2 id="where-title" class="block-title">{text.runsTitle}</h2>
      <dl class="places">
        {text.places.map(([name, label, detail]) => (
          <div>
            <dt>
              {name}
              {label && <span class="place-label">{label}</span>}
            </dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <div class="links">
        <a class="text-link" href={to("/docs/cloud/")}>{text.placesCloud}</a>
        <a class="text-link" href={locale === "ja" ? descartyUrl(locale, "/early-access/") : to("/pricing/#enterprise")}>{text.placesLink}</a>
      </div>
    </section>

    <section class="block wrap" id="own" aria-labelledby="own-title">
      <p class="eyebrow">{text.own}</p>
      <h2 id="own-title" class="block-title">{text.ownTitle}</h2>
      <dl class="own-facts">
        {[...text.access, ...text.ownRows].map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={to("/docs/data-flow/")}>{text.ownLink}</a>
    </section>

    <section class="finale wrap" aria-labelledby="pricing-title">
      <div>
        <p class="eyebrow">{text.pricing}</p>
        <h2 id="pricing-title">{text.pricingTitle}</h2>
        <p class="block-lead">{text.pricingText}</p>
        <div class="links">
          <a class="text-link" href={to("/pricing/")}>{text.compare}</a>
          <a class="text-link" href={to("/compare/")}>{text.others}</a>
        </div>
      </div>
      <div class="finale-action">
        <div class="finale-buttons">
          <a class="button" href={cloudSignup}>{text.trial}</a>
          <DownloadButton locale={locale} place="closing" secondary />
        </div>
        <p class="fine">{text.platform}</p>
      </div>
    </section>
  </div>
</Site>
