      ["/docs/scheduling/", "Ruhezustand und Hintergrundbetrieb verstehen"],
      ["/docs/backups/", "Ihren Arbeitsbereich sichern und wiederherstellen"],
    ],
    business: "Bei Fragen zur Einführung im Team, zu Preisen oder zu anderen geschäftlichen Themen schreiben Sie uns eine E-Mail:",
  },
}[locale];
---

<Site title={text.title} description={text.description}>
  <section class="page wrap">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>{text.heading}</h1>
    <p class="lead">{text.lead}</p>
    <div class="cards">
      <article class="card">
        <h2>{text.bugs}</h2>
        <p>{text.bugsText}</p>
        <a class="button" href="/community/">{text.community}</a>
        <a
          class="button secondary"
          href="https://github.com/dagucloud/kitewell/issues/new/choose"
        >
          {text.issue}
        </a>
      </article>
      <article class="card">
        <h2>{text.security}</h2>
        <p>{text.securityText}</p>
        <a
          class="button secondary"
          href="https://github.com/dagucloud/kitewell/security/advisories/new"
        >
          {text.report}
        </a>
      </article>
    </div>
    <div class="prose">
      <h2>{text.start}</h2>
      <ul>
        {text.guides.map(([href, label]) => (
          <li>
            <a href={localize(href, locale)}>{label}</a>
          </li>
        ))}
      </ul>
      <p>
        {text.business}{" "}
        <a href="mailto:company@descarty.com?subject=Kitewell">company@descarty.com</a>{locale === "en" ? "." : ""}
      </p>
    </div>
  </section>
</Site>
