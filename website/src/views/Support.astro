      ["/docs/scheduling/", "Comprendre la veille et le fonctionnement en arrière-plan"],
      ["/docs/backups/", "Sauvegarder et restaurer votre espace de travail"],
    ],
    business: "Pour un déploiement en équipe, les tarifs ou toute autre question commerciale, contactez-nous par e-mail :",
  },
  de: {
    title: "Support",
    description: "Hilfe zu Kitewell erhalten, einen Fehler melden oder eine Sicherheitslücke vertraulich melden.",
    eyebrow: "Etwas Hilfe",
    heading: "Finden Sie Ihren nächsten Schritt.",
    lead: "Beginnen Sie mit den Anleitungen. Wenn danach noch etwas nicht funktioniert, fragen Sie in der Kitewell-Community auf Slack oder eröffnen Sie ein Issue mit den Angaben, die zum Nachstellen nötig sind.",
    bugs: "Fragen und Fehler",
    bugsText:
      "Geben Sie Ihre Kitewell-Version, Ihr Betriebssystem, Ihren Prozessor und die Schritte an, die zu dem Problem geführt haben. Entfernen Sie Zugangsdaten und private Daten aus den Logs.",
    community: "In Slack fragen ↗",
    issue: "Issue eröffnen ↗",
    security: "Sicherheitsmeldungen",
    securityText:
      "Melden Sie Schwachstellen vertraulich über GitHub. Geben Sie die betroffene Version und ein reproduzierbares Beispiel ohne echte Zugangsdaten an.",
    report: "Vertraulich melden ↗",
    start: "Gute Ausgangspunkte",
    guides: [
      ["/docs/getting-started/", "Ihren ersten Workflow erstellen"],
