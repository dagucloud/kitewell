    title: "KI-Automatisierung, die sich selbst erstellt und repariert",
    description: "Schreiben Sie eine Büroaufgabe in den Chat. Die KI baut den Workflow, führt ihn nach Zeitplan aus, wird mit der Zeit schneller und repariert ihn bei Fehlern. Kostenlos starten.",
    heading: "KI erstellt Ihre Automatisierungen und repariert sie.\nMit jedem Durchlauf werden sie klüger.",
    lead: "Schreiben Sie „Lade die Rechnungen vom Lieferantenportal herunter und trage sie in Excel ein“ in den Chat. Kitewell baut den Workflow und führt ihn werktags um 9 Uhr aus.",
    watch: `Film ansehen (${cut.seconds} Sek.)`,
    setup: "Einrichtungsanleitung lesen →",
    build: "Kostenlos starten",
    platform: "Kitewell Cloud läuft direkt im Browser ohne Installation und startet kostenlos ohne Kreditkarte. Für Desktop-Programme und lokale Dateien auf Ihrem Rechner nutzen Sie die App für Mac oder Windows.",
    proofTabs: ["Websites", "Desktop-Apps"],
    proof: [
      "Echte Aufnahme, beschleunigt: Im Chat von Kitewell wird darum gebeten, an jedem Werktag die neuen Rechnungen aus dem Portal eines Lieferanten in eine Excel-Datei einzutragen. Die KI öffnet das Ersatzportal in einem Browser, der im Chat zu sehen ist, lässt die Person das Passwort in eine Karte eingeben, meldet sich an, probiert ihren Entwurf aus und schlägt den Workflow vor. Nach dem Übernehmen und Ausführen wartet die Ausführung mit den gefundenen Rechnungen, bis eine Antwort sie in die Arbeitsmappe eintragen lässt.",
      "Echte Aufnahme, doppelt beschleunigt: Kitewell erfasst Aufträge aus Excel über den Bildschirm in Depot, einer Ersatz-Vertriebsanwendung ohne Import und ohne API. Zu sehen sind der zweite und der dritte Auftrag, die wiederholen, was die KI beim ersten gelernt hat.",
    ],
    proofNote: "Echte Bildschirmaufnahmen auf Demo-Websites und -Programmen, beschleunigt abgespielt.",
    versus: {
      title: "Lernt wie ein Agent.\nWiederholt wie ein Skript.",
      change: "Website ändert sich",
      lanes: [
        ["KI-Agenten", "KI plant jeden Klick pro Lauf neu. Langsam, teuer und schwankend."],
        ["Klassisches RPA", "Schnell und präzise, bis eine Website-Änderung den Bot stoppt."],
        ["Kitewell", "KI baut und repariert den Ablauf. Bekannte Schritte laufen schnell."],
      ],
      build: "Aufbau",
      fix: "Reparatur",
      stop: "Gestoppt",
      legend: ["KI-Denkzeit und Urteil", "Gelernte Klicks und Eingaben", "Balkenhöhe = Dauer pro Lauf"],
      measured: "Median aus je 20 Läufen eines 3-Schritt-Demo-Logins. KI-Auswahl pro Klick dauerte 7,9 Sek., Wiederholung mit Kitewell 1,8 Sek.",
    },
    reach: {
      title: "Bedient genau die Bildschirme, die Ihr Team bereits nutzt.",
      items: [
        ["Websites", "Auch hinter einem Login. Die KI sieht nie das Passwort.", "/docs/browser/"],
        ["Desktop-Apps", "Auch ohne API. Mit der Mac- oder Windows-App.", "/docs/desktop/"],
        ["Excel", "Zeile für Zeile, jedes Ergebnis neben seiner Zeile.", "/docs/spreadsheets/"],
        ["E-Mail", "Microsoft 365, Gmail und andere Postfächer.", "/docs/email/"],
      ],
      start: "Läuft nach Zeitplan oder auf Zuruf über ChatGPT oder Claude auf Ihrem Smartphone.",
    },
    price: {
      title: "Starten Sie noch heute kostenlos.",
      plans: [
        ["Kitewell Cloud", "1.000 Minuten kostenlos", "Ihre ersten 1.000 Minuten, einmalig. Keine Karte nötig, nichts zu installieren. Danach 0,007 $ pro Minute."],
        ["Personal (Mac oder Windows)", "20 $ pro Monat", "Beginnt mit einer 14-tägigen kostenlosen Testphase. Funktioniert mit Desktop-Apps und lokalen Dateien."],
      ],
      fine: "Preise in USD, exklusive Steuern.",
      trust: [
        ["Die Entwickler in Slack fragen →", "/community/"],
        ["30-minütiges Gespräch buchen ↗", "https://calendly.com/yota-hamada-descarty/30min"],
        ["Jede Woche neu. Aktuell: Kitewell {version} →", "/releases/"],
      ],
    },
  },
}[locale];
const to = (path: string) => localize(path, locale);
// The latest release is named only when one is published.
const trust = text.price.trust
  .filter(([label]) => release || !label.includes("{version}"))
  .map(([label, href]) => [label.replace("{version}", release?.version ?? ""), href.startsWith("/") ? to(href) : href]);
// Each line of a headline is a block of its own, so a line that wraps on a
// phone splits evenly instead of leaving its last word alone.
const breaks = (value: string) =>
  value
    .split("\n")
    .map((line) => `<span>${line}</span>`)
    .join("");
// The diagram runs one chore nine times in each lane: an AI agent, RPA, and
// Kitewell. A run is its height, as a share of the slowest, and the part of
// it the AI spends thinking; a stopped run is null. The site changes before
// the sixth run, where home.css draws its line. Heights follow the measured
// sign-in: replay takes about a quarter of the time AI does.
const runs: ([number, number] | null)[][] = [
  [[86, 86], [100, 100], [78, 78], [94, 94], [88, 88], [92, 92], [80, 80], [97, 97], [84, 84]],
  [[18, 0], [18, 0], [18, 0], [18, 0], [18, 0], null, null, null, [18, 0]],
  [[100, 100], [22, 4], [22, 4], [22, 4], [22, 4], [56, 40], [22, 4], [22, 4], [22, 4]],
];
// Callouts by lane and run: Kitewell builds on its first run and fixes on
// the run where the site changed; RPA stops there.
const marks: Record<string, string> = { "1-5": text.versus.stop, "2-0": text.versus.build, "2-5": text.versus.fix };
// Search engines learn what the app is, what it costs, and what the film shows.
const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kitewell",
  operatingSystem: "macOS 13 or later, Windows 10 or later, web browser",
  applicationCategory: "BusinessApplication",
  description: text.description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const video = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: cut.label,
  description: text.description,
  thumbnailUrl: new URL(`/videos/${cut.name}.webp`, Astro.site).href,
  contentUrl: new URL(`/videos/${cut.name}.mp4`, Astro.site).href,
  uploadDate: cut.uploaded,
  duration: `PT${cut.seconds}S`,
};
---

<Site title={text.title} description={text.description} tone="ink">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(app)} />
    <script type="application/ld+json" set:html={JSON.stringify(video)} />
  </Fragment>
  <div class="home">
    <div class="band ink hero-band">
      <section class="intro wrap" aria-labelledby="hero-title">
        <h1 id="hero-title" set:html={breaks(text.heading)} />
        <p class="intro-lead">{text.lead}</p>
        <div class="intro-actions">
          <a class="button" href={cloudSignup}>{text.build}</a>
          {release ? (
            <DownloadButton locale={locale} place="hero" secondary />
          ) : (
            <a class="text-link" href={to("/docs/getting-started/")}>{text.setup}</a>
          )}
          <a class="text-link" href="#film">{text.watch}</a>
        </div>
        <p class="fine">{text.platform}</p>
        <figure class="intro-media">
          <div class="tabs" role="tablist" hidden data-tabs>
            {text.proofTabs.map((label, i) => (
              <button type="button" role="tab" id={`proof-tab-${i}`} aria-controls={`proof-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                {label}
              </button>
            ))}
          </div>
          {proofs.map((name, i) => (
            <div class="tab-panel frame" id={`proof-panel-${i}`} role="tabpanel" aria-labelledby={`proof-tab-${i}`}>
              <Clip locale={locale} src={`/videos/proof/${name}-${recording(locale)}`} width={1920} height={1200} label={text.proof[i]} />
            </div>
          ))}
          <figcaption>{text.proofNote}</figcaption>
        </figure>
      </section>
    </div>

    <section class="band" id="versus" aria-labelledby="versus-title">
      <div class="wrap">
        <h2 id="versus-title" class="band-title" set:html={breaks(text.versus.title)} />
        <figure class="runs" data-reveal>
          <div class="runs-head" aria-hidden="true">
            <span>{text.versus.change}</span>
          </div>
          {text.versus.lanes.map(([name, caption], lane) => (
            <div class:list={["lane", { ours: lane === 2 }]} style={`--lane: ${lane}`}>
              <div class="lane-text">
                <h3>{name}</h3>
                <p>{caption}</p>
              </div>
              <ol class="lane-runs" aria-hidden="true">
                {runs[lane].map((run, i) => (
                  <li style={`--i: ${i}`}>
                    {run ? (
                      <span class="bar" style={`--h: ${run[0]}%; --ai: ${Math.round((run[1] / run[0]) * 100)}%`} />
                    ) : (
                      <span class="bar stopped" style="--h: 18%" />
                    )}
                    {marks[`${lane}-${i}`] && <em style={`--h: ${run?.[0] ?? 18}%`}>{marks[`${lane}-${i}`]}</em>}
                  </li>
                ))}
              </ol>
            </div>
          ))}
          <figcaption class="runs-legend">
            <span><i class="key ai" />{text.versus.legend[0]}</span>
            <span><i class="key learned" />{text.versus.legend[1]}</span>
            <span>{text.versus.legend[2]}</span>
          </figcaption>
        </figure>
        <p class="runs-measured">{text.versus.measured}</p>
      </div>
    </section>

    <section class="band" id="reach" aria-labelledby="reach-title">
      <div class="wrap">
        <h2 id="reach-title" class="band-title small">{text.reach.title}</h2>
        <ul class="reach-list">
          {text.reach.items.map(([name, detail, href]) => (
            <li>
              <a href={to(href)}>
                <h3>{name}</h3>
                <p>{detail}</p>
              </a>
            </li>
          ))}
        </ul>
        <p class="reach-start">{text.reach.start}</p>
      </div>
    </section>

    <section class="band sunk film-band" id="film" aria-label={cut.label}>
      <figure class="wrap">
        <div class="frame">
          <video
            controls
            playsinline
            preload="metadata"
            poster={versioned(`/videos/${cut.name}.webp`)}
            width="1920"
            height="1080"
            aria-label={cut.label}
            aria-describedby="film-caption"
            data-film
          >
            <source src={versioned(`/videos/${cut.name}.mp4`)} type="video/mp4" />
            {cut.tracks.map(([kind, lang, label]) => (
              <track kind={kind} src={versioned(`/videos/${cut.name}.${lang}.vtt`)} srclang={lang} label={label} />
            ))}
            <p><a href={versioned(`/videos/${cut.name}.mp4`)}>{cut.link}</a></p>
          </video>
        </div>
        <figcaption id="film-caption">
          <span>{cut.caption[0]}</span>
          <span>{cut.caption[1]}</span>
        </figcaption>
      </figure>
      <details class="film-transcript wrap">
        <summary>{cut.transcript}</summary>
        <div>
          {cut.scenes.map(([caption, scene]) => (
            <p>
              <strong>{caption}</strong> {scene}
            </p>
          ))}
        </div>
      </details>
    </section>

    <section class="band ink price-band" aria-labelledby="price-title">
      <div class="wrap">
        <h2 id="price-title" class="band-title">{text.price.title}</h2>
        <div class="plans">
          {text.price.plans.map(([name, amount, detail]) => (
            <div>
              <p class="plan-name">{name}</p>
              <p class="plan-amount">{amount}</p>
              <p class="plan-detail">{detail}</p>
            </div>
          ))}
        </div>
        <div class="price-actions">
          <a class="button" href={cloudSignup}>{text.build}</a>
          <DownloadButton locale={locale} place="closing" secondary />
        </div>
        <p class="price-fine">{text.price.fine}</p>
        <ul class="trust">
          {trust.map(([label, href]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Site>

<script>
  // Rows and steps settle into place as they come into view. Without the
  // script, or with reduced motion asked for, they are shown as they are.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("in");
          seen.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -12% 0px" },
    );
    document.documentElement.classList.add("reveal");
    for (const el of document.querySelectorAll("[data-reveal]")) seen.observe(el);
  }
  // Tabs show one panel at a time; without the script every panel stays
  // visible, one after the other.
  for (const list of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (chosen: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === chosen;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        document.getElementById(tab.getAttribute("aria-controls")!)!.hidden = !on;
      }
    };
    list.hidden = false;
    select(tabs[0]);
    // A tab chosen at the edge of a row that scrolls, as on a phone, comes
    // fully into view.
    const reveal = (tab: HTMLButtonElement) => tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    list.addEventListener("click", (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>("[role=tab]");
      if (!tab) return;
      select(tab);
      reveal(tab);
    });
    list.addEventListener("keydown", (event) => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (index < 0 || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
      const next = tabs[(index + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
      select(next);
      next.focus();
      reveal(next);
    });
  }
</script>
