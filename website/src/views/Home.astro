            </div>
          </div>
          <figcaption>{text.fleet.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="block wrap" id="own" aria-labelledby="own-title">
      <p class="eyebrow">{text.own}</p>
      <h2 id="own-title" class="block-title">{text.ownTitle}</h2>
      <dl class="own-facts">
        {text.ownRows.map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={to("/docs/data-flow/")}>{text.ownLink}</a>
    </section>

    <section class="block wrap" id="examples" aria-labelledby="examples-title">
      <p class="eyebrow">{text.examples}</p>
      <h2 id="examples-title" class="block-title">{text.examplesTitle}</h2>
      <div class="tabs" role="tablist" hidden data-tabs>
        {text.exampleTabs.map((label, i) => (
          <button type="button" role="tab" id={`examples-tab-${i}`} aria-controls={`examples-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            {label}
          </button>
        ))}
      </div>
      <div class="tab-panel" id="examples-panel-0" role="tabpanel" aria-labelledby="examples-tab-0">
        <ChoreList locale={locale} chores={everyday} />
      </div>
      <div class="tab-panel" id="examples-panel-1" role="tabpanel" aria-labelledby="examples-tab-1">
