---
import Site from "../layouts/Site.astro";
import { readManifest } from "../lib/releases.mjs";
import { descartyUrl } from "../lib/descarty.mjs";
import { localize } from "../lib/i18n.mjs";
import ChoreList from "../components/ChoreList.astro";
import { choreBySlug } from "../lib/chores.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
const release = await readManifest();
const text = {
  en: {
    title: "AI automation that runs on your own computer",
    description:
      "Kitewell automates websites, desktop apps, email, scripts, and coding agents on your Mac or PC, with schedules, approvals, and a log of every run. Free for one project.",
    eyebrow: release ? `Version ${release.version}` : "Coming soon",
    heading: "AI automation that runs on your own computer.",
    lead: "Kitewell automates websites, desktop apps, email, scripts, and coding agents on your Mac or PC. Every workflow runs on a schedule, waits for your approval where you say so, and keeps a log of every step. Your credentials and data stay on your machine.",
    primary: release ? "Download Kitewell" : "See what it can do",
    setup: "Read the setup guide →",
    platform: "macOS 13+ · Windows 10+ · Free for one project · No account needed",
    automate: "What it automates",
    automateTitle: "The work that happens on your computer.",
    automateText: "Each of these is a step you add from the task picker. Mix them in one workflow, and start it by hand, on a schedule, or when GitHub, Stripe, or a form sends it a webhook.",
    kinds: [
      ["Websites", "Open pages, click, type, and collect information in your own Chrome, from instructions in plain words. Saved sign-ins stay on the device.", "/docs/browser/"],
      ["Desktop apps", "A model reads the screen and uses the mouse and keyboard, on macOS or Windows, for the app that has no API.", "/docs/desktop/"],
      ["Email", "Find, organize, and send email in Gmail, Microsoft 365, or any IMAP mailbox connected on this computer.", "/docs/email/"],
      ["Excel workbooks", "Read, check, and write the .xlsx files your office already has, without starting Excel or occupying the screen.", "/docs/spreadsheets/"],
      ["Scripts, containers, servers, and APIs", "Commands and scripts, Docker images, SSH to your servers, and operations from any OpenAPI spec.", "/docs/workflow-builder/"],
      ["Coding agents on a schedule", "Claude Code, Codex, Gemini, and 13 more run as steps, with the sign-in you already have.", "/docs/ai/"],
    ],
    build: "Build it by asking",
    buildTitle: "Describe the workflow. Review the diff. Apply.",
    buildText:
      "The assistant (⌘J) proposes a new or changed workflow as a card with a graph preview; nothing is saved until you apply it. Connect Claude Code or Codex through MCP and build, run, and fix workflows from that conversation instead. From ChatGPT or Claude, on any device, even your phone, ask it to start a workflow, check why one failed, or approve the step waiting for you. The work still runs on your computer.",
    buildLinks: [
      ["The assistant →", "/docs/ai/#the-assistant"],
      ["MCP and API access →", "/docs/mcp/"],
    ],
    buildAlt: "A workflow the assistant proposed, with Edit in editor, Reject, and Apply buttons",
    control: "Keep control",
    controlTitle: "Approve what matters. See what happened.",
    controlItems: [
      ["Approval gates and human tasks", "A run pauses where you put a gate and continues when you approve, with the decision recorded."],
      ["Test one step", "Run a single step with real inputs before saving the workflow."],
      ["Replay", "Website and desktop actions that worked replay without the model on later runs: faster, and free."],
      ["Runs and logs", "Every run keeps each step's output, errors, screenshots, and files on your computer; retry from the failed step."],
    ],
    controlLink: "Runs and logs →",
    controlAlt: "A completed daily report workflow in Kitewell, with the report visible in the selected step's output",
    knowledge: "Knowledge",
    knowledgeTitle: "Tell it once, and it's in the handover notes.",
    knowledgeText:
      "A workflow's steps never say who uses its result, why it was built that way, or what broke last time. The assistant writes that down in knowledge pages as you work and reads them before it answers, so the next conversation, and the next person to take over, start from what your team already knows.",
    knowledgeItems: [
      ["Written as you work", "Tell the assistant a fact, a rule, or a fix, and it updates the right page and marks the lines it changed, with Undo. After it reads a web page or a log, it asks first."],
      ["Edited like a document", "Headings, checklists, and tables from the toolbar, “/”, or Markdown shortcuts. Pages save as you type."],
      ["Shared with the project", "Pages sync with your team, travel in project exports, and fill in the robot ledger."],
    ],
    knowledgeLink: "How knowledge works →",
    knowledgeAlt: "A knowledge page the assistant just updated: the line it added about a one-time code is marked, with Undo and Keep, beside the assistant's receipt and reply",
    sheets: "Excel",
    sheetsTitle: "The work starts in a workbook. It ends in the same one.",
    sheetsText:
      "Open the order list you already have, say what should happen for each row, and Kitewell runs your workflow once per row and writes each result back beside it. No last-row formula, no hand-built loop, no robot PC with Excel open on an unlocked screen.",
    sheetsItems: [
      ["Your file, as it is", "Title rows, merged headers, subtotals, full-width digits, 和暦 dates, postal codes with leading zeros. Nobody reshapes a file for the robot."],
      ["Every row accounted for", "Before anything runs you see which rows will run, and why each other one will not. A result never lands on the wrong row, even after you sort in Excel."],
