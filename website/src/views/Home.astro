        <p class="band-lead">{text.tuning.lead}</p>
        <ol class="sequence" data-reveal>
          {text.tuning.steps.map(([name, detail]) => (
            <li>
              <h3>{name}</h3>
              <p>{detail}</p>
            </li>
          ))}
