---
import { Image } from "astro:assets";
import Site from "../layouts/Site.astro";
import ChoreList from "../components/ChoreList.astro";
import Clip from "../components/Clip.astro";
import DownloadButton from "../components/DownloadButton.astro";
import { readReleases } from "../lib/releases.mjs";
import { descartyUrl } from "../lib/descarty.mjs";
import { languages, localize, recording, type Locale } from "../lib/i18n.mjs";
import { choreBySlug } from "../lib/chores.mjs";
import { hero, stills } from "../lib/hero.mjs";
import { daguStars } from "../lib/proof.mjs";
import "../styles/home.css";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { macos } = await readReleases();
// The figures beside the loop are the captured runs' own
// (src/data/hero-runs.json); none is typed here.
const run = hero[recording(locale)];
const ai = (r: { withoutAI: { count: number; total: number } }) => r.withoutAI.total - r.withoutAI.count;
const stars = daguStars.toLocaleString(languages[locale].format);
const text = {
  en: {
    title: "AI browser and desktop automation that repeats, for Mac and Windows",
    description:
      "Describe a computer chore once and AI does it every day. Kitewell's AI does it once while you watch, then repeats the same clicks on your schedule; when a site changes, AI fixes just the step that broke. Free for up to 10 workflows on Mac and Windows.",
    eyebrow: "Repeatable computer use on Mac and Windows",
    heading: "Describe a computer chore once.\nAI does it every day.",
    lead: "Type the chore in plain words. Kitewell's AI does it once in a browser or desktop app while you watch, then Kitewell repeats the same clicks on your schedule. When a site changes, AI fixes just the step that broke.",
    offer: "Public beta for Mac and Windows. Free for up to 10 workflows, with AI included when you sign in for free.",
    trust: `From the makers of Dagu, the open-source workflow engine with ${stars}+ GitHub stars`,
    notarized: "Signed and notarized by Apple",
    passwords: "Passwords stay on your computer, never shown to the AI",
    loop: "Kitewell building a weekday invoice chore in its chat, then the runs after it: the next run repeats every click, the supplier's sign-in page changes and AI fixes just that click, and the new invoice lands in the spreadsheet.",
    caption: "Real runs, sped up. The run records and the sheet show exactly what those runs recorded. Harbor Supply is a sample portal made for this demo.",
    unedited: "Watch an unedited recording",
    uneditedLabel: "The unedited recording of Kitewell's chat building the invoice workflow and its first run, sped up evenly.",
    transcript: [
      "The first time, AI does the job while you watch: it signs in to the supplier's portal in the chat's browser and reads the invoices.",
      "Check it, then say go: the proposed workflow, weekdays at 9:00, is applied.",
      "Every weekday at 9:00, it repeats what worked: the next run replays every click.",
      "The site changed, and AI fixed just that click: the sign-in button moved, and only that click went back to AI.",
      "Today's new invoice is in your sheet.",
    ],
    examples: "Examples",
    examplesTitle: "What do you still do by hand?",
    examplesLink: "All examples →",
    learns: "How it works",
    learnsTitle: "Learns once. Repeats every day.",
    learnsLead:
      "An AI agent works the job out again on every run. A recorded macro repeats exactly, until a screen changes. Kitewell keeps what worked and asks AI only about what changed.",
    beats: [
      ["The first time, AI works it out", `First run with nothing recorded: ${run.cold.seconds} s`, `AI decided ${ai(run.cold)} of ${run.cold.withoutAI.total} operations`],
      ["Every run after, it repeats them", `Next run: ${run.replayed.seconds} s`, `${run.replayed.withoutAI.count} of ${run.replayed.withoutAI.total} operations without AI`],
      ["A site changes: AI fixes that click", `Fixed by AI: ${run.recovered.fixed}`, `${run.recovered.withoutAI.count} of ${run.recovered.withoutAI.total} operations without AI`],
    ],
    beatAlt: [
      "Kitewell's chat with its browser signed in to the supplier portal",
      "A run's browser step with each click marked Replayed",
      "A run's browser step with the sign-in click marked Recovered",
    ],
    reading: "Reading what's on a page, such as the new invoices, asks AI on every run.",
    measured: "Real runs on this computer against a sample portal, with DeepSeek V4 Flash, the model behind Kitewell's included AI.",
    compare: "How Kitewell compares →",
    where: "Beyond the browser",
    whereTitle: "Works where your chores are.",
    tiles: [
      ["Websites", "Behind a sign-in, with passwords kept on your computer.", "/docs/browser/"],
      ["Desktop apps", "Apps with no API, with your own AI key or the included AI on a paid plan.", "/docs/desktop/"],
      ["Excel", "Once per row of the workbook you already have, each result written back beside it.", "/docs/spreadsheets/"],
      ["Email", "Find, read, file, and send mail in Microsoft 365, Gmail, or any IMAP mailbox.", "/docs/email/"],
      ["On schedule, with your OK", "Weekdays at 9, on a webhook, or on request. Approve a step from your phone.", "/docs/scheduling/"],
      ["Coding agents", "Claude Code, Codex, and 13 more, on your schedule and behind your approval.", "/coding-agents/"],
    ],
    safe: "Safe to hand over",
    safeTitle: "Your computer, your sign-ins, your say.",
    safeRows: [
      ["Runs on your computer", "Sign-ins stay in Kitewell's own browser profile on your Mac or PC. The page text a step reads goes to the AI provider you choose."],
      ["Passwords stay out of the model", "A step names a password, and Kitewell types it from the computer's secrets. The model only ever sees the name."],
      ["Nothing goes out until you say", "A draft is tried without sending anything, and a step can wait for your OK before it adds, sends, or pushes."],
      ["Every run on record", "Each run shows what it repeated, what AI fixed, and screenshots of the page."],
    ],
    safeLink: "What leaves your computer, and when →",
    company: "For your company",
    companyTitle: "Start on your computer. Run it where your company needs.",
    companyRows: [
      ["Your cloud or closed network", "The same workflows run on a VM in your company's Azure, AWS, or Google Cloud, or on servers in a closed network, with nobody signed in."],
      ["Your company's AI", "Use your Azure OpenAI, Amazon Bedrock, Google Vertex AI, or an in-house model, chosen step by step."],
      ["Part of your systems", "Your systems start a workflow by webhook or REST API, and the result goes back to them. People step in only to approve."],
      ["Built into your product", "Build Kitewell into your own product and offer it under your brand."],
    ],
    companyLink: "Deployment options at Descarty ↗",
    pricing: "Pricing",
    pricingTitle: "Free for up to 10 workflows.",
    pricingText:
      "Sign in for 100 free AI credits with no API key, or use your own key. Personal adds alerts, webhooks, and more projects for $20 a month (USD, excluding tax).",
    plans: "Compare plans →",
    enterprise: "Larger rollouts with support: Descarty ↗",
  },
  ja: {
    title: "くり返せる AI のブラウザー・デスクトップ自動化（Mac / Windows）",
    description:
      "パソコン作業を一度伝えれば、AI が毎日やってくれる。Kitewell の AI が目の前で一度やってみせ、そのあとは同じ操作を決まった時間にくり返します。サイトが変わったら、AI が変わった手順だけを直します。Mac と Windows で 10 ワークフローまで無料。",
    eyebrow: "くり返せる AI のパソコン操作（Mac と Windows）",
    heading: "パソコン作業を一度伝えれば、\nAI が毎日やってくれる。",
    lead: "やってほしい作業を、ふだんの言葉で入力するだけ。Kitewell の AI がブラウザーやアプリで目の前で一度やってみせ、そのあとは同じ操作を決まった時間にくり返します。サイトが変わったら、AI が変わった手順だけを直します。",
    offer: "Mac と Windows のパブリックベータ。10 ワークフローまで無料で、無料のサインインで AI も使えます。",
    trust: `オープンソースのワークフローエンジン Dagu（GitHub スター ${stars} 以上）の開発元から`,
    notarized: "Apple の署名と公証済み",
    passwords: "パスワードはパソコンに残り、AI には見せません",
    loop: "Kitewell がチャットで平日の請求書の作業をつくり、その後の実行を見せる映像。次の実行はすべてのクリックをくり返し、仕入先のログイン画面が変わると AI がそのクリックだけを直し、新しい請求書がシートに入ります。",
    caption: "実際の実行を早送りしています。実行の記録とシートは、その実行が記録した内容そのままです。みなと資材は、この映像のためのサンプルのポータルです。",
    unedited: "編集なしの録画を見る",
    uneditedLabel: "Kitewell のチャットが請求書のワークフローをつくり、最初に実行するまでの編集なしの録画。一定の速さで早送りしています。",
    transcript: [
      "最初の一回は、AI が目の前で作業します。チャットのブラウザーで仕入先のポータルにログインし、請求書を読み取ります。",
      "確かめて、OK するだけ。提案された平日 9:00 のワークフローを適用します。",
      "平日の 9:00 に、うまくいった操作をくり返します。次の実行はすべてのクリックを再生します。",
      "サイトが変わっても、AI がその操作だけを直します。ログインボタンが動き、そのクリックだけを AI が見つけ直しました。",
      "今日の新しい請求書が、シートに入りました。",
    ],
    examples: "活用例",
    examplesTitle: "まだ、手でやっていますか。",
    examplesLink: "すべての活用例 →",
    learns: "しくみ",
    learnsTitle: "一度覚えて、毎日くり返す。",
    learnsLead:
      "AI エージェントは、実行のたびに作業を一から考え直します。記録したマクロは、画面が変わるまで同じことをくり返します。Kitewell は、うまくいった操作を覚え、変わったところだけを AI に任せます。",
    beats: [
      ["最初は、AI が考える", `記録のない最初の実行：${run.cold.seconds} 秒`, `${run.cold.withoutAI.total} 件中 ${ai(run.cold)} 件の操作を AI が判断`],
      ["次からは、その操作をくり返す", `次の実行：${run.replayed.seconds} 秒`, `${run.replayed.withoutAI.total} 件中 ${run.replayed.withoutAI.count} 件の操作を AI なしで実行`],
      ["サイトが変わったら、その操作だけ AI が直す", `AI が直した操作：${run.recovered.fixed}`, `${run.recovered.withoutAI.total} 件中 ${run.recovered.withoutAI.count} 件の操作を AI なしで実行`],
    ],
    beatAlt: [
      "仕入先ポータルにログインした Kitewell のチャットのブラウザー",
      "各クリックが「再生」と記録された実行のブラウザーステップ",
      "ログインのクリックが「復旧」と記録された実行のブラウザーステップ",
    ],
    reading: "新しい請求書のように、ページの内容を読み取る操作は、毎回 AI が行います。",
    measured: "サンプルのポータルに対する、このパソコンでの実際の実行です。モデルは Kitewell の付属 AI と同じ DeepSeek V4 Flash。",
    compare: "Kitewell と、ほかの選択肢 →",
    where: "ブラウザーの外も",
    whereTitle: "作業のある場所で動く。",
    tiles: [
      ["Web サイト", "ログインが必要なサイトも。パスワードはパソコンに残ります。", "/docs/browser/"],
      ["デスクトップアプリ", "API のないアプリも。自分の AI キー、または有料プランの付属 AI で。", "/docs/desktop/"],
      ["Excel", "いまのブックの 1 行ごとに実行し、結果を同じ行に書き戻します。", "/docs/spreadsheets/"],
      ["メール", "Microsoft 365、Gmail、任意の IMAP のメールを検索、整理、送信します。", "/docs/email/"],
      ["スケジュールと承認", "平日 9 時に、Webhook で、頼んだときに。承認はスマホから。", "/docs/scheduling/"],
      ["コーディングエージェント", "Claude Code、Codex ほか 13 種類を、あなたのスケジュールと承認で。", "/coding-agents/"],
    ],
    safe: "安心して任せる",
    safeTitle: "あなたのパソコン、あなたのログイン、あなたの判断。",
    safeRows: [
      ["あなたのパソコンで動く", "ログインは、Mac や PC 上の Kitewell 専用のブラウザープロファイルに残ります。ステップが読み取るページの文字は、選んだ AI の提供元に送られます。"],
      ["パスワードはモデルに見せない", "ステップにはパスワードの名前だけを書き、Kitewell がパソコンのシークレットから入力します。モデルに見えるのは名前だけです。"],
      ["OK するまで、外には出さない", "下書きは外部に何も送らずに試せます。追加、送信、プッシュの前に、あなたの OK を待つこともできます。"],
      ["すべての実行を記録", "実行ごとに、くり返した操作、AI が直した操作、ページのスクリーンショットが残ります。"],
    ],
    safeLink: "外に出るものと、そのタイミング →",
    company: "会社で使うなら",
    companyTitle: "あなたのパソコンから、会社の環境まで。",
    companyRows: [
      ["会社のクラウドや閉域網で", "同じワークフローを、会社の Azure、AWS、Google Cloud の VM や、閉域網のサーバーで、誰もサインインせずに動かせます。"],
      ["会社の AI で", "会社の Azure OpenAI、Amazon Bedrock、Google Vertex AI、社内のモデルを、ステップごとに選べます。"],
      ["システムの一部として", "会社のシステムから Webhook や REST API でワークフローを動かし、結果をシステムに返します。人が関わるのは承認だけです。"],
      ["製品に組み込んで", "Kitewell を自社の製品に組み込み、自社のブランドで提供できます。"],
    ],
    companyLink: "導入形態を見る（Descarty）↗",
    pricing: "料金",
    pricingTitle: "10 ワークフローまで無料。",
    pricingText:
      "サインインすれば、API キーなしで 100 クレジットの AI を無料で使えます。自分のキーも使えます。Personal は月額 3,000 円（税別）で、アラート、Webhook、プロジェクトを追加します。",
    plans: "プランを比べる →",
    enterprise: "支援付きの大規模な導入は Descarty へ ↗",
  },
}[locale];
const to = (path: string) => localize(path, locale);
const chores = ["portal-invoices", "excel-orders", "form-from-sheet", "price-watch", "desktop-data-entry", "inbox-digest"].map(choreBySlug);
const video = `/videos/hero/${run.video}`;
const lines = (value: string) => value.replace("\n", "<br>");
// Search engines learn what the app is, what it costs, and what the loop shows.
const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kitewell",
  operatingSystem: "macOS 13 or later, Windows 10 or later",
  applicationCategory: "BusinessApplication",
  description: text.description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const loop = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: text.heading.replace("\n", " "),
  description: text.loop,
  thumbnailUrl: new URL(`${video}.webp`, Astro.site).href,
  contentUrl: new URL(`${video}.mp4`, Astro.site).href,
  uploadDate: run.capturedAt,
  duration: "PT18S",
};
---

<Site title={text.title} description={text.description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${video}.webp`} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(app)} />
    <script type="application/ld+json" set:html={JSON.stringify(loop)} />
  </Fragment>
  <div class="home">
    <section class="intro split wrap" aria-labelledby="hero-title">
      <div class="intro-head">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1 id="hero-title" set:html={lines(text.heading)} />
        <p class="intro-lead">{text.lead}</p>
      </div>
      <div class="intro-cta">
        <div class="intro-actions">
          <DownloadButton locale={locale} place="hero" />
        </div>
        <p class="intro-offer">{text.offer}</p>
        <p class="fine intro-trust">
          <span>{text.passwords}</span>
          {macos && <span>{text.notarized}</span>}
          <a href="https://github.com/dagucloud/dagu">{text.trust}</a>
        </p>
      </div>
      <figure class="intro-media" id="film">
        <div class="frame square">
          <Clip locale={locale} src={video} phone width={1080} height={1080} label={text.loop} describedby="loop-transcript" />
        </div>
        <figcaption>{text.caption}</figcaption>
        <ol class="visually-hidden" id="loop-transcript">
          {text.transcript.map((line) => <li>{line}</li>)}
        </ol>
        <details class="unedited">
          <summary>{text.unedited}</summary>
          <div class="frame">
            <Clip locale={locale} src={`/videos/proof/websites-${recording(locale)}`} width={1920} height={1200} label={text.uneditedLabel} />
          </div>
        </details>
      </figure>
    </section>

    <section class="block wrap" id="examples" aria-labelledby="examples-title">
      <p class="eyebrow">{text.examples}</p>
      <h2 id="examples-title" class="block-title">{text.examplesTitle}</h2>
      <ChoreList locale={locale} chores={chores} />
      <a class="text-link" href={to("/examples/")}>{text.examplesLink}</a>
    </section>

    <section class="block wrap" id="how" aria-labelledby="how-title">
      <p class="eyebrow">{text.learns}</p>
      <h2 id="how-title" class="block-title">{text.learnsTitle}</h2>
      <p class="block-lead">{text.learnsLead}</p>
      <ol class="beats">
        {text.beats.map(([title, first, second], i) => (
          <li>
            <div class="frame">
              <Image src={stills[recording(locale)][i]} alt={text.beatAlt[i]} widths={[480, 960]} sizes="(max-width: 860px) 100vw, 380px" />
            </div>
            <h3>{title}</h3>
            <p>{first}</p>
            <p>{second}</p>
          </li>
        ))}
      </ol>
      <p class="beats-note">{text.reading}</p>
      <p class="fine">{text.measured}</p>
      <a class="text-link" href={to("/compare/")}>{text.compare}</a>
    </section>

    <section class="block wrap" id="automate" aria-labelledby="automate-title">
      <p class="eyebrow">{text.where}</p>
      <h2 id="automate-title" class="block-title">{text.whereTitle}</h2>
      <div class="tiles">
        {text.tiles.map(([name, detail, href]) => (
          <a class="tile" href={to(href)}>
            <h3>{name}</h3>
            <p>{detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="block wrap" id="own" aria-labelledby="own-title">
      <p class="eyebrow">{text.safe}</p>
      <h2 id="own-title" class="block-title">{text.safeTitle}</h2>
      <dl class="own-facts">
        {text.safeRows.map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={to("/docs/data-flow/")}>{text.safeLink}</a>
    </section>

    <section class="block wrap" id="company" aria-labelledby="company-title">
      <p class="eyebrow">{text.company}</p>
      <h2 id="company-title" class="block-title">{text.companyTitle}</h2>
      <dl class="own-facts">
        {text.companyRows.map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={descartyUrl(locale, "/deployment/")}>{text.companyLink}</a>
    </section>

    <section class="finale wrap" aria-labelledby="pricing-title">
      <div>
        <p class="eyebrow">{text.pricing}</p>
        <h2 id="pricing-title">{text.pricingTitle}</h2>
        <p class="block-lead">{text.pricingText}</p>
        <div class="links">
          <a class="text-link" href={to("/pricing/")}>{text.plans}</a>
          <a class="text-link" href={descartyUrl(locale, "/enterprise/")}>{text.enterprise}</a>
        </div>
      </div>
      <div class="finale-action">
        <DownloadButton locale={locale} place="closing" />
        <p class="fine">{text.offer}</p>
      </div>
    </section>
  </div>
</Site>
