        ))}
      </div>
    </section>

    <section class="block wrap" id="control" aria-labelledby="control-title">
      <p class="eyebrow">{text.control}</p>
      <h2 id="control-title" class="block-title">{text.controlTitle}</h2>
      <div class="pair wide-media">
        <figure class="frame">
          <Image src={shots.run} alt={text.controlAlt} widths={[720, 1440]} sizes="(max-width: 860px) 100vw, 640px" />
        </figure>
        <div>
          <div class="grid-two">
            {text.controlItems.map(([name, detail]) => (
              <div>
                <h3>{name}</h3>
                <p>{detail}</p>
