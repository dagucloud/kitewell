      "Ein KI-Agent erarbeitet die Aufgabe bei jeder Ausführung neu. Ein aufgezeichnetes Makro wiederholt alles exakt, bis sich ein Bildschirm ändert. Kitewell behält, was funktioniert hat, und fragt die KI nur zu dem, was sich geändert hat.",
    beats: [
      ["Beim ersten Mal findet die KI den Weg", `Erste Ausführung ohne Aufzeichnung: ${run.cold.seconds} s`, `Die KI hat ${ai(run.cold)} von ${run.cold.withoutAI.total} Aktionen entschieden`],
      ["Danach wiederholt Kitewell diesen Weg bei jeder Ausführung", `Nächste Ausführung: ${run.replayed.seconds} s`, `${run.replayed.withoutAI.count} von ${run.replayed.withoutAI.total} Aktionen ohne KI`],
      ["Eine Website ändert sich: Die KI behebt diesen Klick", `Von der KI behoben: ${run.recovered.fixed}`, `${run.recovered.withoutAI.count} von ${run.recovered.withoutAI.total} Aktionen ohne KI`],
    ],
    beatAlt: [
      "Der Chat von Kitewell, sein Browser beim Lieferantenportal angemeldet",
      "Der Browser-Schritt einer Ausführung, jeder Klick als „Wiederholt“ markiert",
      "Der Browser-Schritt einer Ausführung, der Anmeldeklick als „Wiederhergestellt“ markiert",
    ],
    reading: "Um den Inhalt einer Seite zu lesen, etwa die neuen Rechnungen, wird bei jeder Ausführung die KI gefragt.",
    measured: "Echte Ausführungen auf diesem Computer mit einem Beispielportal und DeepSeek V4 Flash, dem Modell hinter der enthaltenen KI von Kitewell.",
    compare: "Kitewell im Vergleich →",
    where: "Über den Browser hinaus",
    whereTitle: "Arbeitet dort, wo Ihre Aufgaben sind.",
    tiles: [
      ["Websites", "Auch hinter einer Anmeldung, die Passwörter bleiben auf Ihrem Computer.", "/docs/browser/"],
      ["Desktop-Apps", "Apps ohne API, mit Ihrem eigenen KI-Schlüssel oder der enthaltenen KI in einem kostenpflichtigen Tarif.", "/docs/desktop/"],
      ["Excel", "Einmal pro Zeile Ihrer vorhandenen Arbeitsmappe, jedes Ergebnis direkt daneben zurückgeschrieben.", "/docs/spreadsheets/"],
      ["E-Mail", "E-Mails in Microsoft 365, Gmail oder jedem IMAP-Postfach finden, lesen, ablegen und senden.", "/docs/email/"],
      ["Nach Plan, mit Ihrem OK", "Wochentags um 9:00, per Webhook oder auf Anfrage. Genehmigen Sie einen Schritt vom Smartphone aus.", "/docs/scheduling/"],
      ["Coding-Agenten", "Claude Code, Codex und 13 weitere, nach Ihrem Zeitplan und mit Ihrer Genehmigung.", "/coding-agents/"],
    ],
    safe: "Mit gutem Gefühl übergeben",
    safeTitle: "Ihr Computer, Ihre Anmeldungen, Ihre Entscheidung.",
    safeRows: [
      ["Läuft auf Ihrem Computer", "Anmeldungen bleiben im eigenen Browserprofil von Kitewell auf Ihrem Mac oder PC. Den Seitentext, den ein Schritt liest, erhält der KI-Anbieter Ihrer Wahl."],
      ["Passwörter bleiben dem Modell verborgen", "Ein Schritt nennt ein Passwort beim Namen, und Kitewell tippt es aus den Secrets des Computers ein. Das Modell sieht immer nur den Namen."],
      ["Nichts geht raus, bevor Sie zustimmen", "Ein Entwurf wird ausprobiert, ohne etwas zu senden, und ein Schritt kann auf Ihr OK warten, bevor er etwas hinzufügt, sendet oder pusht."],
      ["Jede Ausführung protokolliert", "Jede Ausführung zeigt, was sie wiederholt hat, was die KI behoben hat, und Bildschirmfotos der Seite."],
    ],
    safeLink: "Was Ihren Computer verlässt und wann →",
    runs: "Wo es läuft",
    runsTitle: "Auf Ihrem Computer oder in der Cloud.",
    places: [
      ["Ihr Computer", "", "Auf Mac und Windows, mit Ihren eigenen Anmeldungen. Sehen Sie zu, wie es arbeitet, und geben Sie Schritte vom Handy frei."],
      ["Kitewell Cloud", "Demnächst", "Läuft nach Zeitplan, auch wenn Ihr Computer zugeklappt ist. Workflows erstellen und korrigieren Sie im Browser oder auf dem Handy. Jedes Projekt bekommt eine eigene Maschine, die nur läuft, solange sie arbeitet."],
      ["Die Cloud Ihres Unternehmens", "Für Unternehmen", "Eine VM in Ihrer Azure-, AWS- oder Google-Cloud oder ein Server in einem geschlossenen Netz, ohne dass jemand angemeldet ist, mit der KI Ihres Unternehmens."],
    ],
    placesLink: "Pilotpartner bei Descarty ↗",
    pricing: "Preise",
    pricingTitle: "Kostenlos für bis zu 10 Workflows.",
    pricingText:
      "Melden Sie sich an und erhalten Sie 100 kostenlose KI-Credits ohne API-Schlüssel, oder nutzen Sie Ihren eigenen Schlüssel. Personal ergänzt Benachrichtigungen, Webhooks und mehr Projekte für 20 $ pro Monat (USD, zzgl. Steuern).",
    plans: "Tarife vergleichen →",
    enterprise: "Größere Einführungen mit Support: Descarty ↗",
  },
}[locale];
const to = (path: string) => localize(path, locale);
const chores = ["portal-invoices", "excel-orders", "form-from-sheet", "price-watch", "desktop-data-entry", "inbox-digest"].map(choreBySlug);
const video = `/videos/hero/${run.video}`;
const lines = (value: string) => value.replace("\n", "<br>");
// Search engines learn what the app is, what it costs, and what the loop shows.
const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kitewell",
  operatingSystem: "macOS 13 or later, Windows 10 or later",
  applicationCategory: "BusinessApplication",
  description: text.description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const loop = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: text.heading.replace("\n", " "),
  description: text.loop,
  thumbnailUrl: new URL(`${video}.webp`, Astro.site).href,
  contentUrl: new URL(`${video}.mp4`, Astro.site).href,
  uploadDate: run.capturedAt,
  duration: "PT18S",
};
---

<Site title={text.title} description={text.description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${video}.webp`} fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(app)} />
    <script type="application/ld+json" set:html={JSON.stringify(loop)} />
  </Fragment>
  <div class="home">
    <section class="intro split wrap" aria-labelledby="hero-title">
      <div class="intro-head">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1 id="hero-title" set:html={lines(text.heading)} />
        <p class="intro-lead">{text.lead}</p>
      </div>
      <div class="intro-cta">
        <div class="intro-actions">
          <DownloadButton locale={locale} place="hero" />
        </div>
        <p class="intro-offer">{text.offer}</p>
        <p class="fine intro-trust">
          <span>{text.passwords}</span>
          {macos && <span>{text.notarized}</span>}
          <a href="https://github.com/dagucloud/dagu">{text.trust}</a>
        </p>
      </div>
      <figure class="intro-media" id="film">
        <div class="frame square">
          <Clip locale={locale} src={video} phone width={1080} height={1080} label={text.loop} describedby="loop-transcript" />
        </div>
        <figcaption>{text.caption}</figcaption>
        <ol class="visually-hidden" id="loop-transcript">
          {text.transcript.map((line) => <li>{line}</li>)}
        </ol>
        <details class="unedited">
          <summary>{text.unedited}</summary>
          <div class="frame">
            <Clip locale={locale} src={`/videos/proof/websites-${recording(locale)}`} width={1920} height={1200} label={text.uneditedLabel} />
          </div>
        </details>
      </figure>
    </section>

    <section class="block wrap" id="examples" aria-labelledby="examples-title">
      <p class="eyebrow">{text.examples}</p>
      <h2 id="examples-title" class="block-title">{text.examplesTitle}</h2>
      <ChoreList locale={locale} chores={chores} />
      <a class="text-link" href={to("/examples/")}>{text.examplesLink}</a>
    </section>

    <section class="block wrap" id="how" aria-labelledby="how-title">
      <p class="eyebrow">{text.learns}</p>
      <h2 id="how-title" class="block-title">{text.learnsTitle}</h2>
      <p class="block-lead">{text.learnsLead}</p>
      <ol class="beats">
        {text.beats.map(([title, first, second], i) => (
          <li>
            <div class="frame">
              <Image src={stills[recording(locale)][i]} alt={text.beatAlt[i]} widths={[480, 960]} sizes="(max-width: 860px) 100vw, 380px" />
            </div>
            <h3>{title}</h3>
            <p>{first}</p>
            <p>{second}</p>
          </li>
        ))}
      </ol>
      <p class="beats-note">{text.reading}</p>
      <p class="fine">{text.measured}</p>
      <a class="text-link" href={to("/compare/")}>{text.compare}</a>
    </section>

    <section class="block wrap" id="automate" aria-labelledby="automate-title">
      <p class="eyebrow">{text.where}</p>
      <h2 id="automate-title" class="block-title">{text.whereTitle}</h2>
      <div class="tiles">
        {text.tiles.map(([name, detail, href]) => (
          <a class="tile" href={to(href)}>
            <h3>{name}</h3>
            <p>{detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="block wrap" id="own" aria-labelledby="own-title">
      <p class="eyebrow">{text.safe}</p>
      <h2 id="own-title" class="block-title">{text.safeTitle}</h2>
      <dl class="own-facts">
        {text.safeRows.map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={to("/docs/data-flow/")}>{text.safeLink}</a>
    </section>

    <section class="block wrap" id="where" aria-labelledby="where-title">
      <p class="eyebrow">{text.runs}</p>
      <h2 id="where-title" class="block-title">{text.runsTitle}</h2>
      <dl class="places">
        {text.places.map(([name, label, detail]) => (
          <div>
            <dt>
              {name}
              {label && <span class="place-label">{label}</span>}
            </dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={descartyUrl(locale, "/early-access/")}>{text.placesLink}</a>
    </section>

    <section class="finale wrap" aria-labelledby="pricing-title">
      <div>
        <p class="eyebrow">{text.pricing}</p>
        <h2 id="pricing-title">{text.pricingTitle}</h2>
        <p class="block-lead">{text.pricingText}</p>
        <div class="links">
          <a class="text-link" href={to("/pricing/")}>{text.plans}</a>
          <a class="text-link" href={descartyUrl(locale, "/early-access/")}>{text.enterprise}</a>
        </div>
      </div>
      <div class="finale-action">
        <DownloadButton locale={locale} place="closing" />
        <p class="fine">{text.offer}</p>
      </div>
    </section>
  </div>
</Site>
