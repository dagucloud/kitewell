    pricingTitle: "1 プロジェクトなら無料。",
    pricingText:
      "ワークフロー 10 個までの 1 プロジェクトは、Kitewell アカウントなしで使え、Web サイト、デスクトップ、メールの自動化も含まれます。Pro は 1 人あたり月額 $25（USD）で、各 100 ワークフローのプロジェクトを 10 個まで持て、アラートとチームでの同期が加わります。",
    compare: "プランを比較する →",
    availability: release ? "Kitewell をダウンロード" : "リリース状況を確認する",
    status: release ? "提供中" : "近日公開",
  },
}[locale];
const to = (path: string) => localize(path, locale);
const featured = ["inbox-digest", "invoice-intake", "nightly-dependency-update", "price-watch", "desktop-app-entry", "company-research-sheet"]
  .map((slug) => examples.find((example) => example.slug === slug)!)
  .map((example) => ({ slug: example.slug, ...example[locale] }));
// The English approval shot carries English demo data; the other shots do in both languages.
const images = {
  proposal: `/images/home/${locale}/assistant-proposal.png`,
  approval: locale === "ja" ? "/images/home/ja/run-approval.png" : "/images/workflow-run.jpg",
  knowledge: `/images/home/${locale}/knowledge.png`,
  sheets: `/images/home/${locale}/sheets.png`,
};
const approvalSize = locale === "ja" ? [1600, 720] : [1345, 886];
const proposalWidth = locale === "ja" ? 716 : 752;
// Each language has its own cut of the film, captioned in that language and
// subtitled in the other.
const film = locale === "ja" ? "kitewell-launch-ja" : "kitewell-launch";
const filmTracks: [string, string, string][] =
  locale === "ja"
    ? [
        ["captions", "ja", "日本語"],
        ["subtitles", "en", "English"],
      ]
    : [
        ["captions", "en", "English"],
        ["subtitles", "ja", "日本語"],
      ];
---

<Site title={text.title} description={text.description}>
  <div class="wrap home">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow dot">{text.eyebrow}</p>
      <h1 id="hero-title" set:html={text.heading.replace("\n", "<br>")} />
      <p class="lead">{text.lead}</p>
      <div class="actions">
        <a class="button" href={release ? to("/download/") : "#automate"}>
          {text.primary}
          <span aria-hidden="true">{release ? "↗" : "↓"}</span>
        </a>
        <a class="text-link" href={to("/docs/getting-started/")}>
          {text.setup}
        </a>
      </div>
      <p class="fine">{text.platform}</p>
    </section>

    <section class="promo" id="film" aria-label={text.filmLabel}>
      <figure class="promo-film">
        <video
          controls
          playsinline
          preload="metadata"
          poster={`/videos/${film}.webp`}
          width="1920"
          height="1080"
          aria-label={text.filmLabel}
          aria-describedby="film-caption"
        >
          <source src={`/videos/${film}.mp4`} type="video/mp4" />
          {filmTracks.map(([kind, lang, label]) => (
            <track kind={kind} src={`/videos/${film}.${lang}.vtt`} srclang={lang} label={label} />
          ))}
          <p><a href={`/videos/${film}.mp4`}>{text.filmLink}</a></p>
        </video>
        <figcaption id="film-caption">
          <span>{text.filmCaption[0]}</span>
          <span>{text.filmCaption[1]}</span>
        </figcaption>
      </figure>
      <details class="promo-transcript">
        <summary>{text.transcript}</summary>
        <div>
          {text.scenes.map(([caption, scene]) => (
            <p>
              <strong>{caption}</strong> {scene}
            </p>
          ))}
        </div>
      </details>
    </section>

    <section class="section automate" id="automate" aria-labelledby="automate-title">
      <p class="eyebrow">{text.automate}</p>
      <h2 id="automate-title">{text.automateTitle}</h2>
      <p class="section-lead">{text.automateText}</p>
      <div class="kinds">
        {text.kinds.map(([name, detail, href]) => (
          <a class="kind" href={to(href)}>
            <strong>{name}</strong>
            <span>{detail}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section split" aria-labelledby="sheets-title">
      <div>
        <p class="eyebrow">{text.sheets}</p>
        <h2 id="sheets-title">{text.sheetsTitle}</h2>
        <p class="section-lead">{text.sheetsText}</p>
        <ol class="example-steps">
          {text.sheetsItems.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))}
        </ol>
        <a class="text-link" href={to("/docs/spreadsheets/")}>{text.sheetsLink}</a>
      </div>
      <figure class="product-preview">
        <img src={images.sheets} alt={text.sheetsAlt} width="1600" height="1150" loading="lazy" />
      </figure>
    </section>

    <section class="section split" aria-labelledby="build-title">
      <div>
        <p class="eyebrow">{text.build}</p>
        <h2 id="build-title">{text.buildTitle}</h2>
        <p class="section-lead">{text.buildText}</p>
        <div class="actions">
          {text.buildLinks.map(([label, href]) => (
            <a class="text-link" href={to(href)}>{label}</a>
          ))}
        </div>
      </div>
      <figure class="product-preview shot-tall">
        <img src={images.proposal} alt={text.buildAlt} width={proposalWidth} height="900" loading="lazy" />
      </figure>
    </section>

    <section class="section split" aria-labelledby="control-title">
      <figure class="product-preview">
        <img src={images.approval} alt={text.controlAlt} width={approvalSize[0]} height={approvalSize[1]} loading="lazy" />
      </figure>
      <div>
        <p class="eyebrow">{text.control}</p>
        <h2 id="control-title">{text.controlTitle}</h2>
        <ol class="example-steps">
          {text.controlItems.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))}
        </ol>
        <a class="text-link" href={to("/docs/runs/")}>{text.controlLink}</a>
      </div>
    </section>

    <section class="section split" aria-labelledby="knowledge-title">
      <div>
        <p class="eyebrow">{text.knowledge}</p>
        <h2 id="knowledge-title">{text.knowledgeTitle}</h2>
        <p class="section-lead">{text.knowledgeText}</p>
        <ol class="example-steps">
          {text.knowledgeItems.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))}
        </ol>
        <a class="text-link" href={to("/docs/knowledge/")}>{text.knowledgeLink}</a>
      </div>
      <figure class="product-preview">
        <img src={images.knowledge} alt={text.knowledgeAlt} width="1600" height="874" loading="lazy" />
      </figure>
    </section>

    <section class="section machine" aria-labelledby="machine-title">
      <p class="eyebrow">{text.machine}</p>
      <h2 id="machine-title">{text.machineTitle}</h2>
      <dl class="facts">
        {text.machineRows.map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={to("/docs/data-flow/")}>{text.machineLink}</a>
    </section>

    <section class="section" aria-labelledby="examples-title">
      <p class="eyebrow">{text.examplesEyebrow}</p>
      <h2 id="examples-title">{text.examplesTitle}</h2>
      <div class="cards examples">
        {featured.map((example) => (
          <article class="card">
            <h3>
              <a href={to(`/examples/${example.slug}/`)}>{example.title}</a>
            </h3>
            <p>{example.summary}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href={to("/examples/")}>{text.examplesLink}</a>
    </section>

    <aside class="connections" aria-label={text.team}>
      <p>
        <strong>{text.teamTitle}</strong> {text.teamText}
      </p>
      <div>
        {text.teamLinks.map(([label, href]) => (
          <a class="text-link" href={to(href)}>{label}</a>
        ))}
        <a class="text-link" href={descartyUrl(locale, "/enterprise/")}>{text.enterprise}</a>
      </div>
    </aside>

    <section class="closing" aria-labelledby="pricing-title">
      <div>
        <p class="eyebrow">{text.pricing}</p>
        <h2 id="pricing-title">{text.pricingTitle}</h2>
        <p>
          {text.pricingText}{" "}
          <a href={to("/pricing/")}>{text.compare}</a>
        </p>
      </div>
      <div class="availability">
        <a class="button" href={to("/download/")}>
          {text.availability}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="fine">{text.status} · macOS 13+ · Windows 10+</p>
      </div>
    </section>
  </div>
</Site>
