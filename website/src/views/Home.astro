      <div class="table-scroll">
        <table class="versus">
          <thead>
            <tr>
              <th scope="col">{text.rpaHead[0]}</th>
              <th scope="col">{text.rpaHead[1]}</th>
            </tr>
          </thead>
          <tbody>
            {text.rpaRows.map(([before, after]) => (
              <tr>
                <td>{before}</td>
                <td>{after}</td>
              </tr>
            ))}
