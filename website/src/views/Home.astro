    </section>

    <section class="block wrap" id="team" aria-labelledby="team-title">
      <p class="eyebrow">{text.team}</p>
      <h2 id="team-title" class="block-title">{text.teamTitle}</h2>
      <div class="pair">
        <div>
          <ul class="points">
            {text.teamItems.map(([name, detail]) => (
              <li>
