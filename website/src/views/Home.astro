import "../styles/home.css";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
// A release published for either system is enough to offer the download.
const { macos, windows } = await readReleases();
const release = macos ?? windows;
const cut = film[locale];
// The record in the browser block is a real English run, shown as
// Kitewell shows it in each language: its own badges, the run's own words.
const record = (labels: { open: string; act: string; check: string; collect: string; done: string; replayed: string; recovered: string }) => [
  [labels.open, "127.0.0.1:4320/billing/invoices", [labels.done]],
  [labels.act, "Type ops@example.com into the email field", [labels.replayed]],
  [labels.act, "Type %password% into the password field", [labels.replayed]],
  [labels.act, "Click Sign in", [labels.recovered]],
  [labels.check, 'text "Invoices"', [labels.done]],
  [labels.collect, "Every invoice issued since the last weekday", [labels.done]],
];
