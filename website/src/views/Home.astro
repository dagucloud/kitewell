    platform: "Mit Kitewell Cloud laufen Workflows in der Cloud, ohne Installation; Sie bedienen sie im Browser. Die ersten 1.000 Ausführungsminuten sind kostenlos, einmalig und ohne Kreditkarte. Für Desktop-Apps, Dateien auf Ihrem Computer oder Websites, die nur Ihr Büronetz erreicht, laden Sie die App für macOS 13+ oder Windows 10+ herunter (öffentliche Beta); Ihr erster Computer startet eine 14-tägige Testphase.",
    proofTabs: ["Websites", "Desktop-Apps"],
    proof: [
      "Echte Aufnahme, beschleunigt: Im Chat von Kitewell wird darum gebeten, an jedem Werktag die neuen Rechnungen aus dem Portal eines Lieferanten in eine Excel-Datei einzutragen. Die KI öffnet das Ersatzportal in einem Browser, der im Chat zu sehen ist, lässt die Person das Passwort in eine Karte eingeben, meldet sich an, probiert ihren Entwurf aus und schlägt den Workflow vor. Nach dem Übernehmen und Ausführen wartet die Ausführung mit den gefundenen Rechnungen, bis eine Antwort sie in die Arbeitsmappe eintragen lässt.",
      "Echte Aufnahme, doppelt beschleunigt: Kitewell erfasst Aufträge aus Excel über den Bildschirm in Depot, einer Ersatz-Vertriebsanwendung ohne Import und ohne API. Zu sehen sind der zweite und der dritte Auftrag, die wiederholen, was die KI beim ersten gelernt hat.",
    ],
    proofNote: "Echte Aufnahmen, ungeschnitten und gleichmäßig beschleunigt. Die erste zeigt das Chatfenster von Kitewell: eine einzige Anfrage in Alltagssprache, dann alles, was die KI und die App getan haben. Die zweite zeigt das Fenster der Vertriebsanwendung, während Kitewell die Aufträge erfasst. Ein Ersatzportal eines Lieferanten und eine Ersatz-Vertriebsanwendung.",
    ideas: {
      eyebrow: "Ideen",
      title: "Was würden Sie abgeben?",
      lead: "Alltägliche Handarbeit und was stattdessen ankommt, sobald Kitewell sie übernimmt. Fangen Sie mit einer an und ändern Sie, was Sie wollen.",
      link: "Mehr Ideen →",
      share: "Eigene gebaut? Zeigen Sie sie auf Slack →",
    },
    how: "So funktioniert es",
    steps: [
      ["Sie sagen es", "Ein Satz, in Ihren Worten. Die KI legt die Schritte vor, probiert sie in einem Browser aus, dem Sie zusehen können, und versendet nichts, bevor Sie loslegen sagen."],
      ["Es läuft", "Nach Zeitplan, per Webhook oder wenn Sie es vom Smartphone aus sagen. Wo Sie ein OK wollen, wartet es darauf."],
      ["Es bleibt dran", "Ändert sich eine Website, findet die KI den neuen Weg und behält ihn. Schlägt etwas fehl, sagt sie Ihnen in klaren Worten, warum."],
    ],
    fix: {
      eyebrow: "Wenn sich eine Website ändert",
      title: "Es bricht nicht. Es lernt.",
      text: "Websites verschieben ihre Schaltflächen, und ein selbstgebautes Skript bleibt dort stehen. Der nächste Lauf von Kitewell findet die neue Schaltfläche und behält sie, der übernächste spielt sie einfach ab. So hat die KI mit jedem Lauf weniger zu tun.",
    },
    record: {
      title: "Neue Rechnungen sammeln",
      kind: "Website",
      facts: [["Startseite", "127.0.0.1:4320/billing/invoices"], ["Browser-Schritte", "5"], ["Ohne KI ausgeführt", "3 von 6 Operationen"]],
      ops: record({ open: "Seite öffnen", act: "Tun", check: "Sicherstellen", collect: "Sammeln", done: "Abgeschlossen", replayed: "Wiederholt", recovered: "Wiederhergestellt" }),
      label: "Was der Browser getan hat",
      caption: "Aus einer echten Ausführung gegen ein Ersatzportal eines Lieferanten auf diesem Computer, so wie Kitewell sie zeigt. Das Portal hatte seine Anmelden-Schaltfläche verschoben; die KI fand die neue und behielt sie, und die nächste Ausführung hat sie wiederholt.",
    },
    browserLink: "So funktioniert die Automatisierung von Websites →",
    reach: {
      eyebrow: "Was es kann",
      title: "Websites, Desktop-Apps, Excel, E-Mail und Code.",
      web: ["Websites", "Meldet sich an, klickt, tippt und sammelt in einem Browser, dem Sie zusehen und den Sie übernehmen können. Passwörter werden von Ihrem Computer eingetippt und nie dem Modell gezeigt.", "/docs/browser/"],
      agents: ["Coding-Agenten", "Claude Code, Codex und andere Agenten laufen als Schritte: Tests über Nacht reparieren, jeden Pull Request prüfen, neue Issues sortieren.", "/coding-agents/"],
      start: "Und es startet von selbst: nach Zeitplan, per Webhook oder wenn Sie ChatGPT oder Claude auf dem Smartphone darum bitten.",
    },
    tiles: [
      ["Desktop-Apps ohne API", "Ein Modell liest den Bildschirm und bedient die App, mit Ihrem eigenen KI-Schlüssel oder der enthaltenen KI in jedem Tarif. Spätere Ausführungen spielen unter Windows über die eigenen Schaltflächen und Felder der App ab, unter macOS über den Bildschirm.", "/docs/desktop/"],
      ["Excel, Zeile für Zeile", "Läuft einmal pro Zeile der Arbeitsmappe, die Sie schon haben, und schreibt jedes Ergebnis daneben zurück. Titelzeilen, verbundene Überschriften und Zwischensummen inklusive.", "/docs/spreadsheets/"],
      ["E-Mail", "Mails in Microsoft 365, in Gmail mit einem App-Passwort oder in jedem IMAP-Postfach finden, lesen, ablegen und senden.", "/docs/email/"],
      ["Skripte, Server und APIs", "Befehle, Docker, SSH-Rollouts auf wenigen Maschinen zugleich und jede OpenAPI, mit Entscheidungsschritten, die den nächsten Weg wählen.", "/docs/workflow-builder/"],
    ],
    together: {
      eyebrow: "Bauen Sie mit",
      title: "Offen gebaut, mit den Menschen, die es nutzen.",
      lead: "Kitewell ist jung und ändert sich jede Woche durch das, was Sie uns erzählen. Sagen Sie uns, was Sie automatisieren würden, was kaputtging und was wir als Nächstes bauen sollen.",
      items: [
        ["Mit den Machern reden", "Zeigen Sie, was Sie gebaut haben, fragen Sie, wie etwas geht, oder sagen Sie, was fehlt. Die Leute, die Kitewell bauen, sind dort.", "Dem Slack beitreten →", "/community/"],
        ["Sagen, was kaputtging", "Fehler und Ideen kommen auf GitHub, wo Sie sehen, was daraus wird.", "Issue eröffnen →", "https://github.com/dagucloud/kitewell/issues/new/choose"],
        ["Offen darunter", "Workflows sind einfaches YAML auf Dagu, der Open-Source-Engine unter Kitewell. Lesen Sie den Code, oder nehmen Sie Ihre Workflows überallhin mit.", "Dagu auf GitHub ↗", "https://github.com/dagucloud/dagu"],
        ["Jede Woche neu", "Die neueste Version ist Kitewell {version}. Sie aktualisiert sich in einem ruhigen Moment selbst, und laufende Workflows gehen nach dem Neustart weiter.", "Was sich geändert hat →", "/releases/"],
      ],
    },
    finale: {
      title: "Bauen Sie heute etwas.",
      text: "Die ersten 1.000 Ausführungsminuten in Kitewell Cloud sind kostenlos, einmalig, ohne Kreditkarte und ohne API-Schlüssel; danach 0,007 $ pro Minute. Auf Ihrem eigenen Computer startet der erste 14 Tage mit den Funktionen von Team und 100 KI-Credits; danach kostet Personal 20 $ pro Monat (USD, zuzüglich Steuern).",
      plans: "Tarife ansehen →",
      teams: "Kitewell für Teams →",
    },
  },
}[locale];
const to = (path: string) => localize(path, locale);
// A mix of the personal, the office, and the code: each chore with the
// notice that replaces doing it by hand.
const ideas = ["price-watch", "inbox-digest", "fix-failing-tests", "supplier-invoices", "desktop-data-entry", "triage-issues"].map((slug) => choreBySlug(slug)!);
const strong = new Set(["Recovered", "復旧", "已恢复", "복구됨", "Récupéré", "Wiederhergestellt"]);
const tiles = [text.reach.web, ...text.tiles.slice(0, 3), text.reach.agents, text.tiles[3]];
// The latest release is named only when one is published.
const together = text.together.items
  .filter(([, detail]) => release || !detail.includes("{version}"))
  .map(([name, detail, label, href]) => [name, detail.replace("{version}", release?.version ?? ""), label, href.startsWith("/") ? to(href) : href]);
// Each line of the headline is a block of its own, so a line that wraps on a
// phone splits evenly instead of leaving its last word alone. The last line
// is the promise, marked as with a highlighter.
const lines = (value: string) =>
  value
    .split("\n")
    .map((line, i, all) => (i === all.length - 1 ? `<span><mark>${line}</mark></span>` : `<span>${line}</span>`))
    .join("");
// Search engines learn what the app is, what it costs, and what the film shows.
const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kitewell",
  operatingSystem: "macOS 13 or later, Windows 10 or later, web browser",
  applicationCategory: "BusinessApplication",
  description: text.description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const video = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: cut.label,
  description: text.description,
  thumbnailUrl: new URL(`/videos/${cut.name}.webp`, Astro.site).href,
  contentUrl: new URL(`/videos/${cut.name}.mp4`, Astro.site).href,
  uploadDate: cut.uploaded,
  duration: `PT${cut.seconds}S`,
};
---

<Site title={text.title} description={text.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(app)} />
    <script type="application/ld+json" set:html={JSON.stringify(video)} />
  </Fragment>
  <div class="home">
    <section class="intro wrap" aria-labelledby="hero-title">
      <h1 id="hero-title" set:html={lines(text.heading)} />
      <p class="intro-lead">{text.lead}</p>
      <div class="intro-actions">
        <a class="button" href={cloudSignup}>{text.build}</a>
        {release ? (
          <DownloadButton locale={locale} place="hero" secondary />
        ) : (
          <a class="text-link" href={to("/docs/getting-started/")}>{text.setup}</a>
        )}
        <a class="text-link" href="#film">{text.watch}</a>
      </div>
      <p class="fine">{text.platform}</p>
      <figure class="intro-media">
        <div class="tabs" role="tablist" hidden data-tabs>
          {text.proofTabs.map((label, i) => (
            <button type="button" role="tab" id={`proof-tab-${i}`} aria-controls={`proof-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              {label}
            </button>
          ))}
        </div>
        {proofs.map((name, i) => (
          <div class="tab-panel frame" id={`proof-panel-${i}`} role="tabpanel" aria-labelledby={`proof-tab-${i}`}>
            <Clip locale={locale} src={`/videos/proof/${name}-${recording(locale)}`} width={1920} height={1200} label={text.proof[i]} />
          </div>
        ))}
        <figcaption>{text.proofNote}</figcaption>
      </figure>
    </section>

    <section class="film-block wrap" id="film" aria-label={cut.label}>
      <figure>
        <div class="frame">
          <video
            controls
            playsinline
            preload="metadata"
            poster={versioned(`/videos/${cut.name}.webp`)}
            width="1920"
            height="1080"
            aria-label={cut.label}
            aria-describedby="film-caption"
            data-film
          >
            <source src={versioned(`/videos/${cut.name}.mp4`)} type="video/mp4" />
            {cut.tracks.map(([kind, lang, label]) => (
              <track kind={kind} src={versioned(`/videos/${cut.name}.${lang}.vtt`)} srclang={lang} label={label} />
            ))}
            <p><a href={versioned(`/videos/${cut.name}.mp4`)}>{cut.link}</a></p>
          </video>
        </div>
        <figcaption id="film-caption">
          <span>{cut.caption[0]}</span>
          <span>{cut.caption[1]}</span>
        </figcaption>
      </figure>
      <details class="film-transcript">
        <summary>{cut.transcript}</summary>
        <div>
          {cut.scenes.map(([caption, scene]) => (
            <p>
              <strong>{caption}</strong> {scene}
            </p>
          ))}
        </div>
      </details>
    </section>

    <section class="block wrap" id="ideas" aria-labelledby="ideas-title">
      <p class="eyebrow">{text.ideas.eyebrow}</p>
      <h2 id="ideas-title" class="block-title">{text.ideas.title}</h2>
      <p class="block-lead">{text.ideas.lead}</p>
      <ul class="ideas">
        {ideas.map((chore) => (
          <li>
            <a href={to(`/examples/${chore.slug}/`)} data-chore={chore.slug}>
              <span class="idea-when">{chore[locale].when}</span>
              <span class="idea-chore">{chore[locale].chore}</span>
              <Moment moment={chore[locale].moment} />
            </a>
          </li>
        ))}
      </ul>
      <div class="links">
        <a class="text-link" href={to("/examples/")}>{text.ideas.link}</a>
        <a class="text-link" href="/community/">{text.ideas.share}</a>
      </div>
    </section>

    <section class="block wrap" id="how" aria-labelledby="how-title">
      <h2 class="eyebrow" id="how-title">{text.how}</h2>
      <ol class="how-steps">
        {text.steps.map(([name, detail]) => (
          <li>
            <h3>{name}</h3>
            <p>{detail}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="block wrap" id="fix" aria-labelledby="fix-title">
      <div class="pair">
        <div>
          <p class="eyebrow">{text.fix.eyebrow}</p>
          <h2 id="fix-title">{text.fix.title}</h2>
          <p class="block-lead">{text.fix.text}</p>
          <a class="text-link" href={to("/docs/browser/")}>{text.browserLink}</a>
        </div>
        <figure class="record-figure">
          <div class="record">
            <div class="record-head">
              <strong>{text.record.title}</strong>
              <span>{text.record.kind}</span>
            </div>
            <dl class="record-facts">
              {text.record.facts.map(([name, value]) => (
                <div>
                  <dt>{name}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
            <p class="record-label">{text.record.label}</p>
            <ol class="record-ops">
              {text.record.ops.map(([kind, subject, badges]) => (
                <li>
                  <span class="record-op"><span>{kind}</span>{subject}</span>
                  <span class="record-badges">
                    {(badges as string[]).map((badge) => (
                      <span class:list={["badge", { strong: strong.has(badge) }]}>{badge}</span>
                    ))}
                  </span>
                </li>
              ))}
            </ol>
          </div>
          <figcaption>{text.record.caption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="block wrap" id="reach" aria-labelledby="reach-title">
      <p class="eyebrow">{text.reach.eyebrow}</p>
      <h2 id="reach-title" class="block-title">{text.reach.title}</h2>
      <div class="tiles reach-tiles">
        {tiles.map(([name, detail, href]) => (
          <a class="tile" href={to(href)}>
            <h3>{name}</h3>
            <p>{detail}</p>
          </a>
        ))}
      </div>
      <p class="reach-start">{text.reach.start}</p>
    </section>

    <section class="block wrap" id="together" aria-labelledby="together-title">
      <p class="eyebrow">{text.together.eyebrow}</p>
      <h2 id="together-title" class="block-title">{text.together.title}</h2>
      <p class="block-lead">{text.together.lead}</p>
      <ul class="together">
        {together.map(([name, detail, label, href]) => (
          <li>
            <h3>{name}</h3>
            <p>{detail}</p>
            <a class="text-link" href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="finale wrap" aria-labelledby="finale-title">
      <div>
        <h2 id="finale-title">{text.finale.title}</h2>
        <p class="block-lead">{text.finale.text}</p>
        <div class="links">
          <a class="text-link" href={to("/pricing/")}>{text.finale.plans}</a>
          <a class="text-link" href={to("/teams/")}>{text.finale.teams}</a>
        </div>
      </div>
      <div class="finale-action">
        <div class="finale-buttons">
          <a class="button" href={cloudSignup}>{text.build}</a>
          <DownloadButton locale={locale} place="closing" secondary />
        </div>
      </div>
    </section>
  </div>
</Site>

<script>
  // Tabs show one panel at a time; without the script every panel stays
  // visible, one after the other.
  for (const list of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    const select = (chosen: HTMLButtonElement) => {
      for (const tab of tabs) {
        const on = tab === chosen;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        document.getElementById(tab.getAttribute("aria-controls")!)!.hidden = !on;
      }
    };
    list.hidden = false;
    select(tabs[0]);
    // A tab chosen at the edge of a row that scrolls, as on a phone, comes
    // fully into view.
    const reveal = (tab: HTMLButtonElement) => tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    list.addEventListener("click", (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLButtonElement>("[role=tab]");
      if (!tab) return;
      select(tab);
      reveal(tab);
    });
    list.addEventListener("keydown", (event) => {
      const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (index < 0 || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
      const next = tabs[(index + (event.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
      select(next);
      next.focus();
      reveal(next);
    });
  }
</script>
