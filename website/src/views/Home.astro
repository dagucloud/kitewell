      ["The assistant →", "/docs/ai/#the-assistant"],
      ["MCP and API access →", "/docs/mcp/"],
    ],
    buildAlt: "A workflow the assistant proposed, with Edit in editor, Reject, and Apply buttons",
    control: "Keep control",
    controlTitle: "Approve what matters. See what happened.",
