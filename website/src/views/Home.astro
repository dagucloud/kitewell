---
import Site from "../layouts/Site.astro";
import { readManifest } from "../lib/releases.mjs";
import { descartyUrl } from "../lib/descarty.mjs";
import { localize } from "../lib/i18n.mjs";
import { examples } from "../lib/examples.mjs";
interface Props {
  locale: "en" | "ja";
}
const { locale } = Astro.props;
const release = await readManifest();
const text = {
  en: {
    title: "AI automation that runs on your own computer",
    description:
      "Kitewell automates websites, desktop apps, email, scripts, and coding agents on your Mac or PC, with schedules, approvals, and a log of every run. Free for one project.",
    eyebrow: release ? `Version ${release.version}` : "Coming soon",
    heading: "AI automation that runs on your own computer.",
    lead: "Kitewell automates websites, desktop apps, email, scripts, and coding agents on your Mac or PC. Every workflow runs on a schedule, waits for your approval where you say so, and keeps a log of every step. Your credentials and data stay on your machine.",
    primary: release ? "Download Kitewell" : "See what it can do",
    setup: "Read the setup guide →",
    platform: "macOS 13+ · Windows 10+ · Free for one project · No account needed",
    previewLabel: "Open the workflow editor screenshot at full size",
    previewAlt: "The Kitewell workflow editor with a daily report workflow and the selected step's settings",
    previewCaption: ["Connect steps on the canvas. Select a step to edit its settings.", "Open image to enlarge"],
    automate: "What it automates",
    automateTitle: "The work that happens on your computer.",
    automateText: "Each of these is a step you add from the task picker. Mix them in one workflow.",
    kinds: [
      ["Websites", "Open pages, click, type, and collect information in your own Chrome, from instructions in plain words. Saved sign-ins stay on the device.", "/docs/browser/"],
      ["Desktop apps", "A model reads the screen and uses the mouse and keyboard, on macOS or Windows, for the app that has no API.", "/docs/desktop/"],
      ["Email", "Find, organize, and send email in Gmail, Microsoft 365, or any IMAP mailbox connected on this computer.", "/docs/email/"],
      ["Scripts, containers, servers, and APIs", "Commands and scripts, Docker images, SSH to your servers, and operations from any OpenAPI spec.", "/docs/workflow-builder/"],
      ["Coding agents on a schedule", "Claude Code, Codex, Gemini, and 13 more run as steps, with the sign-in you already have.", "/docs/ai/"],
    ],
    build: "Build it by asking",
    buildTitle: "Describe the workflow. Review the diff. Apply.",
    buildText:
      "The assistant (⌘J) proposes a new or changed workflow as a card with a graph preview; nothing is saved until you apply it. Connect Claude Code or Codex through MCP and build, run, and fix workflows from that conversation instead.",
    buildLinks: [
      ["The assistant →", "/docs/ai/#the-assistant"],
      ["MCP and API access →", "/docs/mcp/"],
    ],
    buildAlt: "A workflow the assistant proposed, with Edit in editor, Reject, and Apply buttons",
    control: "Keep control",
    controlTitle: "Approve what matters. See what happened.",
    controlItems: [
      ["Approval gates and human tasks", "A run pauses where you put a gate and continues when you approve, with the decision recorded."],
      ["Test one step", "Run a single step with real inputs before saving the workflow."],
      ["Replay", "Website and desktop actions that worked replay without the model on later runs: faster, and free."],
      ["Runs and logs", "Every run keeps each step's output, errors, screenshots, and files on your computer; retry from the failed step."],
    ],
    controlLink: "Runs and logs →",
    controlAlt: "A completed daily report workflow in Kitewell, with the report visible in the selected step's output",
    machine: "Runs on your machine",
    machineTitle: "You decide what leaves it.",
    machineRows: [
      ["Secret values", "Encrypted on this computer. Never in logs, exports, backups, or the cloud."],
      ["Websites, desktop apps, and email", "Sign-ins stay on the device. A step sends only what it reads to the model you chose."],
      ["AI models", "Anthropic, OpenAI, Gemini, OpenRouter, or a local server such as Ollama or vLLM. A workflow without AI sends nothing to any provider."],
      ["Runs, logs, and files", "On your computer, under the retention you set."],
      ["Dagu Cloud", "Only if you sign in and sync a project: its definitions and secret names, never values, runs, or logs."],
    ],
    machineLink: "Everything that leaves, and when →",
    examplesEyebrow: "Examples",
    examplesTitle: "Workflows you can copy today.",
    examplesLink: "All examples →",
    team: "Small teams",
    teamTitle: "Share the project, not the secrets.",
    teamText:
      "Sync a project through Dagu Cloud and every teammate works from the same workflows, with a role on each project. Each person's secret values and sign-ins stay on their own computer. Pro covers teams of up to 10 people.",
    teamLinks: [
      ["Sync with Dagu Cloud →", "/docs/cloud-sync/"],
      ["Project sharing →", "/docs/sharing/"],
    ],
    enterprise: "Larger team, or a rollout with support? Descarty ↗",
    meet: "Meet Kitewell in 60 seconds",
    tagline: "Serious workflows. Seriously simple.",
    taglineText: "Build visually. Run on your terms. With or without code.",
    filmLabel: "Kitewell product film, 60 seconds",
    filmLink: "Watch the Kitewell film.",
    filmCaption: ["60 seconds · Original music · Sound on", "Illustrative product demo"],
    short: "Watch the 30-second version",
    shortLabel: "Kitewell short film, 30 seconds, portrait",
    shortLink: "Watch the short film.",
    transcript: "Read the video transcript",
    scenes: [
      [
        "Serious workflows. Seriously simple.",
        "For builders, with or without code. Kitewell: build visually, run on your terms. Instrumental electronic music plays throughout; there is no narration.",
      ],
      [
        "Build a workflow without writing code.",
        "In the visual editor, customer feedback flows from a connected API to an AI decision. The question “Does this feedback need a reply?” creates the next path: draft a reply, then ask a person to approve it. Select Weekdays at 9:00, review, and start the run. All four steps complete on your machine. This illustrative demo uses tools configured in advance.",
      ],
      [
        "Your tools. One flow.",
        "Connect AI harnesses such as Codex, Claude Code, and Gemini; Docker images; commands; remote servers over SSH; decision APIs; and imported OpenAPI actions.",
      ],
      [
        "Runs locally. Works together.",
        "The full film shows team members running workflows, viewing results, and managing workflows through MCP. Share access through MCP and REST while keeping execution on your machine.",
      ],
      [
        "Or simply ask.",
        "A chat agent connected through MCP receives the request “Build a daily feedback workflow. Flag urgent issues for review.” Kitewell creates, validates, and schedules the workflow for review. Build, run, inspect, and fix workflows from the conversation.",
      ],
      [
        "Easy to build. Yours to run.",
        "For the team that imagines it and the people who make it happen. The short film ends with “Runs on your machine. Shared with your team.” Explore Kitewell at kitewell.app.",
      ],
    ],
    pricing: "Planned launch pricing",
    pricingTitle: "Free for one project.",
    pricingText:
      "One project with up to 10 workflows needs no Kitewell account, and includes website, desktop, and email automation. Pro holds up to ten projects of 100 workflows each and adds alerts and team sync, for $25 per person per month (USD).",
    compare: "Compare plans →",
    availability: release ? "Download Kitewell" : "Check release availability",
    status: release ? "Available now" : "Coming soon",
  },
  ja: {
    title: "AI 自動化を、自分の PC で",
    description:
      "Kitewell は、Web サイト、デスクトップアプリ、メール、スクリプト、コーディングエージェントを、あなたの Mac や PC で自動化します。スケジュール、承認、すべての実行の記録付き。1 プロジェクトまで無料。",
    eyebrow: release ? `バージョン ${release.version}` : "近日公開",
    heading: "AI 自動化を、\n自分の PC で。",
    lead: "Kitewell は、Web サイト、デスクトップアプリ、メール、スクリプト、コーディングエージェントを、あなたの Mac や PC で自動化します。ワークフローはスケジュールで動き、指定した所であなたの承認を待ち、すべてのステップの記録を残します。認証情報とデータは、あなたのマシンから出ません。",
    primary: release ? "Kitewell をダウンロード" : "できることを見る",
    setup: "セットアップガイドを読む →",
    platform: "macOS 13 以降 · Windows 10 以降 · 1 プロジェクトまで無料 · アカウント不要",
    previewLabel: "ワークフローエディターのスクリーンショットを原寸で開く",
    previewAlt: "Kitewell のワークフローエディター。ログイン ID の入力など、Web の操作が自然な言葉で書かれている",
    previewCaption: ["Web の操作は文で書きます。各ページでのクリックはモデルが判断します。", "画像を開いて拡大"],
    automate: "自動化できること",
    automateTitle: "あなたのコンピューターで起きる仕事を。",
    automateText: "どれもタスクの選択肢から追加するステップです。1 つのワークフローに混ぜて使えます。",
    kinds: [
      ["Web サイト", "自然な言葉の指示で、あなたの Chrome でページを開き、クリックし、入力し、情報を集めます。保存したサインインはデバイスに残ります。", "/docs/browser/"],
      ["デスクトップアプリ", "API のないアプリのために、モデルが画面を読み、マウスとキーボードを使います。macOS と Windows に対応。", "/docs/desktop/"],
      ["メール", "このコンピューターで接続した Gmail、Microsoft 365、任意の IMAP メールボックスのメールを検索、整理、送信します。", "/docs/email/"],
      ["スクリプト、コンテナー、サーバー、API", "コマンドとスクリプト、Docker イメージ、SSH でのサーバー操作、OpenAPI 仕様の操作。", "/docs/workflow-builder/"],
      ["スケジュールで動くコーディングエージェント", "Claude Code、Codex、Gemini など 16 種類が、手元のサインインのままステップとして動きます。", "/docs/ai/"],
    ],
    build: "頼んで作る",
    buildTitle: "ワークフローを説明し、差分を確認し、適用する。",
    buildText:
      "アシスタント（⌘J）は、新しいワークフローや変更をグラフ付きのカードで提案します。適用するまで何も保存されません。MCP で Claude Code や Codex をつなげば、その会話の中からワークフローを作り、動かし、直せます。",
    buildLinks: [
      ["アシスタント →", "/docs/ai/#the-assistant"],
      ["MCP と API アクセス →", "/docs/mcp/"],
    ],
    buildAlt: "アシスタントが提案したワークフロー。「エディターで編集」「却下」「適用」のボタンがある",
    control: "手綱を握る",
    controlTitle: "大事な所は承認し、起きたことを見る。",
    controlItems: [
      ["承認ゲートと人のタスク", "ゲートを置いた所で実行は止まり、承認すると続きます。判断は記録に残ります。"],
      ["ステップ単位のテスト", "ワークフローを保存する前に、実際の入力で 1 ステップだけ実行できます。"],
      ["リプレイ", "うまくいった Web とデスクトップの操作は、以降の実行でモデルなしで再現されます。速く、無料です。"],
      ["実行とログ", "各ステップの出力、エラー、スクリーンショット、ファイルはすべてあなたのコンピューターに残り、失敗したステップからやり直せます。"],
    ],
    controlLink: "実行とログ →",
    controlAlt: "Kitewell の実行画面。仕入れ先ポータルから注文を集めたワークフローが、オーナーの承認を待っている",
    machine: "あなたのマシンで動く",
    machineTitle: "何を外に出すかは、あなたが決める。",
    machineRows: [
      ["シークレットの値", "このコンピューターで暗号化。ログ、エクスポート、バックアップ、クラウドには入りません。"],
      ["Web サイト、デスクトップアプリ、メール", "サインインはデバイスに残ります。ステップは読み取った内容だけを、あなたが選んだモデルに送ります。"],
      ["AI モデル", "Anthropic、OpenAI、Gemini、OpenRouter、または Ollama や vLLM のようなローカルサーバー。AI のないワークフローは、どのプロバイダーにも何も送りません。"],
      ["実行、ログ、ファイル", "あなたのコンピューターに、設定した保持期間だけ残ります。"],
      ["Dagu Cloud", "サインインしてプロジェクトを同期したときだけ、その定義とシークレットの名前。値、実行、ログは送られません。"],
    ],
    machineLink: "外に出るものと、そのタイミングのすべて →",
    examplesEyebrow: "活用例",
    examplesTitle: "今日から写せるワークフロー。",
    examplesLink: "活用例をすべて見る →",
    team: "小さなチーム",
    teamTitle: "プロジェクトは共有し、シークレットは共有しない。",
    teamText:
      "Dagu Cloud を通じてプロジェクトを同期すると、チーム全員が同じワークフローで作業でき、プロジェクトごとにロールを設定できます。シークレットの値とサインインは、それぞれのコンピューターにとどまります。Pro は 10 人までのチームで使えます。",
    teamLinks: [
      ["Dagu Cloud と同期 →", "/docs/cloud-sync/"],
      ["プロジェクトの共有 →", "/docs/sharing/"],
    ],
    enterprise: "それより大きなチームや、支援付きの導入は Descarty へ ↗",
    meet: "60 秒で見る Kitewell",
    tagline: "本格的なワークフローを、驚くほどシンプルに。",
    taglineText: "ビジュアルに組み立て、思いどおりに動かす。コードを書いても、書かなくても。",
    filmLabel: "Kitewell 紹介映像（60 秒）",
    filmLink: "Kitewell の紹介映像を見る。",
    filmCaption: ["60 秒 · オリジナル音楽 · 音声あり", "説明用の製品デモ"],
    short: "30 秒版を見る",
    shortLabel: "Kitewell ショート映像（30 秒・縦型）",
    shortLink: "ショート映像を見る。",
    transcript: "映像の内容をテキストで読む",
    scenes: [
      [
        "Serious workflows. Seriously simple.",
        "（本格的なワークフローを、驚くほどシンプルに。）コードを書く人にも、書かない人にも。Kitewell：ビジュアルに組み立て、思いどおりに動かす。全編にエレクトロニックのインストゥルメンタル音楽が流れ、ナレーションはありません。",
      ],
      [
        "Build a workflow without writing code.",
        "（コードを書かずにワークフローを作る。）ビジュアルエディターで、顧客からのフィードバックが接続済みの API から AI の判断へ流れます。「このフィードバックには返信が必要か？」という問いが次の経路を作ります。返信の下書きを作り、人に承認を求める。平日 9:00 を選び、確認して、実行を開始。4 つのステップがすべてあなたのマシンで完了します。この説明用デモは、事前に設定したツールを使っています。",
      ],
      [
        "Your tools. One flow.",
        "（あなたのツールを、ひとつの流れに。）Codex、Claude Code、Gemini などの AI ハーネス、Docker イメージ、コマンド、SSH 経由のリモートサーバー、判断 API、インポートした OpenAPI のアクションをつなぎます。",
      ],
      [
        "Runs locally. Works together.",
        "（ローカルで動き、チームで使う。）フルバージョンでは、チームのメンバーがワークフローを実行し、結果を見て、MCP でワークフローを管理する様子を映しています。実行はあなたのマシンに置いたまま、MCP と REST でアクセスを共有します。",
      ],
      [
        "Or simply ask.",
        "（あるいは、ただ頼む。）MCP でつないだチャットエージェントが「日次のフィードバックワークフローを作って。緊急の問題はレビュー用にフラグを立てて」という依頼を受け取ります。Kitewell がワークフローを作成し、検証し、レビュー用にスケジュールします。会話の中から、ワークフローを作り、動かし、調べ、直せます。",
      ],
      [
        "Easy to build. Yours to run.",
        "（作るのは簡単に。動かすのはあなたの手で。）思い描くチームと、実現する人たちのために。ショート映像は「あなたのマシンで動き、チームと共有する。」で終わります。kitewell.app で Kitewell をご覧ください。",
      ],
    ],
    pricing: "正式リリース時の予定価格",
    pricingTitle: "1 プロジェクトなら無料。",
    pricingText:
      "ワークフロー 10 個までの 1 プロジェクトは、Kitewell アカウントなしで使え、Web サイト、デスクトップ、メールの自動化も含まれます。Pro は 1 人あたり月額 $25（USD）で、各 100 ワークフローのプロジェクトを 10 個まで持て、アラートとチームでの同期が加わります。",
    compare: "プランを比較する →",
    availability: release ? "Kitewell をダウンロード" : "リリース状況を確認する",
    status: release ? "提供中" : "近日公開",
  },
}[locale];
const to = (path: string) => localize(path, locale);
const featured = ["inbox-digest", "invoice-intake", "nightly-dependency-update", "price-watch", "desktop-app-entry", "company-research-sheet"]
  .map((slug) => examples.find((example) => example.slug === slug)!)
  .map((example) => ({ slug: example.slug, ...example[locale] }));
// The English editor shot carries English demo data; the other shots do in both languages.
const images = {
  editor: locale === "ja" ? "/images/home/ja/editor-browser.png" : "/images/workflow-builder.jpg",
  proposal: `/images/home/${locale}/assistant-proposal.png`,
  approval: locale === "ja" ? "/images/home/ja/run-approval.png" : "/images/workflow-run.jpg",
};
const approvalSize = locale === "ja" ? [1600, 720] : [1345, 886];
const proposalWidth = locale === "ja" ? 716 : 752;
---

<Site title={text.title} description={text.description}>
  <div class="wrap home">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow dot">{text.eyebrow}</p>
      <h1 id="hero-title" set:html={text.heading.replace("\n", "<br>")} />
      <p class="lead">{text.lead}</p>
      <div class="actions">
        <a class="button" href={release ? to("/download/") : "#automate"}>
          {text.primary}
          <span aria-hidden="true">{release ? "↗" : "↓"}</span>
        </a>
        <a class="text-link" href={to("/docs/getting-started/")}>
          {text.setup}
        </a>
      </div>
      <p class="fine">{text.platform}</p>
    </section>

    <figure class="product-preview">
      <a href={images.editor} aria-label={text.previewLabel}>
        <img
          src={images.editor}
          alt={text.previewAlt}
          width={locale === "ja" ? 1600 : 1869}
          height={locale === "ja" ? 913 : 1012}
          fetchpriority="high"
        />
      </a>
      <figcaption>
        <span>{text.previewCaption[0]}</span>
        <span>{text.previewCaption[1]}</span>
      </figcaption>
    </figure>

    <section class="section automate" id="automate" aria-labelledby="automate-title">
      <p class="eyebrow">{text.automate}</p>
      <h2 id="automate-title">{text.automateTitle}</h2>
      <p class="section-lead">{text.automateText}</p>
      <div class="kinds">
        {text.kinds.map(([name, detail, href]) => (
          <a class="kind" href={to(href)}>
            <strong>{name}</strong>
            <span>{detail}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section split" aria-labelledby="build-title">
      <div>
        <p class="eyebrow">{text.build}</p>
        <h2 id="build-title">{text.buildTitle}</h2>
        <p class="section-lead">{text.buildText}</p>
        <div class="actions">
          {text.buildLinks.map(([label, href]) => (
            <a class="text-link" href={to(href)}>{label}</a>
          ))}
        </div>
      </div>
      <figure class="product-preview shot-tall">
        <img src={images.proposal} alt={text.buildAlt} width={proposalWidth} height="900" loading="lazy" />
      </figure>
    </section>

    <section class="section split" aria-labelledby="control-title">
      <figure class="product-preview">
        <img src={images.approval} alt={text.controlAlt} width={approvalSize[0]} height={approvalSize[1]} loading="lazy" />
      </figure>
      <div>
        <p class="eyebrow">{text.control}</p>
        <h2 id="control-title">{text.controlTitle}</h2>
        <ol class="example-steps">
          {text.controlItems.map(([name, detail]) => (
            <li>
              <strong>{name}</strong>
              <span>{detail}</span>
            </li>
          ))}
        </ol>
        <a class="text-link" href={to("/docs/runs/")}>{text.controlLink}</a>
      </div>
    </section>

    <section class="section machine" aria-labelledby="machine-title">
      <p class="eyebrow">{text.machine}</p>
      <h2 id="machine-title">{text.machineTitle}</h2>
      <dl class="facts">
        {text.machineRows.map(([name, detail]) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href={to("/docs/data-flow/")}>{text.machineLink}</a>
    </section>

    <section class="section" aria-labelledby="examples-title">
      <p class="eyebrow">{text.examplesEyebrow}</p>
      <h2 id="examples-title">{text.examplesTitle}</h2>
      <div class="cards examples">
        {featured.map((example) => (
          <article class="card">
            <h3>
              <a href={to(`/examples/${example.slug}/`)}>{example.title}</a>
            </h3>
            <p>{example.summary}</p>
          </article>
        ))}
      </div>
      <a class="text-link" href={to("/examples/")}>{text.examplesLink}</a>
    </section>

    <aside class="connections" aria-label={text.team}>
      <p>
        <strong>{text.teamTitle}</strong> {text.teamText}
      </p>
      <div>
        {text.teamLinks.map(([label, href]) => (
          <a class="text-link" href={to(href)}>{label}</a>
        ))}
        <a class="text-link" href={descartyUrl(locale, "/enterprise/")}>{text.enterprise}</a>
      </div>
    </aside>

    <section class="promo" id="film" aria-labelledby="film-title">
      <div class="promo-heading">
        <p class="eyebrow">{text.meet}</p>
        <h2 id="film-title">{text.tagline}</h2>
        <p>{text.taglineText}</p>
      </div>
      <figure class="promo-film">
        <video
          controls
          playsinline
          preload="none"
          poster="/videos/kitewell-film.webp"
          width="1920"
          height="1080"
          aria-label={text.filmLabel}
          aria-describedby="film-caption"
        >
          <source src="/videos/kitewell-film-v2.mp4" type="video/mp4" />
          <p><a href="/videos/kitewell-film-v2.mp4">{text.filmLink}</a></p>
        </video>
        <figcaption id="film-caption">
          <span>{text.filmCaption[0]}</span>
          <span>{text.filmCaption[1]}</span>
        </figcaption>
      </figure>
      <div class="promo-extras">
        <details class="promo-short">
          <summary>{text.short}</summary>
          <video
            controls
            playsinline
            preload="none"
            poster="/videos/kitewell-social-v2.webp"
            width="1080"
            height="1920"
            aria-label={text.shortLabel}
          >
            <source src="/videos/kitewell-social-v2.mp4" type="video/mp4" />
            <p><a href="/videos/kitewell-social-v2.mp4">{text.shortLink}</a></p>
          </video>
        </details>
        <details class="promo-transcript">
          <summary>{text.transcript}</summary>
          <div>
            {text.scenes.map(([caption, scene]) => (
              <p>
                <strong lang="en">{caption}</strong> {scene}
              </p>
            ))}
          </div>
        </details>
      </div>
    </section>

    <section class="closing" aria-labelledby="pricing-title">
      <div>
        <p class="eyebrow">{text.pricing}</p>
        <h2 id="pricing-title">{text.pricingTitle}</h2>
        <p>
          {text.pricingText}{" "}
          <a href={to("/pricing/")}>{text.compare}</a>
        </p>
      </div>
      <div class="availability">
        <a class="button" href={to("/download/")}>
          {text.availability}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="fine">{text.status} · macOS 13+ · Windows 10+</p>
      </div>
    </section>
  </div>
</Site>
