---
import Site from "../layouts/Site.astro";
import { readLibraryNotices, readNotices } from "../lib/notices.mjs";

const dagu = await readNotices();
const libraries = await readLibraryNotices();
---

<Site
  title="Third-party notices"
  description="Open-source components included in Kitewell, their licenses, and source references."
>
  <section class="page wrap">
    <p class="eyebrow">Built with open-source software</p>
    <h1>Third-party notices.</h1>
    <div class="prose">
      <p>
        Kitewell includes Dagu as its workflow engine, alongside open-source
        libraries. Kitewell's application source is private. Each included
        component retains its own license.
      </p>
      <h2>Dagu</h2>
      <p>
        Kitewell's installers include Dagu {dagu.version} as the workflow
        engine, distributed under the GNU General Public License, version 3.
      </p>
      <ul>
        <li>
          <a href={dagu.source}>Source for Dagu {dagu.version}</a>
        </li>
        <li>
          <a href={dagu.release}>Dagu {dagu.version} release</a>
        </li>
        <li>
          <a href="/licenses/DAGU-LICENSE.txt">Dagu license</a>
        </li>
        <li>
          <a href="/licenses/THIRD-PARTY-NOTICES.txt">
            Component notices and source references
          </a>
        </li>
      </ul>
      <p>
        After installation, Kitewell can update the engine to a newer stable
        Dagu release, which it downloads from the Dagu project's GitHub
        releases, where each release's source and license are published.
      </p>
      <p>
        Published installers will be accompanied by the applicable source
        materials in their GitHub Release assets.
      </p>
      <h2>Library notices</h2>
      <ul>
        {
          libraries.map(({ file, label }) => (
            <li>
              <a href={`/licenses/${file}`}>{label}</a>
              {file === "WINDOWS-LICENSES.txt" && " (Windows app only)"}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Site>
