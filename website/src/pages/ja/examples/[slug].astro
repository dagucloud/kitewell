---
import Example from "../../../views/Example.astro";
import { chores } from "../../../lib/chores.mjs";

export function getStaticPaths() {
  return chores.map((chore) => ({ params: { slug: chore.slug }, props: { chore } }));
}
const { chore } = Astro.props;
---

<Example locale="ja" chore={chore} />
