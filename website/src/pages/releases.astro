---
import Site from "../layouts/Site.astro";
import { releaseNotes } from "../lib/releases.mjs";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
const processor = await createMarkdownProcessor();
const releases = await Promise.all(
  (await releaseNotes()).map(async (release) => ({
    ...release,
    html: (await processor.render(release.body)).code,
  })),
);
---

<Site
  title="Releases"
  description="Runstead release notes, known issues, and versioned downloads."
>
  <section class="page wrap">
    <p class="eyebrow">What's new</p>
    <h1>A record of each release.</h1>
    <p class="lead">
      Changes, known issues, and downloads for every public Runstead version.
    </p>
    {releases.length ? (
      releases.map((release) => (
        <article class="release prose">
          <h2>Runstead {release.version}</h2>
          <a
            class="release-link"
            href={`https://github.com/dagucloud/runstead/releases/tag/v${release.version}`}
          >
            Installers and release assets ↗
          </a>
          <div set:html={release.html} />
        </article>
      ))
    ) : (
      <div class="notice">
        <h3>The first public beta is coming soon</h3>
        <p>
          Release notes will appear here when a verified installer is published.{" "}
          <a href="/docs/">Explore the documentation</a> in the meantime.
        </p>
      </div>
    )}
  </section>
</Site>
