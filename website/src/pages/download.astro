---
import Site from "../layouts/Site.astro";
import { readManifest } from "../lib/releases.mjs";
const release = await readManifest();
const architectures = [
  ["arm64", "Apple Silicon", "For Macs with Apple M-series chips."],
  ["amd64", "Intel", "For Macs with Intel processors."],
];
---

<Site
  title={release ? "Download Runstead" : "Beta availability"}
  description="Check Runstead beta availability, supported platforms, system requirements, and installation instructions."
>
  <section class="page wrap">
    <p class="eyebrow">Downloads</p>
    <h1>
      {release
        ? `Download Runstead ${release.version}`
        : "Public beta coming soon"}
    </h1>
    <p class="lead">
      {release
        ? "The public beta is ready to download. Check the supported platforms and system requirements below."
        : "There are no public installers yet. The first release will be for macOS; Linux and Windows support is planned."}
    </p>
    <div class="platforms">
      <span>macOS · {release ? "Public beta" : "Coming soon"}</span>
      <span>Linux · Planned</span>
      <span>Windows · Planned</span>
    </div>
    {release ? (
      <div class="cards">
        {architectures.map(([arch, title, description]) => (
          <article class="card">
            <h2>{title}</h2>
            <p>{description}</p>
            <a class="button" href={release.downloads[`darwin-${arch}`].url}>
              Download .pkg
            </a>
            <p class="checksum">
              SHA256
              <br />
              <code>{release.downloads[`darwin-${arch}`].sha256}</code>
            </p>
          </article>
        ))}
      </div>
    ) : (
      <div class="notice">
        <h2>See how Runstead works</h2>
        <p>
          Read the <a href="/docs/getting-started/">getting started guide</a>
          {" "}or explore the <a href="/docs/workflow-builder/">workflow editor</a>.
          Installers will appear here and on{" "}
          <a href="https://github.com/dagucloud/runstead/releases">
            GitHub Releases
          </a>{" "}
          when the beta is published.
        </p>
      </div>
    )}
    <div class="prose">
      <h2>Installing on macOS</h2>
      <ul>
        <li>
          macOS 13 or later. To check your chip, open Apple menu → About This
          Mac.
        </li>
        <li>
          The package installs into Applications and requires an administrator
          password.
        </li>
        <li>
          Python, Docker, AI command-line agents, and other tools are needed
          only for workflows that use them.
        </li>
        <li>
          When updating, save edits and let running jobs finish. Installation
          restarts Runstead.
        </li>
      </ul>
      <p>
        <a href="/docs/install/">Read installation instructions →</a>
      </p>
    </div>
  </section>
</Site>
