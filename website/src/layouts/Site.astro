---
import "../styles/site.css";
import Analytics from "../components/Analytics.astro";
import { readReleases } from "../lib/releases.mjs";
import { descartyUrl } from "../lib/descarty.mjs";
import { counterparts, localeOf, localize } from "../lib/i18n.mjs";
interface Props {
  title: string;
  description?: string;
}
const locale = localeOf(Astro.url.pathname);
const text = {
  en: {
    description:
      "Kitewell automates websites, desktop apps, email, scripts, and coding agents on your own computer, with schedules, approvals, and a log of every run.",
    skip: "Skip to content",
    home: "Kitewell home",
    nav: "Main navigation",
    links: ["Docs", "Examples", "Pricing", "Releases", "Support"],
    download: "Download Kitewell",
    status: "Release status",
    tagline: "AI automation on your own computer.",
    footer: ["Documentation", "Third-party notices", "Support", "Contact", "Privacy", "Terms"],
    fine: "",
  },
  ja: {
    description:
      "Kitewell は、Web サイト、デスクトップアプリ、メール、スクリプト、コーディングエージェントを、自分のコンピューターで自動化します。スケジュール、承認、すべての実行の記録付き。",
    skip: "本文へスキップ",
    home: "Kitewell ホーム",
    nav: "メインナビゲーション",
    links: ["ドキュメント", "活用例", "料金", "リリース", "サポート"],
    download: "Kitewell をダウンロード",
    status: "リリース状況",
    tagline: "AI 自動化を、自分の PC で。",
    footer: ["ドキュメント", "サードパーティのライセンス", "サポート", "お問い合わせ", "プライバシー", "利用規約"],
    fine: "",
  },
}[locale];
const { title, description = text.description } = Astro.props;
// A release published for either system is enough to offer the download.
const { macos, windows } = await readReleases();
const release = macos ?? windows;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pages = counterparts(Astro.url.pathname);
// The switch offers the other language, named in that language.
const other = locale === "ja" ? "en" : "ja";
const otherLabel = other === "ja" ? "日本語" : "English";
const links = ["/docs/", "/examples/", "/pricing/", "/releases/", "/support/"].map((href, i) => [
  localize(href, locale),
  text.links[i],
]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Kitewell</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {pages && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(pages.en, Astro.site)} />
        <link rel="alternate" hreflang="ja" href={new URL(pages.ja, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(pages.en, Astro.site)} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Kitewell`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://kitewell.app/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      {text.skip}
    </a>
    <header class="header wrap">
      <a class="brand" href={localize("/", locale)} aria-label={text.home}>
        <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
        Kitewell
      </a>
      <nav aria-label={text.nav}>
        {links.map(([href, label]) => (
          <a
            href={href}
            aria-current={
              Astro.url.pathname.startsWith(href) ? "page" : undefined
            }
          >
            {label}
          </a>
        ))}
        {pages && (
          <a href={pages[other]} lang={other} hreflang={other}>
            {otherLabel}
          </a>
        )}
      </nav>
      <a class="button small" href={localize("/download/", locale)}>
        {release ? text.download : text.status}
        <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer wrap">
      <div>
        <a class="brand" href={localize("/", locale)}>
          <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
          Kitewell
        </a>
        <p>{text.tagline}</p>
      </div>
      <div class="footer-links">
        <a href={localize("/docs/", locale)}>{text.footer[0]}</a>
        <a href="https://github.com/dagucloud/kitewell">GitHub</a>
        <a href="/third-party/">{text.footer[1]}</a>
        <a href={localize("/support/", locale)}>{text.footer[2]}</a>
        <a href="mailto:company@descarty.com?subject=Kitewell">{text.footer[3]}</a>
        <a href={localize("/privacy/", locale)}>{text.footer[4]}</a>
        <a href={localize("/terms/", locale)}>{text.footer[5]}</a>
        <Analytics />
      </div>
      <p class="fine">© {new Date().getFullYear()} <a href={descartyUrl(locale)}>Descarty, Inc.</a> {text.fine}</p>
    </footer>
  </body>
</html>
