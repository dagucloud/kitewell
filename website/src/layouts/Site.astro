---
import "@fontsource-variable/inter";
import "../styles/site.css";
// Only Japanese pages link Noto Sans JP, so no other language loads its
// stylesheet.
import japaneseFonts from "../styles/fonts-ja.css?url";
import Analytics from "../components/Analytics.astro";
import Endorsement from "../components/Endorsement.astro";
import { cloudApp, cloudSignup } from "../lib/cloud.mjs";
import { descartyUrl } from "../lib/descarty.mjs";
import { counterparts, languages, localeOf, locales, localize } from "../lib/i18n.mjs";
import { detectPlatform } from "../lib/platform.mjs";
interface Props {
  title: string;
  description?: string;
  // image replaces the language's card in link previews, with alt saying
  // what it shows.
  image?: { src: string; width: number; height: number; alt: string };
  noindex?: boolean;
}
const locale = localeOf(Astro.url.pathname);
const text = {
  en: {
    description:
      "Kitewell automates websites, desktop apps, email, scripts, and coding agents, in the cloud or on your own computer, with schedules, approvals, and a log of every run.",
    skip: "Skip to content",
    home: "Kitewell home",
    nav: "Main navigation",
    language: "Language",
    links: ["Examples", "Pricing", "Docs", "Download"],
    companies: "For companies ↗",
    partner: "For agencies ↗",
    signIn: "Sign in",
    trial: "Start free trial",
    tagline: "AI learns the job once. Then it runs fast, without second-guessing.",
    social: "AI learns the job once. Then it runs fast, without second-guessing. Kitewell: browser automation built and maintained by AI, plus desktop apps, Excel, and email.",
    footer: ["Documentation", "Third-party notices", "Support", "Contact", "Privacy", "Terms", "Community", "Compare", "Releases"],
    fine: "",
  },
  ja: {
    description:
      "Kitewell は、Web サイト、デスクトップアプリ、メール、スクリプト、コーディングエージェントを、クラウドや自分のコンピューターで自動化します。スケジュール、承認、すべての実行の記録付き。",
    skip: "本文へスキップ",
    home: "Kitewell ホーム",
    nav: "メインナビゲーション",
    language: "言語",
    links: ["活用例", "料金", "ドキュメント", "ダウンロード"],
    companies: "法人のお客様 ↗",
    partner: "",
    signIn: "サインイン",
    trial: "無料で試す",
    tagline: "AI は一度で覚える。あとは迷わず、速く動く。",
    social: "AI は一度で覚える。あとは迷わず、速く動く。Kitewell：AI がつくり保守するブラウザーの自動化と、デスクトップアプリ、Excel、メール。",
    footer: ["ドキュメント", "サードパーティのライセンス", "サポート", "お問い合わせ", "プライバシー", "利用規約", "コミュニティ", "比較", "リリース"],
    fine: "",
  },
  zh: {
    description:
      "Kitewell 在云端或你自己的电脑上自动化网站、桌面应用、电子邮件、脚本和编程智能体，并提供计划、审批和每次运行的记录。",
    skip: "跳到正文",
    home: "Kitewell 首页",
    nav: "主导航",
    language: "语言",
    links: ["示例", "价格", "文档", "下载"],
    companies: "企业客户 ↗",
    partner: "",
    signIn: "登录",
    trial: "免费试用",
    tagline: "AI 学一次就会。之后毫不犹豫，快速运行。",
    social: "AI 学一次就会。之后毫不犹豫，快速运行。Kitewell：由 AI 搭建并维护的浏览器自动化，还能处理桌面应用、Excel 和电子邮件。",
    footer: ["文档", "第三方声明", "支持", "联系我们", "隐私政策", "使用条款", "社区", "对比", "版本发布"],
    fine: "",
  },
  ko: {
    description:
      "Kitewell은 웹사이트, 데스크톱 앱, 이메일, 스크립트, 코딩 에이전트를 클라우드나 내 컴퓨터에서 자동화합니다. 일정, 승인, 모든 실행의 기록을 갖췄습니다.",
    skip: "본문으로 건너뛰기",
    home: "Kitewell 홈",
    nav: "주 메뉴",
    language: "언어",
    links: ["예시", "요금", "문서", "다운로드"],
    companies: "기업 고객 ↗",
    partner: "",
    signIn: "로그인",
    trial: "무료 체험",
    tagline: "AI는 한 번에 익힙니다. 그다음엔 망설임 없이 빠르게 움직입니다.",
    social: "AI는 한 번에 익힙니다. 그다음엔 망설임 없이 빠르게 움직입니다. Kitewell: AI가 만들고 유지 관리하는 브라우저 자동화, 그리고 데스크톱 앱, Excel, 이메일.",
    footer: ["문서", "제3자 고지", "지원", "문의", "개인정보 처리방침", "이용약관", "커뮤니티", "비교", "릴리스"],
    fine: "",
  },
  fr: {
    description:
      "Kitewell automatise sites web, applications de bureau, e-mail, scripts et agents de codage, dans le cloud ou sur votre propre ordinateur, avec des planifications, des approbations et un journal de chaque exécution.",
    skip: "Aller au contenu",
    home: "Accueil Kitewell",
    nav: "Navigation principale",
    language: "Langue",
    links: ["Exemples", "Tarifs", "Documentation", "Télécharger"],
    companies: "Pour les entreprises ↗",
    partner: "",
    signIn: "Se connecter",
    trial: "Essai gratuit",
    tagline: "L’IA apprend la tâche une fois. Ensuite, elle tourne vite, sans hésiter.",
    social: "L’IA apprend la tâche une fois. Ensuite, elle tourne vite, sans hésiter. Kitewell : l’automatisation du navigateur construite et entretenue par l’IA, plus les applications de bureau, Excel et l’e-mail.",
    footer: ["Documentation", "Mentions de tiers", "Assistance", "Contact", "Confidentialité", "Conditions", "Communauté", "Comparatif", "Versions"],
    fine: "",
  },
  de: {
    description:
      "Kitewell automatisiert Websites, Desktop-Apps, E-Mail, Skripte und Coding-Agenten in der Cloud oder auf Ihrem eigenen Computer, mit Zeitplänen, Genehmigungen und einem Protokoll jeder Ausführung.",
    skip: "Zum Inhalt springen",
    home: "Kitewell-Startseite",
    nav: "Hauptnavigation",
    language: "Sprache",
    links: ["Beispiele", "Preise", "Dokumentation", "Download"],
    companies: "Für Unternehmen ↗",
    partner: "",
    signIn: "Anmelden",
    trial: "Kostenlos testen",
    tagline: "Die KI lernt die Aufgabe einmal. Danach läuft sie schnell und ohne Zögern.",
    social: "Die KI lernt die Aufgabe einmal. Danach läuft sie schnell und ohne Zögern. Kitewell: Browser-Automatisierung, von der KI gebaut und gepflegt, dazu Desktop-Apps, Excel und E-Mail.",
    footer: ["Dokumentation", "Hinweise zu Drittanbietern", "Support", "Kontakt", "Datenschutz", "Nutzungsbedingungen", "Community", "Vergleich", "Versionen"],
    fine: "",
  },
}[locale];
const { title, description = text.description, image, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Each language has its own card for link previews.
const social = image ?? { src: locale === "en" ? "/social.png" : `/social-${locale}.png`, width: 1200, height: 630, alt: text.social };
const socialImage = new URL(social.src, Astro.site);
// The home page tells search engines the site's name.
const isHome = Astro.url.pathname === localize("/", locale);
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kitewell",
  url: new URL(localize("/", locale), Astro.site).href,
  inLanguage: languages[locale].lang,
  publisher: { "@type": "Organization", name: "Descarty, Inc." },
};
// The visitor's system, marked on <html data-os> before the page draws, so
// every download button shows the right label from the start.
const platformScript = `document.documentElement.dataset.os = (${detectPlatform})({ userAgent: navigator.userAgent, uaPlatform: navigator.userAgentData ? navigator.userAgentData.platform : "", maxTouchPoints: navigator.maxTouchPoints }).os;`;
const pages = counterparts(Astro.url.pathname);
const versions = locales.filter((l) => pages?.[l]);
const links = ["/examples/", "/pricing/", "/docs/", "/download/"].map((href, i) => [
  localize(href, locale),
  text.links[i],
]);
---

<!doctype html>
<html lang={languages[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Kitewell</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {pages && (
      <>
        {versions.map((l) => <link rel="alternate" hreflang={languages[l].lang} href={new URL(pages[l], Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(pages.en, Astro.site)} />
      </>
    )}
    <script is:inline src="/lang.js"></script>
    <script is:inline set:html={platformScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {locale === "ja" && <link rel="stylesheet" href={japaneseFonts} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kitewell" />
    <meta property="og:locale" content={languages[locale].og} />
    <meta property="og:title" content={`${title} — Kitewell`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    <meta property="og:image:alt" content={social.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(site)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {text.skip}
    </a>
    <header class="header wrap">
      <a class="brand" href={localize("/", locale)} aria-label={text.home}>
        <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
        Kitewell
      </a>
      <nav aria-label={text.nav}>
        {links.map(([href, label]) => (
          <a
            href={href}
            aria-current={
              Astro.url.pathname.startsWith(href) ? "page" : undefined
            }
          >
            {label}
          </a>
        ))}
        <a href={descartyUrl(locale)}>{text.companies}</a>
        {text.partner && <a href={descartyUrl(locale, "/partners/")}>{text.partner}</a>}
        {pages && (
          <details class="languages">
            <summary>
              <span class="visually-hidden">{text.language}: </span>
              {languages[locale].label}
            </summary>
            <ul>
              {versions.map((l) => (
                <li>
                  <a href={pages[l]} lang={languages[l].lang} hreflang={languages[l].lang} aria-current={l === locale ? "true" : undefined}>
                    {languages[l].label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </nav>
      <div class="header-actions">
        <a class="header-sign-in" href={cloudApp}>{text.signIn}</a>
        <a class="button small" href={cloudSignup}>{text.trial}</a>
      </div>
    </header>
    <script is:inline>
      // The language menu closes on a click elsewhere or on Escape.
      document.addEventListener("click", (event) => {
        for (const menu of document.querySelectorAll("details.languages[open]")) if (!menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        for (const menu of document.querySelectorAll("details.languages[open]")) {
          menu.open = false;
          menu.querySelector("summary").focus();
        }
      });
    </script>
    <main id="main">
      <slot />
    </main>
    <footer class="footer wrap">
      <div>
        <a class="brand" href={localize("/", locale)}>
          <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
          Kitewell
        </a>
        <p>{text.tagline}</p>
      </div>
      <div class="footer-links">
        <a href={localize("/docs/", locale)}>{text.footer[0]}</a>
        <a href={localize("/releases/", locale)}>{text.footer[8]}</a>
        <a href={localize("/compare/", locale)}>{text.footer[7]}</a>
        {locale === "ja" && <a href="/ja/blog/">ブログ</a>}
        <a href="https://github.com/dagucloud/kitewell">GitHub</a>
        <a href="https://www.youtube.com/@kitewell">YouTube</a>
        <a href="/third-party/">{text.footer[1]}</a>
        <a href={localize("/support/", locale)}>{text.footer[2]}</a>
        <a href="/community/">{text.footer[6]}</a>
        <a href="mailto:company@descarty.com?subject=Kitewell">{text.footer[3]}</a>
        <a href={localize("/privacy/", locale)}>{text.footer[4]}</a>
        <a href={localize("/terms/", locale)}>{text.footer[5]}</a>
        <Analytics />
      </div>
      <div class="footer-company">
        <Endorsement locale={locale} />
        <p class="fine">© {new Date().getFullYear()} <a href={descartyUrl(locale)}>Descarty, Inc.</a> {text.fine}</p>
      </div>
    </footer>
  </body>
</html>
