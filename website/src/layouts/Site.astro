---
import "../styles/site.css";
import Analytics from "../components/Analytics.astro";
import DownloadButton from "../components/DownloadButton.astro";
import { descartyUrl } from "../lib/descarty.mjs";
import { counterparts, languages, localeOf, locales, localize } from "../lib/i18n.mjs";
import { detectPlatform } from "../lib/platform.mjs";
interface Props {
  title: string;
  description?: string;
}
const locale = localeOf(Astro.url.pathname);
const text = {
  en: {
    description:
      "Describe a computer chore once and Kitewell's AI does it every day: it works websites and desktop apps on your own computer, repeats the clicks that worked, and fixes just the click a changed screen breaks.",
    skip: "Skip to content",
    home: "Kitewell home",
    nav: "Main navigation",
    language: "Language",
    links: ["Examples", "Coding agents", "Pricing", "Docs"],
    tagline: "Describe a computer chore once. AI does it every day.",
    social: "Describe a computer chore once. AI does it every day. Kitewell repeats the clicks that worked, on your Mac or PC, and fixes just the click a changed screen breaks.",
    footer: ["Documentation", "Third-party notices", "Support", "Contact", "Privacy", "Terms", "Community", "Compare", "Releases"],
    fine: "",
  },
  ja: {
    description:
      "パソコン作業を一度伝えれば、Kitewell の AI が毎日やってくれます。自分のパソコンで Web サイトやデスクトップアプリを操作し、うまくいった操作をくり返し、画面が変わったら、その操作だけを直します。",
    skip: "本文へスキップ",
    home: "Kitewell ホーム",
    nav: "メインナビゲーション",
    language: "言語",
    links: ["活用例", "エージェント", "料金", "ドキュメント"],
    tagline: "パソコン作業を一度伝えれば、AI が毎日やってくれる。",
    social: "パソコン作業を一度伝えれば、AI が毎日やってくれる。Kitewell は、うまくいった操作を Mac や PC でくり返し、画面が変わったら、その操作だけを直します。",
    footer: ["ドキュメント", "サードパーティのライセンス", "サポート", "お問い合わせ", "プライバシー", "利用規約", "コミュニティ", "比較", "リリース"],
    fine: "",
  },
  zh: {
    description:
      "电脑上的重复工作只需描述一次，Kitewell 的 AI 就会每天替你完成：它在你自己的电脑上操作网站和桌面应用，重复行之有效的点击；界面变化导致某次点击失效时，只修复那一次点击。",
    skip: "跳到正文",
    home: "Kitewell 首页",
    nav: "主导航",
    language: "语言",
    links: ["示例", "编码智能体", "价格", "文档"],
    tagline: "电脑上的重复工作，只需描述一次。AI 每天替你完成。",
    social: "电脑上的重复工作，只需描述一次。AI 每天替你完成。Kitewell 在你的 Mac 或 PC 上重复行之有效的点击；界面变化导致某次点击失效时，只修复那一次点击。",
    footer: ["文档", "第三方声明", "支持", "联系我们", "隐私政策", "使用条款", "社区", "对比", "版本发布"],
    fine: "",
  },
  ko: {
    description:
      "컴퓨터 반복 업무를 한 번만 설명하면 Kitewell의 AI가 매일 처리합니다. 내 컴퓨터에서 웹사이트와 데스크톱 앱을 조작하고, 잘된 클릭을 반복하며, 화면이 바뀌어 막힌 클릭만 고칩니다.",
    skip: "본문으로 건너뛰기",
    home: "Kitewell 홈",
    nav: "주 메뉴",
    language: "언어",
    links: ["예시", "코딩 에이전트", "요금", "문서"],
    tagline: "컴퓨터 반복 업무, 한 번만 설명하세요. AI가 매일 처리합니다.",
    social: "컴퓨터 반복 업무, 한 번만 설명하세요. AI가 매일 처리합니다. Kitewell은 Mac이나 PC에서 잘된 클릭을 반복하고, 화면이 바뀌어 막힌 클릭만 고칩니다.",
    footer: ["문서", "제3자 고지", "지원", "문의", "개인정보 처리방침", "이용약관", "커뮤니티", "비교", "릴리스"],
    fine: "",
  },
  fr: {
    description:
      "Décrivez une tâche sur ordinateur une seule fois, l’IA de Kitewell s’en charge chaque jour : elle utilise sites web et applications de bureau sur votre propre ordinateur, répète les clics qui ont fonctionné, et ne corrige que le clic qu’un écran modifié empêche d’aboutir.",
    skip: "Aller au contenu",
    home: "Accueil Kitewell",
    nav: "Navigation principale",
    language: "Langue",
    links: ["Exemples", "Agents de code", "Tarifs", "Documentation"],
    tagline: "Décrivez une tâche sur ordinateur, une seule fois. L’IA s’en charge chaque jour.",
    social: "Décrivez une tâche sur ordinateur, une seule fois. L’IA s’en charge chaque jour. Kitewell répète les clics qui ont fonctionné, sur votre Mac ou votre PC, et ne corrige que le clic qu’un écran modifié empêche d’aboutir.",
    footer: ["Documentation", "Mentions de tiers", "Assistance", "Contact", "Confidentialité", "Conditions", "Communauté", "Comparatif", "Versions"],
    fine: "",
  },
  de: {
    description:
      "Beschreiben Sie eine Computeraufgabe nur einmal, und die KI von Kitewell erledigt sie jeden Tag. Kitewell bedient Websites und Desktop-Apps auf Ihrem eigenen Computer, wiederholt die Klicks, die funktioniert haben, und behebt nur den Klick, der nach einer Änderung am Bildschirm nicht mehr passt.",
    skip: "Zum Inhalt springen",
    home: "Kitewell-Startseite",
    nav: "Hauptnavigation",
    language: "Sprache",
    links: ["Beispiele", "Coding-Agenten", "Preise", "Dokumentation"],
    tagline: "Beschreiben Sie eine Computeraufgabe nur einmal. Die KI erledigt sie jeden Tag.",
    social: "Beschreiben Sie eine Computeraufgabe nur einmal. Die KI erledigt sie jeden Tag. Kitewell wiederholt auf Ihrem Mac oder PC die Klicks, die funktioniert haben, und behebt nur den Klick, der nach einer Änderung am Bildschirm nicht mehr passt.",
    footer: ["Dokumentation", "Hinweise zu Drittanbietern", "Support", "Kontakt", "Datenschutz", "Nutzungsbedingungen", "Community", "Vergleich", "Versionen"],
    fine: "",
  },
}[locale];
const { title, description = text.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Each language has its own card for link previews.
const socialImage = new URL(locale === "en" ? "/social.png" : `/social-${locale}.png`, Astro.site);
// The home page tells search engines the site's name.
const isHome = Astro.url.pathname === localize("/", locale);
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kitewell",
  url: new URL(localize("/", locale), Astro.site).href,
  inLanguage: languages[locale].lang,
  publisher: { "@type": "Organization", name: "Descarty, Inc." },
};
// The visitor's system, marked on <html data-os> before the page draws, so
// every download button shows the right label from the start.
const platformScript = `document.documentElement.dataset.os = (${detectPlatform})({ userAgent: navigator.userAgent, uaPlatform: navigator.userAgentData ? navigator.userAgentData.platform : "", maxTouchPoints: navigator.maxTouchPoints }).os;`;
const pages = counterparts(Astro.url.pathname);
const versions = locales.filter((l) => pages?.[l]);
const links = ["/examples/", "/coding-agents/", "/pricing/", "/docs/"].map((href, i) => [
  localize(href, locale),
  text.links[i],
]);
---

<!doctype html>
<html lang={languages[locale].lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Kitewell</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {pages && (
      <>
        {versions.map((l) => <link rel="alternate" hreflang={languages[l].lang} href={new URL(pages[l], Astro.site)} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(pages.en, Astro.site)} />
      </>
    )}
    <script is:inline src="/lang.js"></script>
    <script is:inline set:html={platformScript} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kitewell" />
    <meta property="og:locale" content={languages[locale].og} />
    <meta property="og:title" content={`${title} — Kitewell`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={text.social} />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(site)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {text.skip}
    </a>
    <header class="header wrap">
      <a class="brand" href={localize("/", locale)} aria-label={text.home}>
        <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
        Kitewell
      </a>
      <nav aria-label={text.nav}>
        {links.map(([href, label]) => (
          <a
            href={href}
            aria-current={
              Astro.url.pathname.startsWith(href) ? "page" : undefined
            }
          >
            {label}
          </a>
        ))}
        {pages && (
          <details class="languages">
            <summary>
              <span class="visually-hidden">{text.language}: </span>
              {languages[locale].label}
            </summary>
            <ul>
              {versions.map((l) => (
                <li>
                  <a href={pages[l]} lang={languages[l].lang} hreflang={languages[l].lang} aria-current={l === locale ? "true" : undefined}>
                    {languages[l].label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </nav>
      <DownloadButton locale={locale} place="header" small />
    </header>
    <script is:inline>
      // The language menu closes on a click elsewhere or on Escape.
      document.addEventListener("click", (event) => {
        for (const menu of document.querySelectorAll("details.languages[open]")) if (!menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        for (const menu of document.querySelectorAll("details.languages[open]")) {
          menu.open = false;
          menu.querySelector("summary").focus();
        }
      });
    </script>
    <main id="main">
      <slot />
    </main>
    <footer class="footer wrap">
      <div>
        <a class="brand" href={localize("/", locale)}>
          <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
          Kitewell
        </a>
        <p>{text.tagline}</p>
      </div>
      <div class="footer-links">
        <a href={localize("/docs/", locale)}>{text.footer[0]}</a>
        <a href={localize("/releases/", locale)}>{text.footer[8]}</a>
        <a href={localize("/compare/", locale)}>{text.footer[7]}</a>
        <a href="https://github.com/dagucloud/kitewell">GitHub</a>
        <a href="/third-party/">{text.footer[1]}</a>
        <a href={localize("/support/", locale)}>{text.footer[2]}</a>
        <a href="/community/">{text.footer[6]}</a>
        <a href="mailto:company@descarty.com?subject=Kitewell">{text.footer[3]}</a>
        <a href={localize("/privacy/", locale)}>{text.footer[4]}</a>
        <a href={localize("/terms/", locale)}>{text.footer[5]}</a>
        <Analytics />
      </div>
      <p class="fine">© {new Date().getFullYear()} <a href={descartyUrl(locale)}>Descarty, Inc.</a> {text.fine}</p>
    </footer>
  </body>
</html>
