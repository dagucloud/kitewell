---
import "../styles/site.css";
import Analytics from "../components/Analytics.astro";
import { readManifest } from "../lib/releases.mjs";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Kitewell is a desktop workflow builder for scripts, APIs, containers, and AI agents. Schedule runs and inspect each step's output on your own machine.",
} = Astro.props;
const release = await readManifest();
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = [
  ["/docs/", "Docs"],
  ["/releases/", "Releases"],
  ["/pricing/", "Pricing"],
  ["/support/", "Support"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Kitewell</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Kitewell`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://kitewell.app/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="header wrap">
      <a class="brand" href="/" aria-label="Kitewell home">
        <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
        kitewell
      </a>
      <nav aria-label="Main navigation">
        {links.map(([href, label]) => (
          <a
            href={href}
            aria-current={
              Astro.url.pathname.startsWith(href) ? "page" : undefined
            }
          >
            {label}
          </a>
        ))}
      </nav>
      <a class="button small" href="/download/">
        {release ? "Download Kitewell" : "Beta status"}
        <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer wrap">
      <div>
        <a class="brand" href="/">
          <img class="brand-mark" src="/favicon.svg" alt="" width="36" height="36" />
          kitewell
        </a>
        <p>Build and run workflows locally.</p>
      </div>
      <div class="footer-links">
        <a href="/docs/">Documentation</a>
        <a href="https://github.com/dagucloud/runstead">GitHub</a>
        <a href="/third-party/">Third-party notices</a>
        <a href="/support/">Support</a>
        <Analytics />
      </div>
      <p class="fine">© {new Date().getFullYear()} Kitewell. Public preview.</p>
    </footer>
  </body>
</html>
