---
// "Describe your chore": the visitor writes a chore in their own words, and
// a model sketches, step by step, how Kitewell would run it. The sketch
// streams from /api/plan; nothing the visitor types is stored.
import { kinds, kindIcons } from "../lib/kinds.mjs";
interface Props {
  locale: "en" | "ja";
  id: string;
  heading: string;
  lead?: string;
}
const { locale, id, heading, lead } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const text = {
  en: {
    label: "Describe a chore you do on your computer",
    ideas: [
      "Every Friday I export timesheets from our HR site and paste the hours into the payroll spreadsheet…",
      "Each morning I copy new orders from our shop's dashboard into a spreadsheet and email the warehouse…",
      "When a lead fills in our form, I look the company up and send my team a short summary…",
      "On the 1st I collect last month's receipts from my inbox and send them to my accountant…",
      "Twice a day I check our status page and the error logs, and post anything odd in Slack…",
    ],
    submit: "Show me how it would run",
    working: "Laying out the steps…",
    privacy: "What you type is sent to Anthropic to draft the sketch. Kitewell does not store it.",
    fit: { yes: "Kitewell can do this", partly: "Kitewell can do most of this", no: "Not a job for Kitewell" },
    you: "You",
    moment: "What you'd see",
    sentence: "What you'd tell Kitewell",
    needs: "You'd set up",
    leaves: "What leaves your computer",
    caveats: "Worth knowing",
    footer:
      "A sketch from this page, not a saved workflow. On your computer, Kitewell's assistant builds the real one with your own apps and sign-ins, and shows it to you before anything is saved.",
    again: "Describe another chore",
    done: "Sketch ready: {n} steps.",
    errors: {
      short: "Tell it a little more: what you open, what you copy, and where it goes.",
      long: "That's more than a sketch can take. Describe the one chore in a few sentences.",
      busy: "Too many sketches from here just now. Try again in a few minutes.",
      offline: "Sketches aren't available right now. The chores below show how Kitewell runs.",
      failed: "The sketch didn't come through. Try again.",
      check: "Please complete the check above, then try again.",
      refused: "That isn't something this page can sketch. Try describing a chore you do on your computer.",
    },
  },
  ja: {
    label: "コンピューターでしている作業を書いてください",
    ideas: [
      "毎週金曜に、人事のサイトから勤怠を書き出して、給与計算のスプレッドシートに時間を貼っている…",
      "毎朝、ネットショップの管理画面から新しい注文をスプレッドシートに写して、倉庫にメールしている…",
      "問い合わせフォームが届くたびに、相手の会社を調べて、チームに短い要約を送っている…",
      "毎月 1 日に、先月の領収書をメールから集めて、税理士さんに送っている…",
      "1 日 2 回、ステータスページとエラーログを見て、おかしなものがあれば Slack に投稿している…",
    ],
    submit: "どう動くかを見る",
    working: "手順を組み立てています…",
    privacy: "入力した内容は、下書きを作るために Anthropic に送られます。Kitewell は保存しません。",
    fit: { yes: "Kitewell でできます", partly: "Kitewell でほとんどできます", no: "Kitewell の仕事ではありません" },
    you: "あなた",
    moment: "あなたに届くもの",
    sentence: "Kitewell に伝えること",
    needs: "準備するもの",
    leaves: "コンピューターの外に出るもの",
    caveats: "知っておくこと",
    footer:
      "このページで作った下書きで、保存されたワークフローではありません。あなたのコンピューターでは、Kitewell のアシスタントが、あなたのアプリとサインインを使って本物を組み立て、保存する前に見せてくれます。",
    again: "別の作業を書く",
    done: "下書きができました：{n} ステップ。",
    errors: {
      short: "もう少し詳しく書いてください。何を開いて、何を写して、どこへ入れるか。",
      long: "下書きにするには長すぎます。1 つの作業を、数文で書いてください。",
      busy: "いま、このネットワークからの下書きが多すぎます。数分後にもう一度お試しください。",
      offline: "いまは下書きを作れません。下の作業で、Kitewell の動き方をご覧ください。",
      failed: "下書きを受け取れませんでした。もう一度お試しください。",
      check: "上の確認を済ませてから、もう一度お試しください。",
      refused: "このページでは下書きにできない内容です。コンピューターでしている作業を書いてみてください。",
    },
  },
}[locale];
const kindLabels = Object.fromEntries(Object.entries(kinds).map(([key, label]) => [key, label[locale]]));
const config = { locale, text, kinds: kindLabels, icons: kindIcons };
---

<section class="planner" id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{heading}</h2>
  {lead && <p class="planner-lead">{lead}</p>}
  <form class="planner-form" data-planner={JSON.stringify(config)}>
    <label for={`${id}-chore`} class="visually-hidden">{text.label}</label>
    <textarea
      id={`${id}-chore`}
      name="chore"
      rows="3"
      maxlength="600"
      required
      placeholder={text.ideas[0]}
      data-ideas={JSON.stringify(text.ideas)}></textarea>
    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-size="flexible" data-appearance="interaction-only"></div>}
    <div class="planner-actions">
      <button type="submit" class="button">{text.submit}</button>
      <p class="fine">{text.privacy}</p>
    </div>
    <p class="planner-status" role="status" aria-live="polite"></p>
  </form>
  <div class="plan" hidden></div>
</section>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import posthog from "posthog-js";
  import { readEvents } from "../lib/plan-events.mjs";

  type Config = {
    locale: string;
    kinds: Record<string, string>;
    icons: Record<string, string>;
    text: {
      submit: string;
      working: string;
      fit: Record<string, string>;
      you: string;
      moment: string;
      sentence: string;
      needs: string;
      leaves: string;
      caveats: string;
      footer: string;
      again: string;
      done: string;
      errors: Record<string, string>;
    };
  };
  type Step = { kind: string; name: string; detail: string; you?: string | null };
  type Turnstile = { reset: (widget?: Element) => void };

  const track = (event: string, properties: Record<string, unknown>) => {
    if (posthog.__loaded) posthog.capture(event, properties);
  };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const icon = (config: Config, kind: string) => {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 16 16");
    svg.setAttribute("class", "kind-icon");
    svg.setAttribute("aria-hidden", "true");
    // The icon markup is the site's own, keyed by a kind the server checked.
    svg.innerHTML = config.icons[kind] ?? config.icons.script;
    return svg;
  };

  // Ideas take turns as the placeholder while the box is empty and idle.
  function rotateIdeas(box: HTMLTextAreaElement) {
    const ideas: string[] = JSON.parse(box.dataset.ideas ?? "[]");
    if (!window.matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
    let index = 0;
    window.setInterval(() => {
      if (box.value || document.activeElement === box) return;
      index = (index + 1) % ideas.length;
      box.placeholder = ideas[index];
    }, 4200);
  }

  // A sketch is built in place as its fields arrive.
  function sketch(config: Config, root: HTMLElement) {
    root.replaceChildren();
    root.hidden = false;
    const t = config.text;
    const head = el("div", "plan-head");
    const fit = el("p", "plan-fit");
    const title = el("h3", "plan-title");
    const when = el("p", "plan-when");
    head.append(fit, title, when);
    const steps = el("ol", "plan-steps");
    const tail = el("div", "plan-tail");
    root.append(head, steps, tail);
    let count = 0;

    const fact = (label: string, value: string | string[]) => {
      const items = Array.isArray(value) ? value.filter(Boolean) : [value].filter(Boolean);
      if (!items.length) return;
      const box = el("div", "plan-fact");
      box.append(el("h4", undefined, label));
      if (items.length === 1) box.append(el("p", undefined, items[0]));
      else {
        const list = el("ul");
        for (const item of items) list.append(el("li", undefined, item));
        box.append(list);
      }
      tail.append(box);
    };

    return {
      field(key: string, value: any) {
        if (key === "fit" && t.fit[value]) {
          fit.textContent = t.fit[value];
          fit.dataset.fit = value;
        } else if (key === "title") title.textContent = value;
        else if (key === "when") when.textContent = value;
        else if (key === "moment" && value) {
          const moment = el("div", "plan-moment");
          moment.append(el("h4", undefined, t.moment));
          const card = el("div", "moment");
          const logo = el("img");
          logo.src = "/favicon.svg";
          logo.alt = "";
          logo.width = 34;
          logo.height = 34;
          const body = el("div");
          const line = el("p", "moment-head");
          line.append(el("strong", undefined, title.textContent ?? "Kitewell"));
          body.append(line, el("p", undefined, value));
          card.append(logo, body);
          moment.append(card);
          tail.append(moment);
        } else if (key === "sentence" && value) {
          const said = el("div", "plan-sentence");
          said.append(el("h4", undefined, t.sentence), el("p", "said", value));
          tail.append(said);
        } else if (key === "needs") fact(t.needs, value);
        else if (key === "leaves") fact(t.leaves, value);
        else if (key === "caveats") fact(t.caveats, value);
        else if (key === "note" && value) {
          const note = el("p", "plan-note", value);
          head.append(note);
        }
      },
      step(step: Step) {
        count += 1;
        const row = el("li", "plan-step");
        const kind = el("span", "run-step-kind");
        kind.title = config.kinds[step.kind] ?? step.kind;
        kind.append(icon(config, step.kind));
        const words = el("span", "run-step-text");
        words.append(el("strong", undefined, step.name), el("span", undefined, step.detail));
        if (step.you) {
          const you = el("span", "plan-you");
          you.append(el("b", undefined, t.you), document.createTextNode(` ${step.you}`));
          words.append(you);
        }
        row.append(kind, words, el("span", "plan-kind", config.kinds[step.kind] ?? ""));
        steps.append(row);
      },
      finish() {
        tail.append(el("p", "plan-footer", t.footer));
        return count;
      },
    };
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-planner]")) {
    const config: Config = JSON.parse(form.dataset.planner!);
    const box = form.querySelector("textarea")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const status = form.querySelector<HTMLElement>(".planner-status")!;
    const result = form.parentElement!.querySelector<HTMLElement>(".plan")!;
    rotateIdeas(box);

    const fail = (code: string) => {
      status.textContent = config.text.errors[code] ?? config.text.errors.failed;
      status.dataset.state = "error";
      track("planner_failed", { code });
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const chore = box.value.trim();
      if (chore.length < 20) return fail("short");
      const token = form.querySelector<HTMLInputElement>("[name='cf-turnstile-response']")?.value;
      if (form.querySelector(".cf-turnstile") && !token) return fail("check");

      button.disabled = true;
      status.dataset.state = "working";
      status.textContent = config.text.working;
      result.hidden = true;
      track("planner_requested", { page: location.pathname });
      try {
        const response = await fetch("/api/plan", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ chore, locale: config.locale, token }),
        });
        if (!response.ok || !response.body) {
          const body = await response.json().catch(() => ({}));
          return fail(body.code ?? "failed");
        }
        let view = sketch(config, result);
        let fit = "";
        let failed = "";
        for await (const message of readEvents(response.body)) {
          if (message.event === "field") {
            if (message.data.key === "fit") fit = message.data.value;
            view.field(message.data.key, message.data.value);
          } else if (message.event === "step") view.step(message.data);
          else if (message.event === "reset") view = sketch(config, result);
          else if (message.event === "error") failed = message.data.code ?? "failed";
        }
        if (failed) {
          result.hidden = true;
          return fail(failed);
        }
        const count = view.finish();
        status.dataset.state = "done";
        status.textContent = config.text.done.replace("{n}", String(count));
        const again = el("button", "button secondary", config.text.again);
        again.type = "button";
        again.addEventListener("click", () => {
          result.hidden = true;
          box.value = "";
          status.textContent = "";
          box.focus();
        });
        result.append(again);
        track("planner_answered", { fit, steps: count });
      } catch {
        fail("failed");
      } finally {
        button.disabled = false;
        (window as unknown as { turnstile?: Turnstile }).turnstile?.reset(form.querySelector(".cf-turnstile") ?? undefined);
      }
    });
  }
</script>
